---
import { SITE, SOCIAL } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a href="/" class="brand" style="color:#fff;margin-bottom:1rem;display:inline-flex">
          <span class="brand__dot" aria-hidden="true"></span>
          {SITE.shortName}<span style="opacity:0.6;font-weight:400;font-size:0.9em">·blog</span>
        </a>
        <p style="margin-top:0.5rem;max-width:32ch;color:#8a98a6;font-size:0.95rem">
          Análises e guias práticos sobre IA, seguros, finanças e gestão de PMEs em Portugal.
        </p>
        <a href={SITE.mainSiteUrl} style="display:inline-block;margin-top:1rem;color:var(--senvia-300);font-weight:600">
          Visitar senvia.pt →
        </a>
      </div>

      <div>
        <h3 class="site-footer__title">Categorias</h3>
        <ul class="site-footer__list">
          <li><a href="/categoria/ia">Inteligência Artificial</a></li>
          <li><a href="/categoria/seguros">Seguros</a></li>
          <li><a href="/categoria/financas">Finanças</a></li>
          <li><a href="/categoria/pmes">PMEs</a></li>
        </ul>
      </div>

      <div>
        <h3 class="site-footer__title">Recursos</h3>
        <ul class="site-footer__list">
          <li><a href="/sobre">Sobre</a></li>
          <li><a href="/contacto">Contacto</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </div>

      <div>
        <h3 class="site-footer__title">Legal</h3>
        <ul class="site-footer__list">
          <li><a href="/privacidade">Política de Privacidade</a></li>
          <li><a href="/cookies">Política de Cookies</a></li>
          <li><a href="/termos">Termos de Serviço</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} {SITE.shortName}. Todos os direitos reservados.</span>
      <div style="display:flex;gap:1rem">
        {
          SOCIAL.map((s) => (
            <a href={s.href} rel="noopener" target="_blank">{s.label}</a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

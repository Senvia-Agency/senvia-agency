---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSense from '../components/AdSense.astro';
import { CATEGORIES, SITE } from '../config';
import { getCollection } from 'astro:content';

const all = await getCollection('artigos', ({ data }) => !data.draft);
const sorted = all.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const featured = sorted.find((e) => e.data.featured) ?? sorted[0];
const recent = sorted.filter((e) => e.id !== featured?.id).slice(0, 6);
const byCategory = (cat: string) => sorted.filter((e) => e.data.category === cat).slice(0, 4);
---

<Base
  title={`${SITE.name}`}
  description={SITE.description}
  type="website"
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="13 2 13 10 21 10"/><path d="M21 10a9 9 0 1 1-2.12-9.36L21 10"/></svg>
        Novo — Atualizado em {new Intl.DateTimeFormat('pt-PT', { month: 'long', year: 'numeric' }).format(new Date())}
      </span>
      <h1>IA, Seguros, Finanças e PMEs <br /><span style="background:linear-gradient(to right,var(--senvia-400),var(--senvia-600));-webkit-background-clip:text;-webkit-text-fill-color:transparent">análises que moving-the-needle.</span></h1>
      <p class="hero__lead">Artigos práticos sobre como inteligência artificial está a mudar a forma como PMEs portuguesas gerem seguros, crédito, contabilidade e operações.</p>
      <div style="display:flex;gap:var(--space-3);margin-top:var(--space-5);flex-wrap:wrap">
        <a href="#destaques" class="btn btn--primary">Ver artigos</a>
        <a href="/categoria/ia" class="btn btn--ghost">Explorar IA →</a>
      </div>
    </div>
  </section>

  <section class="section" id="destaques">
    <div class="container">
      <div style="display:flex;align-items:end;justify-content:space-between;margin-bottom:var(--space-6);gap:var(--space-4);flex-wrap:wrap">
        <div>
          <span class="badge" style="margin-bottom:0.5rem">Em destaque</span>
          <h2 style="margin:0">Mais recente</h2>
        </div>
        <a href="/artigos" class="btn btn--ghost">Ver todos →</a>
      </div>

      {
        featured && (
          <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:var(--space-6);margin-bottom:var(--space-7)" class="featured-grid">
            <div style="background:linear-gradient(135deg,var(--senvia-500),var(--senvia-700));border-radius:var(--radius-lg);padding:var(--space-7);display:flex;flex-direction:column;justify-content:flex-end;min-height:380px;color:#fff">
              <span class="badge" style="background:rgba(255,255,255,0.2);color:#fff;align-self:flex-start;margin-bottom:var(--space-3)">{CATEGORIES[featured.data.category].label}</span>
              <h3 style="color:#fff;font-size:1.8rem;margin-bottom:var(--space-3)">{featured.data.title}</h3>
              <p style="opacity:0.9;margin-bottom:var(--space-4)">{featured.data.description}</p>
              <a href={`/artigos/${featured.id}/`} class="btn btn--ghost" style="background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.3);color:#fff;align-self:flex-start">Ler artigo →</a>
            </div>
            <div style="display:flex;flex-direction:column;gap:var(--space-3)">
              {recent.slice(0,3).map((entry) => (
                <a href={`/artigos/${entry.id}/`} style="display:flex;gap:var(--space-4);padding:var(--space-4);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);transition:border-color 0.2s,transform 0.2s" class="recent-item">
                  <div style="width:6px;align-self:stretch;background:var(--senvia-500);border-radius:3px"></div>
                  <div>
                    <small style="color:var(--accent);font-weight:600;text-transform:uppercase;font-size:0.75rem;letter-spacing:0.05em">{CATEGORIES[entry.data.category].short}</small>
                    <h4 style="margin:var(--space-1) 0;font-size:1rem;line-height:1.35">{entry.data.title}</h4>
                    <small style="color:var(--fg-muted)">{new Intl.DateTimeFormat('pt-PT',{day:'numeric',month:'short'}).format(entry.data.pubDate)}</small>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <div class="container">
    <div class="ad-slot ad-slot--in-article">
      <AdSense slot="2222222222" label />
    </div>
  </div>

  {
    Object.entries(CATEGORIES).map(([key, cat]) => {
      const posts = byCategory(key);
      if (posts.length === 0) return null;
      return (
        <section class="section section--tight">
          <div class="container">
            <div style="display:flex;align-items:end;justify-content:space-between;margin-bottom:var(--space-5);gap:var(--space-4);flex-wrap:wrap">
              <div>
                <span class="badge" style={`color:${cat.color};margin-bottom:0.5rem`}>{cat.label}</span>
                <p class="text-muted" style="margin:0;max-width:60ch">{cat.description}</p>
              </div>
              <a href={`/categoria/${key}/`} class="btn btn--ghost">Ver tudo →</a>
            </div>
            <div class="article-grid">
              {posts.map((entry) => <ArticleCard entry={entry} />)}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="section">
    <div class="container container--narrow" style="text-align:center;background:linear-gradient(135deg,#0b1f2a,#004e66);border-radius:var(--radius-lg);padding:var(--space-8) var(--space-6);color:#fff">
      <h2 style="color:#fff;margin-top:0">Receba novos artigos no email</h2>
      <p style="opacity:0.85;margin-bottom:var(--space-5)">Sem spam. Apenas análises mensais sobre IA, seguros e finanças para PMEs.</p>
      <form style="display:flex;gap:var(--space-2);max-width:480px;margin:0 auto;flex-wrap:wrap" action="/contacto" method="get">
        <input type="email" required placeholder="seu@email.pt" style="flex:1;min-width:200px;padding:0.85rem 1rem;border-radius:var(--radius);border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.08);color:#fff" />
        <button type="submit" class="btn" style="background:var(--senvia-400);color:#0b1f2a">Subscrever</button>
      </form>
    </div>
  </section>
</Base>

<style>
  @media (max-width: 860px) {
    .featured-grid {
      grid-template-columns: 1fr !important;
    }
  }
  .recent-item:hover {
    border-color: var(--accent) !important;
    transform: translateY(-2px);
  }
</style>
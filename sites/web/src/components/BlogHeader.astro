---
import { SITE, BLOG_NAV_LINKS, CATEGORIES, ADSENSE_CLIENT, SOCIAL } from '../config';
import { getCollection } from 'astro:content';

const all = await getCollection('artigos', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = sorted.find((e) => e.data.featured) ?? sorted[0];
const recent = sorted.filter((e) => e.id !== featured?.id).slice(0, 6);
const byCategory = (cat: string) => sorted.filter((e) => e.data.category === cat).slice(0, 4);
---

<header class="site-header site-header--scrolled">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <span class="brand__dot" style="width:9px;height:9px;background:var(--senvia-500);border-radius:999px;box-shadow:0 0 0 4px rgba(0,195,255,0.08);"></span>
      <span class="brand__name">SENVIA</span>
      <span style="opacity:0.6;font-weight:400;font-size:0.9em">·blog</span>
    </a>
    <nav class="nav" aria-label="Navegação blog">
      {BLOG_NAV_LINKS.map((link) => (
        <a href={link.href} class="nav__link">{link.label}</a>
      ))}
      <a href={SITE.url} class="btn btn--outline" rel="noopener">senvia.pt →</a>
    </nav>
  </div>
</header>

---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---

<Base
  title="Contacto"
  description="Fale com a equipa SENVIA. Agende uma consultoria gratuita ou peça orçamento para o seu projeto."
  canonicalPath="/contacto"
  noindex
>
  <section class="section" style="padding-top: 10rem;">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="badge section-header__badge">Contacto</span>
        <h1>Vamos falar do seu <span class="gradient-text">projeto</span></h1>
        <p>Estamos prontos para ajudar a transformar a sua empresa com IA.</p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;" class="contact-grid">
        <div class="glass" style="padding: 2rem; border-radius: var(--radius-lg);">
          <h3 style="margin-bottom: 1rem;">Consultoria Gratuita</h3>
          <p style="color: var(--fg-soft); margin-bottom: 1.5rem;">
            Agende uma sessão de diagnóstico. Analisamos o seu negócio e propomos soluções com IA.
          </p>
          <a href={SITE.ctaFormUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            Agendar Consultoria
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>

        <div class="glass" style="padding: 2rem; border-radius: var(--radius-lg);">
          <h3 style="margin-bottom: 1rem;">Orçamento para Site</h3>
          <p style="color: var(--fg-soft); margin-bottom: 1.5rem;">
            Precisa de um site, landing page ou e-commerce? Peça um orçamento gratuito.
          </p>
          <a href={SITE.ctaSiteFormUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
            Pedir Orçamento
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>

        <div class="glass" style="padding: 2rem; border-radius: var(--radius-lg);">
          <h3 style="margin-bottom: 1rem;">Email Direto</h3>
          <p style="color: var(--fg-soft); margin-bottom: 1.5rem;">
            Para parcerias, dúvidas ou questões técnicas.
          </p>
          <a href={`mailto:${SITE.email}`} class="btn btn--outline">
            {SITE.email}
          </a>
        </div>

        <div class="glass" style="padding: 2rem; border-radius: var(--radius-lg);">
          <h3 style="margin-bottom: 1rem;">Área de Cliente</h3>
          <p style="color: var(--fg-soft); margin-bottom: 1.5rem;">
            Já é cliente? Aceda ao SENVIA OS e aos seus projetos.
          </p>
          <a href={SITE.appUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
            Aceder ao SENVIA OS
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>

      <div style="margin-top: 3rem; padding: 1.5rem; background: var(--accent-soft); border-radius: var(--radius); text-align: center;">
        <p style="margin: 0; color: var(--fg-soft);">
          <strong style="color: var(--fg);">SENVIA</strong> — {SITE.location}
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (min-width: 640px) {
    .contact-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>

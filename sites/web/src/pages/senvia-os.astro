---
import Base from '../layouts/Base.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../config';

const modules = [
  { icon: 'users', title: 'Leads & Clientes', desc: 'Gestão completa de leads e clientes com scoring automático por IA.' },
  { icon: 'trending', title: 'Vendas', desc: 'Pipeline visual, previsões e automação de follow-up.' },
  { icon: 'wallet', title: 'Financeiro', desc: 'Faturação, contas a receber e a pagar integradas.' },
  { icon: 'mail', title: 'Marketing', desc: 'Campanhas de email, SMS e automação de nurturing.' },
  { icon: 'chart', title: 'Relatórios & BI', desc: 'Dashboards em tempo real com insights gerados por IA.' },
  { icon: 'bot', title: 'Agentes IA', desc: 'Agentes autónomos que trabalham 24/7 nos bastidores.' },
];

const icons: Record<string, string> = {
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>',
  trending: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>',
  wallet: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>',
  mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
  chart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
  bot: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>',
  cpu: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/></svg>',
};
---

<Base
  title="SENVIA OS — CRM com Inteligência Artificial"
  description="O nosso CRM proprietário com módulos de Leads, Clientes, Vendas, Financeiro, Marketing e muito mais. Com Inteligência Artificial integrada."
  canonicalPath="/senvia-os"
>
  <section class="hero aurora-bg" style="min-height: 85vh;">
    <div class="container">
      <div style="max-width: 48rem; margin-inline: auto; text-align: center;">
        <span class="badge mb-6">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/></svg>
          Produto Próprio
        </span>

        <h1 class="hero__title">
          SENVIA OS
          <br />
          <span class="gradient-text glow">CRM com IA Integrada</span>
        </h1>

        <p class="hero__lead" style="margin-inline: auto;">
          Um CRM completo com módulos de Leads, Clientes, Vendas, Financeiro, Marketing e muito mais. Com Inteligência Artificial integrada que trabalha nos bastidores 24/7.
        </p>

        <div class="hero__actions" style="justify-content: center;">
          <a href={SITE.appUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg glow-pulse">
            Aceder ao SENVIA OS
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge section-header__badge">Módulos</span>
        <h2>Tudo o que precisa para <span class="gradient-text">gerir e crescer</span></h2>
        <p>Um sistema completo que substitui múltiplas ferramentas dispersas.</p>
      </div>

      <div class="differential-grid">
        {modules.map((m) => (
          <div class="differential-card">
            <div class="differential-card__icon" set:html={icons[m.icon]} />
            <h3>{m.title}</h3>
            <p>{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Quer ver o SENVIA OS em ação?"
    subtitle="Agende uma demonstração gratuita. Vamos mostrar como a IA pode transformar a sua operação comercial."
    ctaText="Agendar Demonstração"
  />
</Base>

---
import Base from '../layouts/Base.astro';
import CTASection from '../components/CTASection.astro';

const values = [
  { icon: 'rocket', title: 'Nativos de 2025', desc: 'Não carregamos vícios do passado. A nossa estrutura foi desenhada do zero para a era da Inteligência Artificial.' },
  { icon: 'database', title: 'Verdade nos Dados', desc: 'Não confiamos em "achismos". Se o lead é frio, o sistema diz que é frio. A transparência é total.' },
  { icon: 'target', title: 'Foco na Venda', desc: 'Cliques e likes não pagam salários. O nosso compromisso é com o que realmente importa: o lucro do seu negócio.' },
];

const icons: Record<string, string> = {
  rocket: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>',
  database: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>',
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
  zap: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>',
  trending: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>',
};
---

<Base
  title="Sobre Nós — Nascidos na Era da IA"
  description="Conheça a SENVIA: agência nativa de IA que elimina o ruído das vendas. Fundada em 2025, unimos estratégia e tecnologia para entregar leads qualificados."
  canonicalPath="/sobre-nos"
>
  <section class="hero aurora-bg" style="min-height: auto; padding-top: 10rem; padding-bottom: 5rem;">
    <div class="container">
      <div style="max-width: 48rem; margin-inline: auto; text-align: center;">
        <span class="badge mb-6">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          A Nossa História
        </span>

        <h1 class="hero__title">
          Não somos uma agência tradicional a tentar adaptar-se à IA.
          <br />
          <span class="gradient-text glow">Nós nascemos da IA.</span>
        </h1>

        <p class="hero__lead" style="margin-inline: auto;">
          Fundada em 2025, a SENVIA é a resposta nativa para um mercado saturado de ruído e sedento de vendas reais.
        </p>
      </div>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="section">
    <div class="container">
      <div style="max-width: 48rem; margin-inline: auto;">
        <h2>A Nossa Guerra Contra o <span class="gradient-text">"Ruído"</span></h2>

        <div style="margin-top: 2rem; font-size: 1.125rem; color: var(--fg-soft); line-height: 1.75;">
          <p>
            O marketing digital <strong>"partiu-se"</strong>. Antigamente, o desafio era ser visto. Hoje, o desafio é ser ouvido no meio do caos.
          </p>

          <p>
            Empresas de todo o mundo estão a afogar-se em leads desqualificados, métricas de vaidade e "chatbots" que mais atrapalham do que ajudam. As equipas de vendas estão exaustas de ligar para números que não atendem ou pessoas que "só estavam a ver".
          </p>

          <div style="padding: 1.5rem; background: var(--accent-soft); border-left: 4px solid var(--senvia-500); border-radius: 0 var(--radius) var(--radius) 0; margin-block: 2rem;">
            <p style="margin: 0; color: var(--fg); font-weight: 500;">
              A SENVIA nasceu com um propósito único: <span class="gradient-text">Eliminar o ruído.</span>
            </p>
          </div>

          <p>
            Nós acreditamos que a tecnologia não serve para substituir o humano, mas para garantir que o humano <strong>só gasta o seu tempo com quem realmente importa</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Abordagem -->
  <section class="section aurora-bg">
    <div class="container">
      <div style="max-width: 60rem; margin-inline: auto;">
        <div class="section-header">
          <h2>Agência + Tecnologia: <span class="gradient-text">O Modelo Híbrido</span></h2>
          <p>Percebemos que as agências de marketing entregavam leads, mas não entregavam inteligência. E as empresas de software entregavam ferramentas, mas não entregavam estratégia.</p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2rem;" class="approach-grid">
          <div class="service-card">
            <div class="service-card__icon" set:html={icons.users} />
            <h3>Agência Tradicional</h3>
            <p class="service-card__desc">Entrega leads, mas sem inteligência. Você recebe volume, não qualidade.</p>
          </div>

          <div class="service-card">
            <div class="service-card__icon" set:html={icons.database} />
            <h3>Software/SaaS</h3>
            <p class="service-card__desc">Entrega ferramentas, mas sem estratégia. Você tem dados, mas não sabe o que fazer.</p>
          </div>

          <div class="service-card service-card--highlight">
            <div class="service-card__icon" set:html={icons.zap} />
            <h3 style="color: var(--senvia-400);">SENVIA</h3>
            <p class="service-card__desc" style="color: var(--fg);">Une os dois mundos. Estratégia + Tecnologia + Inteligência = Vendas Reais.</p>
          </div>
        </div>

        <div class="glass" style="padding: 2rem; border-radius: var(--radius-lg); display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem;">
          <div style="flex-shrink: 0;">
            <div style="width: 5rem; height: 5rem; border-radius: var(--radius-lg); background: var(--accent-soft); display: flex; align-items: center; justify-content: center;">
              <div style="width: 2.5rem; height: 2.5rem; color: var(--senvia-500);" set:html={icons.trending} />
            </div>
          </div>
          <div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">
              O nosso diferencial é o <span class="gradient-text">SENVIA OS</span>
            </h3>
            <p style="color: var(--fg-soft); margin-bottom: 1rem;">
              O nosso sistema proprietário de inteligência que atua nos bastidores. Enquanto a sua empresa dorme, os nossos agentes analisam, classificam e medem a "temperatura" de cada oportunidade.
            </p>
            <p style="color: var(--fg); font-weight: 500; margin: 0;">
              O resultado? Você deixa de vender para curiosos e passa a fechar negócio com <span class="gradient-text">leads quentes</span>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Liderança -->
  <section class="section">
    <div class="container">
      <div style="max-width: 48rem; margin-inline: auto;">
        <div class="section-header">
          <h2>Quem está <span class="gradient-text">por trás</span></h2>
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 2rem;">
          <div style="flex-shrink: 0;">
            <div style="width: 10rem; height: 10rem; border-radius: var(--radius-lg); background: linear-gradient(135deg, rgba(0, 195, 255, 0.3), rgba(0, 195, 255, 0.1)); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(0, 195, 255, 0.2);">
              <span style="font-size: 3rem; font-weight: 700; color: var(--senvia-500);">TS</span>
            </div>
          </div>

          <div style="flex: 1; min-width: 280px;">
            <h3 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Thiago Sousa</h3>
            <p style="color: var(--senvia-400); font-weight: 500; margin-bottom: 1.5rem;">Fundador & Arquiteto de Produto</p>

            <blockquote style="padding-left: 1.5rem; border-left: 3px solid var(--senvia-500); color: var(--fg-soft); font-style: italic; font-size: 1rem; line-height: 1.7;">
              <p style="margin-bottom: 1rem;">
                "Durante anos, trabalhei na criação de produtos digitais e percebi um padrão fatal: as empresas falham não por falta de tráfego, mas por <strong style="color: var(--fg); font-style: normal;">falha na conversão</strong>.
              </p>
              <p style="margin: 0;">
                Criei a SENVIA e o SENVIA OS para resolver a minha própria frustração. Eu queria um sistema que me dissesse: 'Thiago, esquece estes 50 leads, foca-te nestes 3, porque são estes que vão comprar'. <strong style="color: var(--fg); font-style: normal;">Hoje, essa tecnologia é a base do sucesso dos nossos clientes.</strong>"
              </p>
            </blockquote>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="section aurora-bg">
    <div class="container">
      <div class="section-header">
        <span class="badge section-header__badge">Valores</span>
        <h2>O Código <span class="gradient-text">SENVIA</span></h2>
        <p>Os nossos valores fundamentais</p>
      </div>

      <div class="differential-grid">
        {values.map((item) => (
          <div class="differential-card">
            <div class="differential-card__icon" set:html={icons[item.icon]} />
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</Base>

<style>
  @media (min-width: 768px) {
    .approach-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
</style>

---
/**
 * Moldura de browser usada na página /sites para enquadrar screenshots reais
 * de projetos. Sem sombras exageradas: apenas cromo neutro + hairline.
 */
interface Props {
  url?: string;
  tone?: 'light' | 'dark';
  class?: string;
}

const { url, tone = 'light', class: className } = Astro.props;
---

<div class:list={['sv-frame', `sv-frame--${tone}`, className]}>
  <div class="sv-frame__bar">
    <span class="sv-frame__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {url && <span class="sv-frame__url">{url}</span>}
  </div>
  <div class="sv-frame__screen">
    <slot />
  </div>
</div>

<style>
  .sv-frame {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #dadddb;
    background: #fff;
    box-shadow: 0 1px 2px rgba(16, 18, 20, 0.04), 0 18px 40px -24px rgba(16, 18, 20, 0.35);
  }

  .sv-frame__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    background: #f1f2f0;
    border-bottom: 1px solid #dadddb;
  }

  .sv-frame__dots {
    display: inline-flex;
    gap: 0.35rem;
    flex: none;
  }

  .sv-frame__dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #cdd0cd;
  }

  .sv-frame__url {
    font-size: 0.7rem;
    letter-spacing: 0.01em;
    color: #6b7175;
    background: #fff;
    border: 1px solid #e2e4e1;
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .sv-frame__screen {
    position: relative;
    background: #fff;
    line-height: 0;
  }

  .sv-frame__screen :global(img),
  .sv-frame__screen :global(video) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Variante escura, para o mockup colocado sobre fundo carvão */
  .sv-frame--dark {
    border-color: rgba(255, 255, 255, 0.14);
    background: #16191c;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .sv-frame--dark .sv-frame__bar {
    background: #1c2024;
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .sv-frame--dark .sv-frame__dots i {
    background: rgba(255, 255, 255, 0.2);
  }

  .sv-frame--dark .sv-frame__url {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.62);
  }

  @media (max-width: 480px) {
    .sv-frame__bar {
      padding: 0.5rem 0.65rem;
      gap: 0.5rem;
    }
    .sv-frame__url {
      font-size: 0.65rem;
    }
  }
</style>

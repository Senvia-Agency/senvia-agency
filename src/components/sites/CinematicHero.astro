---
/**
 * Hero cinematográfica da /sites.
 *
 * Mesmo mecanismo do componente de referência (ScrollTrigger com pin e scrub):
 * o texto de abertura afasta-se, o cartão sobe e ocupa o ecrã, o mockup entra
 * em 3D, os recortes e os textos aparecem, e no fim o cartão recua e sai.
 *
 * Diferenças em relação à referência, por necessidade:
 *  - paleta SENVIA (navy + ciano) em vez do índigo;
 *  - mockup de browser com um site real de cliente, em vez de iPhone;
 *  - CTAs reais em vez de App Store / Google Play;
 *  - o estado por omissão do CSS é o estado LEGÍVEL. O GSAP só depois é que
 *    esconde o que vai animar. Sem JS, ou com prefers-reduced-motion, a hero
 *    fica estática e completa em vez de ficar em branco.
 */
import { Image } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import heroShot from '../../assets/projetos/longev-studio.png';

interface Props {
  pacotesHref: string;
  diagnosticoHref: string;
  diagnosticoAttrs?: Record<string, string>;
  whatsappHref?: string | null;
  hasVideo?: boolean;
  videoSrc?: string;
}

const {
  pacotesHref,
  diagnosticoHref,
  diagnosticoAttrs = {},
  whatsappHref = null,
  hasVideo = false,
  videoSrc = '/videos/sites-hero.mp4',
} = Astro.props;
---

<section class="cine" id="cine" data-cine>
  <div class="cine__stagewrap">
    <div class="cine__grain" aria-hidden="true"></div>
    <div class="cine__grid" aria-hidden="true"></div>

    {/* Com o scroll preso, ninguém sabe quanto falta e desiste. Esta barra
        resolve isso. Fica fixa por baixo do header, e só existe enquanto a
        sequência está ativa. */}
    <div class="cine__progresso" data-cine-progresso aria-hidden="true">
      <span data-cine-progresso-barra></span>
    </div>

    <!-- ===== Camada 1: abertura ===== -->
    <div class="cine__intro" data-cine-intro>
      <p class="cine__eyebrow">Criação de sites · Portugal</p>
      <h1 class="cine__h1">
        <span class="cine__l1" data-cine-l1>Sites profissionais para transformar</span>
        <span class="cine__l2" data-cine-l2>visitantes em pedidos.</span>
      </h1>
      <p class="cine__sub">
        Criamos páginas, sites e lojas online para negócios que precisam parecer profissionais,
        explicar bem a oferta e receber contactos pelo WhatsApp ou formulário.
      </p>
      <ul class="cine__trust">
        <li><span>Desde <strong>280€ + IVA</strong></span></li>
        <li><span>Pronto em até <strong>14 dias</strong></span></li>
        <li><span>WhatsApp, formulário e tracking</span></li>
      </ul>
      <p class="cine__hint" aria-hidden="true">
        <span>Desliza</span>
        <svg viewBox="0 0 24 24"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
      </p>
    </div>

    <!-- ===== Camada 2: CTA final ===== -->
    <div class="cine__cta" data-cine-cta>
      <h2>Queres uma presença online que gere pedidos?</h2>
      <p>Escolhe o pacote certo ou pede um diagnóstico rápido.</p>
      <div class="cine__ctabtns">
        <a href={diagnosticoHref} class="sv-btn sv-btn--primary sv-btn--lg" {...diagnosticoAttrs}>
          Pedir diagnóstico rápido
        </a>
        <a href={pacotesHref} class="sv-btn sv-btn--outline sv-btn--lg">Ver pacotes</a>
      </div>
    </div>

    <!-- ===== Camada 3: o cartão ===== -->
    <div class="cine__cardlayer">
      <div class="cine__card" id="cine-card" data-cine-card>
        {/* Seta grossa que atravessa o cartão deixando rasto.
            Vive DENTRO do cartão, em z-index 1: fica por cima do fundo navy
            mas por baixo de todo o conteúdo (grelha z2, cenas z4). Fora do
            cartão isto era impossível — o cartão cria um contexto de
            empilhamento, portanto qualquer z-index acima dele ficaria também
            acima do texto. */}
        <svg
          class="cine__rota"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {/* Curva assimétrica de propósito: amplitudes e comprimentos
              diferentes em cada volta, para não ler como um S repetido. */}
          <path
            data-cine-rota
            d="M 8,-10 C 46,2 74,10 62,26 C 52,39 6,38 14,54 C 21,68 88,62 72,80 C 62,91 24,88 30,104 C 33,111 44,114 46,120"
          />
        </svg>

        <div class="cine__sheen" aria-hidden="true"></div>

        {/* Momento de impacto: o cartão já ocupa o ecrã mas o mockup ainda
            não entrou. Sem isto ficava um vazio a meio do scroll. Só existe
            na experiência animada — decorativo, por isso aria-hidden. */}
        <p class="cine__focus" data-cine-focus aria-hidden="true">
          Feito para
          <span>o teu negócio.</span>
        </p>

        <div class="cine__cardgrid">
          <!-- esquerda -->
          <div class="cine__left" data-cine-left>
            <h2>Uma presença montada para captar pedidos.</h2>
            <p>
              Organizamos a oferta, criamos a página certa, ligamos os pontos de contacto e
              deixamos tudo pronto para acompanhar cliques, leads e próximos passos.
            </p>
            <div class="cine__actions">
              <a href={pacotesHref} class="sv-btn sv-btn--primary">Ver pacotes</a>
              <a href={diagnosticoHref} class="sv-btn sv-btn--outline" {...diagnosticoAttrs}>
                Pedir diagnóstico
              </a>
            </div>
          </div>

          <!-- centro: mockup -->
          <div class="cine__mock" data-cine-mock>
            <div class="cine__mockinner" data-cine-tilt>
              {/* Domínio real do cliente: o screenshot é do Longev Studio */}
              <BrowserFrame url="longevstudio.com">
                {/* A imagem otimizada está sempre cá e é ela o candidato a LCP.
                    O vídeo, quando o mp4 existir, entra por cima já a tocar. */}
                <div class="cine__media">
                  <Image
                    src={heroShot}
                    alt="Website do Longev Studio criado pela SENVIA, com menu, hero e botão de agendamento de avaliação."
                    widths={[640, 960, 1280]}
                    sizes="(max-width: 1023px) 88vw, 620px"
                    loading="eager"
                    fetchpriority="high"
                    quality={72}
                  />
                  {
                    hasVideo && (
                      <video
                        id="sv-hero-video"
                        class="cine__video"
                        muted
                        loop
                        playsinline
                        preload="none"
                        width="1898"
                        height="906"
                        data-src={videoSrc}
                        aria-hidden="true"
                        tabindex="-1"
                      />
                    )
                  }
                </div>
              </BrowserFrame>

              {
                /* WCAG 2.2.2 (nível A): movimento automático com mais de 5s
                   precisa de um mecanismo para parar. A lógica que liga isto
                   (mostra o botão, alterna o vídeo) vive no script da página
                   /sites, que já a tinha e continua a apontar para estes ids. */
                hasVideo && (
                  <button
                    type="button"
                    id="sv-hero-video-toggle"
                    class="cine__vtoggle"
                    hidden
                    aria-pressed="false"
                  >
                    {/* Nomes de classe sv-hero__vtoggle-*: é o que o script da
                        página (sites.astro) já procura via querySelector. */}
                    <svg class="sv-hero__vtoggle-pause" viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="7" y="5" width="3.5" height="14" rx="1" />
                      <rect x="13.5" y="5" width="3.5" height="14" rx="1" />
                    </svg>
                    <svg class="sv-hero__vtoggle-play" viewBox="0 0 24 24" aria-hidden="true" style="display:none">
                      <path d="M8 5.5v13l11-6.5z" />
                    </svg>
                    <span class="sv-hero__vtoggle-text">Parar animação</span>
                  </button>
                )
              }
            </div>

            <!-- recortes de vidro -->
            <div class="cine__badge cine__badge--wa" data-cine-badge>
              {
                whatsappHref ? (
                  <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="cine__badgeinner">
                    <span class="cine__ico cine__ico--wa" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.47 1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.5 9.5 0 0 1-4.83-1.32l-.35-.2-3.59.94.96-3.5-.23-.36a9.42 9.42 0 0 1-1.45-5.05c0-5.21 4.26-9.46 9.5-9.46 2.54 0 4.92.99 6.71 2.78a9.4 9.4 0 0 1 2.78 6.69c0 5.21-4.26 9.46-9.5 9.46m8.08-17.54A11.36 11.36 0 0 0 12.05 1C5.79 1 .7 6.07.7 12.3c0 1.99.52 3.93 1.51 5.64L.6 24l6.22-1.62a11.4 11.4 0 0 0 5.22 1.33h.01c6.26 0 11.35-5.07 11.35-11.3 0-3.02-1.18-5.86-3.32-8Z" /></svg>
                    </span>
                    <span>
                      <b>Falar connosco</b>
                      <i>WhatsApp direto</i>
                    </span>
                  </a>
                ) : (
                  <span class="cine__badgeinner">
                    <span class="cine__ico cine__ico--wa" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.47 1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.5 9.5 0 0 1-4.83-1.32l-.35-.2-3.59.94.96-3.5-.23-.36a9.42 9.42 0 0 1-1.45-5.05c0-5.21 4.26-9.46 9.5-9.46 2.54 0 4.92.99 6.71 2.78a9.4 9.4 0 0 1 2.78 6.69c0 5.21-4.26 9.46-9.5 9.46m8.08-17.54A11.36 11.36 0 0 0 12.05 1C5.79 1 .7 6.07.7 12.3c0 1.99.52 3.93 1.51 5.64L.6 24l6.22-1.62a11.4 11.4 0 0 0 5.22 1.33h.01c6.26 0 11.35-5.07 11.35-11.3 0-3.02-1.18-5.86-3.32-8Z" /></svg>
                    </span>
                    <span>
                      <b>Falar connosco</b>
                      <i>WhatsApp direto</i>
                    </span>
                  </span>
                )
              }
            </div>

            <div class="cine__badge cine__badge--form" data-cine-badge aria-hidden="true">
              <span class="cine__badgeinner">
                <span class="cine__ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z" /><path d="M8 10h8M8 14h5" /></svg>
                </span>
                <span>
                  <b>Pedido recebido</b>
                  <i>Formulário do site</i>
                </span>
              </span>
            </div>

            <div class="cine__badge cine__badge--ring" data-cine-badge aria-hidden="true">
              <span class="cine__badgeinner">
                <span class="cine__ring">
                  <svg viewBox="0 0 64 64">
                    <circle cx="32" cy="32" r="26" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="7" />
                    <circle
                      class="cine__ringbar"
                      data-cine-ring
                      cx="32"
                      cy="32"
                      r="26"
                      fill="none"
                      stroke="#00c3ff"
                      stroke-width="7"
                      stroke-linecap="round"
                    />
                  </svg>
                  <b data-cine-count>14</b>
                </span>
                <span>
                  <b>dias até publicar</b>
                  <i>Pacote Validação</i>
                </span>
              </span>
            </div>
          </div>

          <!-- direita: marca -->
          <div class="cine__right" data-cine-right>
            <p class="cine__brand">SENVIA</p>
          </div>
        </div>

        {/* As restantes secções da página vivem aqui dentro, como cenas que
            se substituem ao fazer scroll. Sem JS ficam em fluxo normal, uma
            a seguir à outra, e a página lê-se como sempre. */}
        <div class="cine__scenes" data-cine-scenes>
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-cine]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* O limiar deixou de ser de largura. O que não cabia no telemóvel eram
       as cenas desenhadas em paisagem: 3 pacotes lado a lado davam 1893px
       numa caixa de 598px. Agora cada cena densa tem layout de retrato e
       revela um item por scroll (um pacote, um projeto, um plano), o mesmo
       padrão que o Processo já usava, e cabe.
       O que continua a não caber é altura a sério: telemóvel deitado dá um
       cartão de ~350px e nenhuma cena se lê. Aí fica o layout normal. */
    const semAltura = window.innerHeight < 560;

    if (reduced || semAltura) {
      /* Sem animação: fica o estado estático, que já é o do CSS. */
      root.setAttribute('data-cine-static', '');
    } else {
      const card = root.querySelector<HTMLElement>('[data-cine-card]')!;
      const isMobile = window.innerWidth < 1024;

      /* No telemóvel a barra de endereço aparece e desaparece com o scroll.
         Isso dispara resize e, sem isto, o ScrollTrigger recalculava o pin a
         meio do gesto: a sequência saltava para trás. */
      ScrollTrigger.config({ ignoreMobileResize: true });

      /* Só agora é que escondemos o que vai ser animado. Se este script não
         correr, nada disto acontece e a hero fica legível na mesma. */
      root.setAttribute('data-cine-on', '');

      const ctx = gsap.context(() => {
        gsap.set('[data-cine-l1]', { autoAlpha: 0, y: 60, scale: 0.9, filter: 'blur(18px)' });
        gsap.set('[data-cine-l2]', { clipPath: 'inset(0 100% 0 0)' });
        gsap.set('[data-cine-card]', { yPercent: 118, autoAlpha: 1 });
        gsap.set(['[data-cine-left]', '[data-cine-right]', '[data-cine-mock]', '[data-cine-badge]'], {
          autoAlpha: 0,
        });
        gsap.set('[data-cine-cta]', { autoAlpha: 0, y: 26, filter: 'blur(6px)' });
        gsap.set('[data-cine-focus]', { autoAlpha: 0, scale: 0.9, filter: 'blur(14px)' });
        gsap.set('[data-cine-ring]', { strokeDasharray: 164, strokeDashoffset: 164 });

        /* Abertura, sem depender do scroll */
        gsap
          .timeline({ delay: 0.15 })
          .to('[data-cine-l1]', {
            autoAlpha: 1, y: 0, scale: 1, filter: 'blur(0px)', duration: 1.4, ease: 'expo.out',
          })
          .to('[data-cine-l2]', { clipPath: 'inset(0 0% 0 0)', duration: 1.2, ease: 'power4.inOut' }, '-=0.8')
          .fromTo('[data-cine-sub], .cine__trust, .cine__hint',
            { autoAlpha: 0, y: 18 },
            { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.08, ease: 'power3.out' }, '-=0.7');

        /* Sequência conduzida pelo scroll.
           O pin cresce com o nº de cenas: ~700px por cena, mais 4600px da
           abertura. Sem isto, 9 cenas ficavam espremidas nos mesmos 4600px
           e passavam todas de uma vez. */
        const nCenas = root.querySelectorAll('[data-cine-scenes] > *').length;
        /* No telemóvel cada cena tem mais sub-passos (pacotes, trabalhos e
           manutenção passam a um item por scroll), por isso precisa de mais
           distância. Mas o gesto é de flick, que cobre muito pixel de uma
           vez: a abertura encurta para compensar. */
        const comprimento = (isMobile ? 3600 : 4600) + nCenas * (isMobile ? 820 : 700);

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: root,
            start: 'top top',
            end: '+=' + comprimento,
            pin: true,
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });

        tl.to(['.cine__intro', '.cine__grid'], {
            scale: 1.16, filter: 'blur(18px)', autoAlpha: 0.15, ease: 'power2.inOut', duration: 2,
          }, 0)
          .to('[data-cine-card]', { yPercent: 0, ease: 'power3.inOut', duration: 2 }, 0)
          .to('[data-cine-card]', {
            width: '100%', height: '100%', borderRadius: '0px', ease: 'power3.inOut', duration: 1.5,
          })
          /* Preenche o vazio: o cartão já é o ecrã todo, o mockup ainda não entrou */
          .to('[data-cine-focus]', {
            autoAlpha: 1, scale: 1, filter: 'blur(0px)', ease: 'expo.out', duration: 1.2,
          }, '-=0.9')
          .to({}, { duration: 0.9 })
          .to('[data-cine-focus]', {
            autoAlpha: 0, scale: 1.08, filter: 'blur(10px)', ease: 'power2.in', duration: 0.8,
          })
          .fromTo('[data-cine-mock]',
            { y: 260, z: -480, rotationX: 46, rotationY: -28, autoAlpha: 0, scale: 0.62 },
            { y: 0, z: 0, rotationX: 0, rotationY: 0, autoAlpha: 1, scale: 1, ease: 'expo.out', duration: 2.5 },
            '-=0.4')
          .to('[data-cine-ring]', { strokeDashoffset: 44, duration: 1.8, ease: 'power3.inOut' }, '-=1.6')
          /* stagger maior: cada card entra claramente a seu tempo, não em bloco */
          .fromTo('[data-cine-badge]',
            { y: 90, autoAlpha: 0, scale: 0.75, rotationZ: -8 },
            { y: 0, autoAlpha: 1, scale: 1, rotationZ: 0, ease: 'back.out(1.5)', duration: 1.2, stagger: 0.55 },
            '-=1.5')
          .fromTo('[data-cine-left]', { x: -60, autoAlpha: 0 },
            { x: 0, autoAlpha: 1, ease: 'power4.out', duration: 1.4 }, '-=1.4')
          .fromTo('[data-cine-right]', { x: 60, autoAlpha: 0, scale: 0.85 },
            { x: 0, autoAlpha: 1, scale: 1, ease: 'expo.out', duration: 1.4 }, '<')
          .to({}, { duration: 1.0 }) /* pausa para ler o cartão completo */
          .set('.cine__intro', { autoAlpha: 0 })
          .to(['[data-cine-mock]', '[data-cine-badge]', '[data-cine-left]', '[data-cine-right]'], {
            scale: 0.92, y: -30, autoAlpha: 0, ease: 'power3.in', duration: 0.7, stagger: 0.04,
          })
          .to('[data-cine-card]', {
            width: isMobile ? '92vw' : '86vw',
            height: isMobile ? '90vh' : '84vh',
            borderRadius: isMobile ? '28px' : '40px',
            ease: 'power2.inOut', duration: 0.9,
          }, '-=0.25')
          /* A partir daqui o cartão FICA. As secções da página passam a
             substituir-se lá dentro, cena a cena, conduzidas pelo scroll. */
          .set('[data-cine-scenes]', { autoAlpha: 1 });

        /* Cada cena entra, fica, e sai para dar lugar à seguinte.
           O comprimento total do pin é calculado a partir do nº de cenas. */
        const cenas = Array.from(
          root.querySelectorAll<HTMLElement>('[data-cine-scenes] > *')
        );

        /* Trilho da Solução: dá continuidade visual aos 6 pontos, que sem
           isto apareciam soltos, sem relação uns com os outros. */
        const cenaSolucao = cenas.find((c) => c.querySelector('.sv-solution__list'));
        if (cenaSolucao && !cenaSolucao.querySelector('[data-cine-trilho]')) {
          const trilho = document.createElement('div');
          trilho.className = 'cine__trilho';
          trilho.setAttribute('data-cine-trilho', '');
          trilho.setAttribute('aria-hidden', 'true');
          trilho.innerHTML = '<span data-cine-trilho-barra></span>';
          cenaSolucao.appendChild(trilho);
        }

        gsap.set(cenas, { autoAlpha: 0, y: 40 });
        /* Estado inicial dos elementos que entram um a um dentro da cena */
        gsap.set(root.querySelectorAll('.sv-plan'), { autoAlpha: 0 });
        /* Em retrato há mais dois grupos a entrar um a um. Só no telemóvel:
           no ecrã largo estes cabem lado a lado e entram com a cena, e
           escondê-los aqui deixava-os invisíveis para sempre. */
        if (isMobile) {
          gsap.set(root.querySelectorAll('.sv-care__item, .sv-work__item'), { autoAlpha: 0 });
        }
        gsap.set(root.querySelectorAll('[data-cine-trilho-barra]'), {
          scaleX: 0, transformOrigin: 'left center',
        });

        /* O rasto muda de cor conforme a secção: dá leitura de progresso
           sem ser preciso ler nada. Petróleo no problema, ciano na oferta,
           verde-água a fechar. */
        const CORES = [
          '#007599', '#0090b8', '#00a8d6', '#00c3ff',
          '#1ad0ff', '#33ffe3', '#33ffe3', '#2ae0d0', '#33ffe3',
        ];
        const rotaCor = root.querySelector<SVGPathElement>('[data-cine-rota]');
        /* o nucleo herda a cor por currentColor: basta animar 'color' */

        /* Em retrato algumas cenas escondem itens por CSS (os 2 últimos
           projetos, por exemplo). Animá-los gastava passos de scroll em
           coisas invisíveis, por isso filtram-se aqui. */
        const visiveis = (lista: NodeListOf<HTMLElement>) =>
          Array.from(lista).filter((el) => getComputedStyle(el).display !== 'none');

        /* Tira o cabeçalho do caminho antes de um item passar a ocupar o
           cartão todo. .sv-head vai na lista de propósito: é ele que tem o
           border-bottom, e sem isso ficava uma linha solta a atravessar. */
        const esconderCabecalho = (cena: HTMLElement) => {
          const cab = ['.sv-head', '.sv-eyebrow', 'h2', '.sv-head__aside']
            .map((s) => cena.querySelector(s))
            .filter(Boolean);
          if (cab.length) {
            tl.to(cab, { autoAlpha: 0, y: -24, ease: 'power2.in', duration: 0.5 });
          }
        };

        /* Um item de cada vez, a ocupar o cartão: o padrão do Processo,
           reutilizado em retrato pelas cenas que em paisagem mostram
           várias colunas ao mesmo tempo. */
        const umAUm = (itens: HTMLElement[]) => {
          itens.forEach((item, j) => {
            tl.fromTo(item,
              { autoAlpha: 0, y: 40, scale: 0.96 },
              { autoAlpha: 1, y: 0, scale: 1, ease: 'power3.out', duration: 0.7 })
              .to({}, { duration: 0.7 });
            if (j < itens.length - 1) {
              tl.to(item, { autoAlpha: 0, y: -36, scale: 0.98, ease: 'power2.in', duration: 0.45 });
            }
          });
        };

        /* Cena -> instante da timeline em que fica visível (ver mais abaixo) */
        const instantes = new Map<HTMLElement, number>();

        cenas.forEach((cena, i) => {
          if (rotaCor) {
            const cor = CORES[i % CORES.length];
            tl.to(rotaCor, { stroke: cor, ease: 'none', duration: 0.6 }, '<');
          }
          tl.to(cena, { autoAlpha: 1, y: 0, ease: 'power2.out', duration: 0.9 });
          /* Instante real em que esta cena acaba de entrar. Os links âncora
             usam isto para saber onde parar; estimar por "2.7 por cena"
             falhava sempre que uma cena tinha sub-passos, e em retrato
             quase todas têm. */
          instantes.set(cena, tl.duration());
          tl.to({}, { duration: 1.1 }); /* tempo de leitura */

          /* Cenas com passos: cada item ocupa o cartão sozinho, um por scroll.
             Usado na Solução, para os 6 pontos não aparecerem todos de uma vez. */
          const passos = cena.querySelectorAll<HTMLElement>('.sv-solution__list li');
          if (passos.length) {
            /* o título sai para dar lugar aos pontos */
            /* filtra nulos: nem todas as cenas têm eyebrow */
            const cabecalho = ['.sv-eyebrow', 'h2', '.sv-lead']
              .map((s) => cena.querySelector(s))
              .filter(Boolean);
            if (cabecalho.length) {
              tl.to(cabecalho, { autoAlpha: 0, y: -24, ease: 'power2.in', duration: 0.5 });
            }
            const trilho = cena.querySelector<HTMLElement>('[data-cine-trilho-barra]');
            passos.forEach((passo, j) => {
              tl.fromTo(passo,
                { autoAlpha: 0, y: 32, scale: 0.96 },
                { autoAlpha: 1, y: 0, scale: 1, ease: 'power3.out', duration: 0.7 });
              /* a linha cresce ao ritmo dos pontos, para eles não ficarem soltos */
              if (trilho) {
                tl.to(trilho, {
                  scaleX: (j + 1) / passos.length, ease: 'power2.out', duration: 0.7,
                }, '<');
              }
              tl.to({}, { duration: 0.8 });
              if (j < passos.length - 1) {
                tl.to(passo, { autoAlpha: 0, y: -32, scale: 0.98, ease: 'power2.in', duration: 0.5 });
              }
            });
          }

          /* Processo: cada passo ocupa o cartão sozinho, grande e destacado */
          const etapas = cena.querySelectorAll<HTMLElement>('.sv-steps .sv-step');
          if (etapas.length) {
            /* .sv-head incluído de propósito: é ele que tem o border-bottom,
               e sem isto ficava uma linha solta a atravessar o cartão. */
            const cab = ['.sv-head', '.sv-eyebrow', 'h2', '.sv-head__aside']
              .map((s) => cena.querySelector(s))
              .filter(Boolean);
            if (cab.length) {
              tl.to(cab, { autoAlpha: 0, y: -24, ease: 'power2.in', duration: 0.5 });
            }
            etapas.forEach((etapa, j) => {
              tl.fromTo(etapa,
                { autoAlpha: 0, y: 40, scale: 0.94 },
                { autoAlpha: 1, y: 0, scale: 1, ease: 'back.out(1.4)', duration: 0.7 })
                .to({}, { duration: 0.7 });
              if (j < etapas.length - 1) {
                tl.to(etapa, { autoAlpha: 0, y: -36, scale: 0.97, ease: 'power2.in', duration: 0.45 });
              }
            });
          }

          /* Pacotes: em paisagem cada coluna entra com o seu próprio scroll e
             as três ficam lado a lado para comparar. Em retrato não há três
             colunas: cada pacote ocupa o cartão sozinho, um por scroll. */
          const planos = cena.querySelectorAll<HTMLElement>('.sv-plan');
          if (planos.length) {
            if (isMobile) {
              esconderCabecalho(cena);
              umAUm(visiveis(planos));
            } else {
              planos.forEach((plano) => {
                tl.fromTo(plano,
                  { autoAlpha: 0, y: 40, scale: 0.97 },
                  { autoAlpha: 1, y: 0, scale: 1, ease: 'power3.out', duration: 0.7 })
                  .to({}, { duration: 0.7 });
              });
            }
          }

          /* Manutenção e Trabalhos: só em retrato. Em paisagem cabem em
             grelha e entram com a própria cena, sem passos extra. */
          if (isMobile) {
            const cuidados = visiveis(cena.querySelectorAll<HTMLElement>('.sv-care__item'));
            if (cuidados.length) {
              esconderCabecalho(cena);
              umAUm(cuidados);
            }

            const projetos = visiveis(cena.querySelectorAll<HTMLElement>('.sv-work__item'));
            if (projetos.length) {
              esconderCabecalho(cena);
              umAUm(projetos);
            }
          }

          if (i < cenas.length - 1) {
            tl.to(cena, { autoAlpha: 0, y: -40, ease: 'power2.in', duration: 0.7 });
          }
        });

        /* ---- Traçado geométrico: desenha-se ao longo de todo o scroll ----
           Num ScrollTrigger próprio, e não no `tl` das cenas, para o ritmo
           do traço ser contínuo em vez de saltar de cena em cena. */
        /* ---- Seta que desce a página, deixando rasto ----
           Só o rasto: o núcleo luminoso foi removido por chamar demasiada
           atenção. O traço sozinho dá o movimento sem competir com o texto. */
        const rota = root.querySelector<SVGPathElement>('[data-cine-rota]');

        if (rota) {
          /* Comprimento medido em PIXELS DE ECRÃ: com non-scaling-stroke o
             tracejado é calculado em espaço de ecrã, mas preserveAspectRatio
             "none" estica o viewBox, por isso getTotalLength() (unidades do
             viewBox) daria um dasharray pequeno de mais. */
          const svg = rota.ownerSVGElement!;
          const emEcra = (dist: number) => {
            const m = rota.getScreenCTM();
            const u = rota.getPointAtLength(dist);
            const pt = svg.createSVGPoint();
            pt.x = u.x;
            pt.y = u.y;
            return m ? pt.matrixTransform(m) : ({ x: u.x, y: u.y } as DOMPoint);
          };

          let comprimentoEcra = 0;
          const medir = () => {
            const n = rota.getTotalLength();
            let total = 0;
            let ant: DOMPoint | null = null;
            for (let i = 0; i <= 40; i++) {
              const s = emEcra((n * i) / 40);
              if (ant) total += Math.hypot(s.x - ant.x, s.y - ant.y);
              ant = s;
            }
            comprimentoEcra = total || n;
            gsap.set(rota, { strokeDasharray: comprimentoEcra, strokeDashoffset: comprimentoEcra });
          };
          medir();
          window.addEventListener('resize', medir);


          /* o rasto revela o troço já percorrido */
          const posicionar = (p: number) => {
            gsap.set(rota, { strokeDashoffset: comprimentoEcra * (1 - p) });
          };

          posicionar(0);

          /* Parallax: o rasto deriva devagar enquanto as cenas trocam.
             Camadas a velocidades diferentes leem-se como profundidade. */
          tl.fromTo(rota,
            { yPercent: 4, scale: 1.06 },
            { yPercent: -5, scale: 1, ease: 'none', duration: tl.duration() },
            0);

          const barra = root.querySelector<HTMLElement>('[data-cine-progresso-barra]');

          tl.eventCallback('onUpdate', () => {
            const p = tl.progress();
            posicionar(p);
            if (barra) gsap.set(barra, { scaleX: p });
          });

          /* A barra só existe enquanto a sequência está a decorrer.
             O ScrollTrigger não tem eventCallback (isso é das timelines):
             o onToggle declara-se na criação, por isso marca-se aqui em
             cada atualização, que é barato e não precisa de listener. */
          const marcar = () => {
            const st2 = tl.scrollTrigger;
            if (!st2) return;
            if (st2.isActive) root.setAttribute('data-cine-ativo', '');
            else root.removeAttribute('data-cine-ativo');
          };
          marcar();
          window.addEventListener('scroll', marcar, { passive: true });
        }

        /* Os links #pacotes / #manutencao / #faq deixariam de funcionar dentro
           de um pin. Recalculam-se para a posição de scroll da cena certa. */
        const st = tl.scrollTrigger;
        if (st) {
          document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
            const alvo = a.getAttribute('href')!.slice(1);
            if (!alvo) return;
            const cena = cenas.find((c) => c.id === alvo);
            if (!cena) return;
            const instante = instantes.get(cena);
            if (instante === undefined) return;
            a.addEventListener('click', (e) => {
              /* start/end lêem-se AGORA, não na montagem: aí o ScrollTrigger
                 ainda não os tinha calculado, davam 0 e o destino colapsava
                 para o topo da página. Era por isso que o "Ver pacotes" da
                 hero não fazia nada. Também mudam a cada resize. */
              const total = st.end - st.start;
              const dur = tl.duration();
              if (!total || !dur) return; /* sem pin ativo, deixa o browser saltar */
              e.preventDefault();
              window.scrollTo({
                top: st.start + (instante / dur) * total,
                behavior: 'smooth',
              });
            });
          });
        }

        /* Contador dos dias, ligado ao mesmo scroll */
        const el = root.querySelector<HTMLElement>('[data-cine-count]');
        if (el) {
          const o = { v: 0 };
          tl.to(o, {
            v: 14, duration: 1.8, ease: 'expo.out',
            onUpdate: () => { el.textContent = String(Math.round(o.v)); },
          }, 2.2);
        }

        /* Brilho e inclinação com o rato */
        const tilt = root.querySelector<HTMLElement>('[data-cine-tilt]');
        if (tilt && window.matchMedia('(pointer: fine)').matches) {
          let frame = 0;
          window.addEventListener('mousemove', (e) => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(() => {
              const r = card.getBoundingClientRect();
              if (!r.width) return;
              card.style.setProperty('--mx', ((e.clientX - r.left) / r.width) * 100 + '%');
              card.style.setProperty('--my', ((e.clientY - r.top) / r.height) * 100 + '%');
              gsap.to(tilt, {
                rotationY: (e.clientX / window.innerWidth - 0.5) * 20,
                rotationX: -(e.clientY / window.innerHeight - 0.5) * 16,
                ease: 'power3.out', duration: 1.1,
              });
            });
          }, { passive: true });
        }
      }, root);

      window.addEventListener('beforeunload', () => ctx.revert());
    }
  }
</script>


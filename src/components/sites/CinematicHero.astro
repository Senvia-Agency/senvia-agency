  }

  #cine .cine__card .sv-btn--outline {
    border-color: rgba(255, 255, 255, 0.45);
    color: #fff;
  }

  #cine .cine__card .sv-btn--outline:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 1024px) {
    #cine .cine__left {
      order: 1;
      text-align: left;
    }
    #cine .cine__actions {
      justify-content: flex-start;
    }
  }

  #cine .cine__mock {
    order: 2;
    position: relative;
    display: grid;
    place-items: center;
    perspective: 1100px;
    transform-style: preserve-3d;
  }

  #cine .cine__mockinner {
    width: 100%;
    max-width: 640px;
    transform-style: preserve-3d;
    will-change: transform;
  }

  #cine .cine__media {
    position: relative;
    line-height: 0;
  }

  #cine .cine__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  #cine .cine__video[data-playing] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    #cine .cine__video {
      display: none;
    }
  }

  /* Botão de pausa do vídeo (WCAG 2.2.2) */
  #cine .cine__vtoggle {
    position: absolute;
    bottom: 0.6rem;
    right: 0.6rem;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(11, 31, 42, 0.78);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  #cine .cine__vtoggle[hidden] {
    display: none;
  }

  #cine .cine__vtoggle:hover {
    background: rgba(11, 31, 42, 0.92);
  }

  #cine .cine__vtoggle svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: currentColor;
    flex: none;
  }

  #cine .cine__right {
    order: 1;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    #cine .cine__right {
      order: 3;
      justify-content: flex-end;
    }
  }

  #cine .cine__brand {
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    background: linear-gradient(180deg, #ffffff 0%, #7f97a8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transform: translateZ(0);
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.6));
  }

  /* ---------- recortes de vidro ---------- */
  #cine .cine__badge {
    position: absolute;
    z-index: 30;
  }

  /* Fundo OPACO, não vidro: estes cards assentam por cima do screenshot do
     cliente, que é claro e cheio de detalhe. Translúcidos ficavam ilegíveis. */
  #cine .cine__badgeinner {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.95rem;
    border-radius: 14px;
    background: linear-gradient(145deg, #14384c 0%, #0b1f2a 100%);
    box-shadow:
      0 0 0 1px rgba(148, 163, 184, 0.28),
      0 25px 50px -14px rgba(0, 0, 0, 0.75),
      inset 0 1px 1px rgba(255, 255, 255, 0.14);
    color: #fff;
    white-space: nowrap;
  }

  #cine a.cine__badgeinner {
    min-height: 44px;
  }

  #cine .cine__badgeinner b {
    display: block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  #cine .cine__badgeinner i {
    display: block;
    font-style: normal;
    font-size: 0.7rem;
    color: #a8bcc9;
  }

  /* =========================================================
     CENAS: as secções da página dentro do cartão
     ========================================================= */

  /* Sem JS: fluxo normal, uma secção a seguir à outra, tudo legível. */
  #cine .cine__scenes {
    position: relative;
  }

  /* Com JS: cada secção é uma cena empilhada que o scroll troca.
     A inversão de tokens abaixo é o que permite reaproveitar todo o CSS
     das secções (escrito para fundo claro) dentro do cartão navy. */
  #cine[data-cine-on] .cine__scenes {
    position: absolute;
    inset: 0;
    z-index: 4;

    --sv-paper: transparent;
    --sv-paper-2: transparent;
    --sv-white: transparent;
    --sv-ink: #ffffff;
    --sv-text: #cbd6de;
    --sv-muted: #8a98a6;
    --sv-line: rgba(148, 163, 184, 0.24);
    --sv-line-soft: rgba(148, 163, 184, 0.14);
    --sv-line-ui: rgba(255, 255, 255, 0.45);
    --sv-accent-ink: #00c3ff;
    --sv-accent-strong: #33ffe3;
    --sv-accent-soft: rgba(0, 195, 255, 0.12);
  }

  #cine[data-cine-on] .cine__scenes > * {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    /* NUNCA overflow-y:auto aqui. A cena passava a ter scroll próprio e
       engolia a roda do rato: com o cursor sobre o cartão a página deixava
       de avançar (medido: parava aos 3600px; fora do cartão ia aos 4800px).
       As cenas são dimensionadas para caber — se não couberem, corta-se
       conteúdo, não se acrescenta scroll. */
    overflow: hidden;
    padding-block: clamp(1.5rem, 4vh, 3rem) !important;
    border: 0 !important;
    background: transparent !important;
  }

  /* As secções escuras já eram navy: dentro do cartão não precisam de fundo */
  #cine[data-cine-on] .cine__scenes .sv-section--dark,
  #cine[data-cine-on] .cine__scenes .sv-final {
    background: transparent !important;
  }

  /* Superfícies que precisam de continuar a ler-se como "cartão dentro da cena" */
  #cine[data-cine-on] .cine__scenes .sv-plan--feature,
  #cine[data-cine-on] .cine__scenes .sv-report,
  #cine[data-cine-on] .cine__scenes .sv-rule,
  #cine[data-cine-on] .cine__scenes .sv-plans__care {
    background: rgba(255, 255, 255, 0.05) !important;
    border-color: rgba(148, 163, 184, 0.24) !important;
  }

  /* O relatório era papel branco; dentro do cartão passa a superfície escura */
  #cine[data-cine-on] .cine__scenes .sv-report,
  #cine[data-cine-on] .cine__scenes .sv-report__head,
  #cine[data-cine-on] .cine__scenes .sv-report__foot {
    background: rgba(255, 255, 255, 0.04) !important;
    color: #cbd6de;
  }

  #cine[data-cine-on] .cine__scenes .sv-report__title,
  #cine[data-cine-on] .cine__scenes .sv-report__pills span {
    color: #ffffff;
  }

  #cine[data-cine-on] .cine__scenes .sv-report__pills span {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(148, 163, 184, 0.3);
  }

  /* Botões escuros ficariam invisíveis sobre navy */
  #cine[data-cine-on] .cine__scenes .sv-btn--dark {
    background: var(--sv-cyan);
    color: #04212c;
  }

  #cine[data-cine-on] .cine__scenes .sv-btn--ghost {
    border-color: rgba(255, 255, 255, 0.45);
    color: #ffffff;
  }

  /* ---------- compressão: o conteúdo tem de caber na altura do cartão ----------
     As secções foram desenhadas para uma página com scroll livre. Dentro de
     uma cena de ~84vh precisam de encolher, senão ficam cortadas em cima e
     em baixo (verificado: pacotes e trabalhos transbordavam). */
  #cine[data-cine-on] .cine__scenes .sv-container {
    max-width: 1240px;
  }

  #cine[data-cine-on] .cine__scenes .sv-head {
    margin-bottom: clamp(0.75rem, 2vh, 1.5rem);
    padding-bottom: 0.75rem;
  }

  #cine[data-cine-on] .cine__scenes h2 {
    font-size: var(--cine-fs-h2);
  }

  #cine[data-cine-on] .cine__scenes .sv-head__aside,
  #cine[data-cine-on] .cine__scenes .sv-lead {
    font-size: var(--sv-fs-body);
  }

  /* Pacotes: a lista de features é o que mais cresce */
  #cine[data-cine-on] .cine__scenes .sv-plan__list li,
  #cine[data-cine-on] .cine__scenes .sv-care__item li {
    padding: 0.2rem 0;
    font-size: 0.84rem;
  }

  #cine[data-cine-on] .cine__scenes .sv-plan__desc,
  #cine[data-cine-on] .cine__scenes .sv-care__for {
    font-size: 0.82rem;
    margin-bottom: 0.6rem;
    min-height: 0 !important;
  }

  #cine[data-cine-on] .cine__scenes .sv-plan__amount {
    font-size: clamp(1.6rem, 3vh, 2.1rem);
  }

  #cine[data-cine-on] .cine__scenes .sv-plan--feature {
    margin-top: 0 !important;
    padding-block: 1rem !important;
  }

  #cine[data-cine-on] .cine__scenes .sv-plans__note {
    margin-top: 1rem;
    padding-top: 0.75rem;
  }

  /* Trabalhos: 7 projetos não cabem em 2 colunas — passam a 3, mais baixos */
  @media (min-width: 900px) {
    #cine[data-cine-on] .cine__scenes .sv-work {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    #cine[data-cine-on] .cine__scenes .sv-work__item--lead {
      grid-column: auto;
    }
  }

  #cine[data-cine-on] .cine__scenes .sv-work__item figcaption {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    gap: 0.25rem 0.5rem;
  }

  #cine[data-cine-on] .cine__scenes .sv-work__name {
    font-size: 0.88rem;
    min-height: 0;
  }

  #cine[data-cine-on] .cine__scenes .sv-work__details {
    display: none; /* o detalhe fica no site real, que está a um clique */
  }

  #cine[data-cine-on] .cine__scenes .sv-work__cta {
    margin-top: 1rem;
    padding-top: 0.75rem;
  }

  /* FAQ e processo */
  #cine[data-cine-on] .cine__scenes .sv-faq__item summary {
    padding: 0.7rem 0;
    font-size: 0.95rem;
  }

  #cine[data-cine-on] .cine__scenes .sv-faq__item p {
    font-size: 0.88rem;
    padding-bottom: 0.7rem;
  }

  /* Processo: cada passo ocupa o cartão sozinho, grande */
  #cine[data-cine-on] .cine__scenes .sv-steps {
    position: absolute;
    inset: 0;
    display: block;
  }

  #cine[data-cine-on] .cine__scenes .sv-steps::before {
    display: none;
  }

  #cine[data-cine-on] .cine__scenes .sv-step {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem clamp(1.5rem, 6vw, 5rem);
    border: 0;
    opacity: 0;
  }

  #cine[data-cine-on] .cine__scenes .sv-step::after {
    display: none;
  }

  #cine[data-cine-on] .cine__scenes .sv-step__n {
    width: clamp(3.5rem, 9vh, 5.5rem);
    height: clamp(3.5rem, 9vh, 5.5rem);
    font-size: clamp(1.3rem, 3.4vh, 2rem);
    font-weight: 800;
    color: #04212c;
    background: linear-gradient(145deg, #33ffe3 0%, #00c3ff 100%);
    border: 0;
    box-shadow: 0 18px 40px -14px rgba(0, 195, 255, 0.65);
    margin-bottom: 1.5rem;
  }

  #cine[data-cine-on] .cine__scenes .sv-step__label {
    font-size: var(--cine-fs-solo);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: #fff;
    max-width: 20ch;
  }

  /* O passo condicional mantém o sinal de que só se aplica à Validação */
  #cine[data-cine-on] .cine__scenes .sv-step--cond .sv-step__n {
    background: linear-gradient(145deg, #0f2937 0%, #17435a 100%);
    color: #33ffe3;
    box-shadow: 0 0 0 2px rgba(51, 255, 227, 0.5), 0 18px 40px -14px rgba(0, 0, 0, 0.6);
  }

  #cine[data-cine-on] .cine__scenes .sv-step--cond .sv-step__label {
    color: #33ffe3;
  }

  /* Validação: na cena fica só a mensagem e o CTA. Os 3 momentos e o
     relatório detalhado continuam na versão estática, onde há espaço. */
  #cine[data-cine-on] .cine__scenes #validacao .sv-moments,
  #cine[data-cine-on] .cine__scenes #validacao .sv-validation__report {
    display: none;
  }

  #cine[data-cine-on] .cine__scenes #validacao .sv-validation__inner {
    display: block;
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  #cine[data-cine-on] .cine__scenes #validacao h2 {
    font-size: var(--cine-fs-statement);
    max-width: none;
    margin-bottom: 1.1rem;
  }

  #cine[data-cine-on] .cine__scenes #validacao .sv-lead {
    font-size: var(--cine-fs-statement-lead);
    max-width: 40ch;
    margin: 0 auto 2rem;
  }

  #cine[data-cine-on] .cine__scenes #validacao .sv-eyebrow {
    justify-content: center;
  }

  /* CTA final: grande e centrado, é o último ecrã antes de sair */
  #cine[data-cine-on] .cine__scenes #contacto .sv-final__inner {
    display: block;
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  #cine[data-cine-on] .cine__scenes #contacto h2 {
    font-size: var(--cine-fs-statement);
    max-width: none;
    margin-bottom: 1.1rem;
  }

  #cine[data-cine-on] .cine__scenes #contacto p {
    font-size: var(--cine-fs-statement-lead);
    max-width: 44ch;
    margin-inline: auto;
  }

  #cine[data-cine-on] .cine__scenes #contacto .sv-final__actions {
    justify-content: center;
    margin-top: 2rem;
  }

  #cine[data-cine-on] .cine__scenes #contacto .sv-final__note {
    text-align: center;
  }

  /* Aperto final nas 3 cenas que ainda transbordavam (medido: dor +61px,
     pacotes +208px, trabalhos +188px). */

  /* Dor: na cena fica só a frase, grande e centrada.
     A lista das 5 dores e a figura continuam na versão estática. */
  #cine[data-cine-on] .cine__scenes .sv-pain__figure,
  #cine[data-cine-on] .cine__scenes .sv-pain__right,
  #cine[data-cine-on] .cine__scenes .sv-pain__list {
    display: none;
  }

  #cine[data-cine-on] .cine__scenes .sv-pain__inner {
    display: block;
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }

  #cine[data-cine-on] .cine__scenes .sv-pain__copy {
    position: static !important;
  }

  #cine[data-cine-on] .cine__scenes .sv-pain__copy .sv-eyebrow {
    justify-content: center;
  }

  #cine[data-cine-on] .cine__scenes .sv-pain__copy h2 {
    font-size: var(--cine-fs-statement);
    max-width: none;
    margin-bottom: 1.2rem;
  }

  #cine[data-cine-on] .cine__scenes .sv-pain__copy .sv-lead {
    font-size: var(--cine-fs-statement-lead);
    max-width: 46ch;
    margin-inline: auto;
  }

  /* Pacotes: nota de rodapé e reforço saem — vivem na versão estática */
  #cine[data-cine-on] .cine__scenes .sv-plans__reassure,
  #cine[data-cine-on] .cine__scenes .sv-plan__note {
    display: none;
  }
  #cine[data-cine-on] .cine__scenes .sv-plan__list li {
    padding: 0.13rem 0;
    font-size: 0.8rem;
  }
  #cine[data-cine-on] .cine__scenes .sv-plan__incl {
    margin-bottom: 0.4rem !important;
  }
  #cine[data-cine-on] .cine__scenes .sv-plan__body {
    margin-top: 0.7rem;
    padding-top: 0.7rem;
  }

  /* Trabalhos: 6 projetos em 3 colunas, sem scroll interno.
     O que come altura aqui são as legendas por baixo de cada mockup, não
     as imagens. Passam a sobrepor-se ao próprio mockup. */
  #cine[data-cine-on] .cine__scenes .sv-work__item:nth-child(7) {
    display: none;
  }
  #cine[data-cine-on] .cine__scenes .sv-work {
    gap: 0.7rem 0.9rem;
  }
  #cine[data-cine-on] .cine__scenes .sv-work__item {
    position: relative;
  }
  #cine[data-cine-on] .cine__scenes .sv-work__item figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 1.6rem 0.7rem 0.55rem;
    border: 0;
    border-radius: 0 0 14px 14px;
    background: linear-gradient(to top, rgba(4, 16, 24, 0.94) 45%, transparent 100%);
    align-items: center;
    gap: 0.4rem;
    pointer-events: none;
  }
  #cine[data-cine-on] .cine__scenes .sv-work__name {
    pointer-events: auto;
    font-size: 0.82rem;
  }
  #cine[data-cine-on] .cine__scenes .sv-work__cat {
    font-size: 0.58rem;
    padding: 0.1rem 0.4rem;
  }
  #cine[data-cine-on] .cine__scenes .sv-work__cta {
    margin-top: 0.85rem;
    padding-top: 0.7rem;
  }
  #cine[data-cine-on] .cine__scenes .sv-work__cta p {
    font-size: 0.9rem;
  }

  /* Pacotes: o aviso de manutenção e a oferta de domínio ficam na versão
     estática, onde há espaço para os ler com calma. */
  #cine[data-cine-on] .cine__scenes .sv-plans__care,
  #cine[data-cine-on] .cine__scenes .sv-plans__note .sv-fine {
    display: none;
  }
  #cine[data-cine-on] .cine__scenes .sv-plans__gift {
    font-size: 0.85rem;
    margin-bottom: 0;
  }

  /* Pacotes: últimos 26px. A oferta de domínio sai da cena (fica na estática). */
  #cine[data-cine-on] .cine__scenes .sv-plans__note {
    display: none;
  }

  /* ---------- Solução: título grande, depois um ponto de cada vez ---------- */
  #cine[data-cine-on] .cine__scenes .sv-solution__visual {
    display: none;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__inner {
    display: block;
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__copy .sv-eyebrow {
    justify-content: center;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__copy h2 {
    font-size: var(--cine-fs-statement);
    max-width: none;
    margin-bottom: 1.1rem;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__copy .sv-lead {
    font-size: var(--cine-fs-statement-lead);
    max-width: 44ch;
    margin-inline: auto;
  }

  /* Cada ponto ocupa o cartão sozinho, grande e centrado */
  #cine[data-cine-on] .cine__scenes .sv-solution__list {
    position: absolute;
    inset: 0;
    display: block;
    margin: 0;
    border: 0;
    pointer-events: none;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__list li {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem clamp(1.5rem, 6vw, 5rem);
    border: 0;
    opacity: 0;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__list h3 {
    display: block;
    font-size: var(--cine-fs-solo);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #fff;
    margin-bottom: 1rem;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__list h3::before {
    display: none;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__list p {
    font-size: clamp(1rem, 1.8vh + 0.6rem, 1.35rem);
    line-height: 1.5;
    color: #cbd6de;
    max-width: 34ch;
    padding: 0;
  }

  /* "Desliza" da Solução: convida ao scroll em vez de explicar */
  #cine[data-cine-on] .cine__scenes .sv-solution__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sv-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a98a6;
    margin-top: 1.75rem;
  }

  #cine[data-cine-on] .cine__scenes .sv-solution__hint svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: #00c3ff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: cine-bob 1.8s ease-in-out infinite;
  }

  /* Na versão estática não há scroll de cena a convidar: fica escondido */
  #cine:not([data-cine-on]) .sv-solution__hint {
    display: none;
  }

  /* Trilho que liga os pontos da Solução ao longo do scroll */
  #cine .cine__trilho {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 12%;
    height: 2px;
    border-radius: 2px;
    background: rgba(148, 163, 184, 0.2);
    overflow: hidden;
    pointer-events: none;
  }

  #cine .cine__trilho span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #007599 0%, #00c3ff 60%, #33ffe3 100%);
    box-shadow: 0 0 14px rgba(0, 195, 255, 0.5);
  }

  /* ---------- frase de impacto (meio do scroll) ---------- */
  #cine .cine__focus {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: 1.5rem;
    font-size: clamp(2.4rem, 7vw, 6rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.045em;
    color: #fff;

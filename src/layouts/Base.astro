---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, ADSENSE_CLIENT } from '../config';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const props = Astro.props;

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/lovable-uploads/bb92eb59-bee0-4023-b121-9bccea466ca8.png', SITE.url).toString(),
  description: SITE.description,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Leiria',
    addressCountry: 'PT',
  },
  sameAs: [
    'https://www.instagram.com/senvia.pt/',
    'https://www.facebook.com/senvia.pt',
    'https://www.linkedin.com/company/senvia-pt/',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Customer Service',
    url: SITE.url,
  },
};

const jsonLd = props.jsonLd ?? defaultJsonLd;
---

<!DOCTYPE html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#00c3ff" />
    <link rel="icon" type="image/png" href="/lovable-uploads/bb92eb59-bee0-4023-b121-9bccea466ca8.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" /></noscript>

    <!--
      AdSense script removed from <head> (RGPD compliance).
      O ConsentBanner.astro carrega o script apenas após consentimento explícito do utilizador.
      Ver src/components/ConsentBanner.astro:loadAdSense().
      Auditoria 2026-07-16 CRIT-1.
    -->

    <SEO {...props} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar para o conteúdo</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

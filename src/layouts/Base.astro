---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, ADSENSE_CLIENT } from '../config';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const props = Astro.props;
const metaPixelId = '2027821837745963';

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/lovable-uploads/bb92eb59-bee0-4023-b121-9bccea466ca8.png', SITE.url).toString(),
  description: SITE.description,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Leiria',
    addressCountry: 'PT',
  },
  sameAs: [
    'https://www.instagram.com/senvia.pt/',
    'https://www.facebook.com/senvia.pt',
    'https://www.linkedin.com/company/senvia-pt/',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Customer Service',
    url: SITE.url,
  },
};

const jsonLd = props.jsonLd ?? defaultJsonLd;
---

<!DOCTYPE html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#00c3ff" />
    <link rel="icon" type="image/png" href="/lovable-uploads/bb92eb59-bee0-4023-b121-9bccea466ca8.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" /></noscript>

    <!--
      AdSense script removed from <head> (RGPD compliance).
      O ConsentBanner.astro carrega o script apenas após consentimento explícito do utilizador.
      Ver src/components/ConsentBanner.astro:loadAdSense().
      Auditoria 2026-07-16 CRIT-1.
    -->

    <SEO {...props} />
    <script is:inline define:vars={{ metaPixelId }}>
      !function(f,b,e,v,n,t,s) {
        if (f.fbq) return;
        n = f.fbq = function() {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = true;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

      const getMetaExternalId = () => {
        const key = 'senvia_external_id';
        const cookieMatch = document.cookie.match(new RegExp('(?:^|; )' + key + '=([^;]+)'));
        const cookieValue = cookieMatch ? decodeURIComponent(cookieMatch[1]) : '';
        const storedValue = localStorage.getItem(key) || cookieValue;
        const value = storedValue || (crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(16).slice(2)}`);
        localStorage.setItem(key, value);
        document.cookie = `${key}=${encodeURIComponent(value)}; path=/; domain=.senvia.pt; max-age=31536000; SameSite=Lax; Secure`;
        return value;
      };

      const metaExternalId = getMetaExternalId();

      fbq('init', metaPixelId, { external_id: metaExternalId });
      fbq('track', 'PageView');

      const appendExternalId = (href) => {
        try {
          const url = new URL(href);
          if (url.hostname === 'app.senvia.pt' && !url.searchParams.has('external_id')) {
            url.searchParams.set('external_id', metaExternalId);
            return url.toString();
          }
        } catch {}
        return href;
      };

      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('a[href^="https://app.senvia.pt"]').forEach((link) => {
          link.href = appendExternalId(link.href);
        });
      });
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
    <a href="#main" class="skip-link">Saltar para o conteúdo</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

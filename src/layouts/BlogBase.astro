---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogFooter from '../components/BlogFooter.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const props = Astro.props;
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: `${SITE.name} Blog`,
  url: SITE.blogUrl,
  logo: new URL('/lovable-uploads/bb92eb59-bee0-4023-b121-9bccea466ca8.png', SITE.blogUrl).toString(),
  description: SITE.blogDescription,
  contactPoint: { '@type': 'ContactPoint', email: SITE.email, contactType: 'Customer Service', availableLanguage: 'Portuguese' },
};
const jsonLd = props.jsonLd ?? defaultJsonLd;
---

<!DOCTYPE html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#00c3ff" />
    <link rel="icon" type="image/png" href="/lovable-uploads/bb92eb59-bee0-4023-b121-9bccea466ca8.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" /></noscript>
    <SEO {...props} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar para o conteúdo</a>
    <BlogHeader />
    <main id="main" style="padding-top: 1.5rem"><slot /></main>
    <BlogFooter />
    <ConsentBanner />
  </body>
</html>

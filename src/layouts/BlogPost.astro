---
import Base from './BlogBase.astro';
import AdSense from '../components/AdSense.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES, SITE } from '../config';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';

interface Props {
  entry: CollectionEntry<'artigos'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const cat = CATEGORIES[data.category];
const dateLabel = new Intl.DateTimeFormat('pt-PT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(data.pubDate);

const updatedLabel = data.updatedDate
  ? new Intl.DateTimeFormat('pt-PT', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(data.updatedDate)
  : null;

// Artigos relacionados (mesma categoria, exceto o atual)
const all = await getCollection('artigos', ({ data: d }) => !d.draft);
const related = all
  .filter((e) => e.data.category === data.category && e.id !== entry.id)
  .slice(0, 3);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Início',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: cat.label,
      item: new URL(`/blog/categoria/${data.category}/`, SITE.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
    },
  ],
};

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  image: data.coverImage ? new URL(data.coverImage, SITE.url).toString() : undefined,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: data.author ?? SITE.defaultAuthor,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.ico', SITE.url).toString(),
    },
  },
  mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).toString(),
  articleSection: cat.label,
  keywords: data.tags.join(', '),
  inLanguage: 'pt-PT',
};

const jsonLd = [articleJsonLd, breadcrumbJsonLd];
---

<Base
  title={data.title}
  description={data.description}
  type="article"
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.pubDate).toISOString()}
  author={data.author ?? SITE.defaultAuthor}
  section={cat.label}
  tags={data.tags}
  image={data.coverImage}
  noindex={true}
  jsonLd={jsonLd}
>
  <article class="container container--narrow">
    <nav class="breadcrumbs" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span class="breadcrumbs__sep" aria-hidden="true">›</span>
      <a href={`/blog/categoria/${data.category}/`}>{cat.label}</a>
      <span class="breadcrumbs__sep" aria-hidden="true">›</span>
      <span style="color:var(--fg)">{data.title}</span>
    </nav>

    <header class="article-header">
      <div class="article-header__category">
        <span class="badge" style={`color:${cat.color}`}>{cat.short}</span>
      </div>
      {data.coverImage && (
        <img
          src={data.coverImage}
          alt={data.title}
          class="article-header__cover"
          width="1200"
          height="800"
          loading="eager"
          decoding="async"
          style="width:100%;height:auto;border-radius:var(--radius-lg);margin-bottom:var(--space-4);object-fit:cover;aspect-ratio:3/2"
        />
      )}
      <h1>{data.title}</h1>
      <p class="article-header__lead lead">{data.description}</p>
      <div class="article-header__meta">
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {dateLabel}
        </span>
        {updatedLabel && (
          <span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Atualizado a {updatedLabel}
          </span>
        )}
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {data.readingTime ?? Math.max(3, Math.round(data.description.length / 30))} min de leitura
        </span>
      </div>
    </header>

    <div class="ad-slot ad-slot--in-article">
      <AdSense slot="6706663080" type="in-article" label />
    </div>

    <div class="article-body prose">
      <Content />
    </div>

    <div class="ad-slot ad-slot--in-article">
      <AdSense slot="4080499747" type="autorelaxed" label />
    </div>

    <div class="divider"></div>

    {data.tags.length > 0 && (
      <div style="margin-bottom:var(--space-6)">
        <strong style="display:block;margin-bottom:var(--space-3);font-size:0.85rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--fg-muted)">Tags</strong>
        <div>
          {data.tags.map((t) => <a href={`/blog/categoria/${data.category}/`} class="tag-pill">#{t}</a>)}
        </div>
      </div>
    )}

    <div style="background:var(--accent-soft);border-radius:var(--radius-lg);padding:var(--space-6);margin-block:var(--space-7);text-align:center">
      <h3 style="margin:0 0 var(--space-3)">Quer automatizar o seu funil de vendas com IA?</h3>
      <p style="margin-bottom:var(--space-5);color:var(--fg-soft)">A SENVIA ajuda PMEs portuguesas a implementar IA na prática — desde chatbots até qualificação de leads.</p>
      <a href={SITE.url} class="btn btn--primary" rel="noopener">Conhecer a SENVIA →</a>
    </div>

    {related.length > 0 && (
      <section style="margin-block:var(--space-7)">
        <h2 style="margin-top:0">Leia também em {cat.label}</h2>
        <div class="article-grid">
          {related.map((r) => <ArticleCard entry={r} />)}
        </div>
      </section>
    )}
  </article>
</Base>
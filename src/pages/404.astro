---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Página não encontrada" description="A página não existe." noindex>
  <section class="section" style="padding-top: 10rem; text-align: center;">
    <div class="container container--narrow">
      <span class="badge mb-6">Erro 404</span>
      <h1>Página não encontrada</h1>
      <p class="text-muted mb-8" style="font-size: 1.125rem;">O endereço que procurou não existe ou foi movido.</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn--primary">Ir para o início</a>
        <a href="/contacto" class="btn btn--outline">Contactar SENVIA</a>
      </div>
    </div>
  </section>
</Base>

from PIL import Image, ImageDraw, ImageFont
import os

# Criar imagem melhor para reembolsos de seguros
img = Image.new('RGB', (1200, 800), '#0b1f2a')
draw = ImageDraw.Draw(img)

# Cores
colors = [(11, 31, 42), (0, 55, 75), (0, 80, 100)]
for y in range(800):
    ratio = y / 800
    r = int(11 * (1-ratio) + 0 * ratio)
    g = int(31 * (1-ratio) + 195 * ratio * 0.3)
    b = int(42 * (1-ratio) + 255 * ratio * 0.3)
    for x in range(1200):
        pass

# fundo gradiente mais simples
overlay = Image.new('RGB', (1200, 800))
for y in range(800):
    for x in range(1200):
        r = int(11 + (0 - 11) * y/800)
        g = int(31 + (150 - 31) * y/800)
        b = int(42 + (200 - 42) * y/800)
        overlay.putpixel((x, y), (r, g, b))

img = overlay

# Icone de relogio/seguro (forma basica)
draw = ImageDraw.Draw(img)
# Circulo
draw.ellipse([80, 80, 280, 280], fill=(0, 195, 255, 30), outline=(0, 195, 255, 80), width=3)
# Shield shape
draw.polygon([(160, 140), (220, 140), (230, 200), (190, 250), (150, 200)], fill=None, outline=(0, 195, 255), width=2)
# Check
draw.line([(170, 195), (185, 210), (205, 185)], fill=(0, 195, 255), width=3)

# Texto
try:
    font_title = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', 52)
    font_sub = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 24)
    font_num = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', 80)
except:
    font_title = ImageFont.load_default()
    font_sub = ImageFont.load_default()
    font_num = ImageFont.load_default()


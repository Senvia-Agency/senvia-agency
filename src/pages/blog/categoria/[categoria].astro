---
import Base from '../../../layouts/BlogBase.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { CATEGORIES } from '../../../config';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return Object.keys(CATEGORIES).map((key) => ({
    params: { categoria: key },
  }));
}) satisfies GetStaticPaths;

const { categoria } = Astro.params;
const cat = CATEGORIES[categoria as keyof typeof CATEGORIES];

const all = await getCollection('artigos', (e) => !e.data.draft && e.data.category === categoria);
const sorted = all.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Base
  title={`${cat.label} — Artigos`}
  description={cat.description}
>
  <section class="section">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Navegação estrutural">
        <a href="/">Início</a>
        <span class="breadcrumbs__sep" aria-hidden="true">›</span>
        <span>{cat.label}</span>
      </nav>

      <span class="badge" style={`color:${cat.color};margin-bottom:var(--space-3)`}>{cat.label}</span>
      <h1 style="margin-top:0">{cat.label}</h1>
      <p class="lead" style="max-width:60ch;margin-bottom:var(--space-7)">{cat.description}</p>

      {sorted.length === 0 ? (
        <div style="padding:var(--space-8);text-align:center;background:var(--bg-soft);border-radius:var(--radius-lg);color:var(--fg-muted)">
          <p>Novos artigos em breve nesta categoria.</p>
          <a href="/" class="btn btn--ghost" style="margin-top:var(--space-4)">← Ver todos os artigos</a>
        </div>
      ) : (
        <div class="article-grid">
          {sorted.map((entry) => <ArticleCard entry={entry} />)}
        </div>
      )}
    </div>
  </section>
</Base>
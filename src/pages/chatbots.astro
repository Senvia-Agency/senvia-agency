---
import Base from '../layouts/Base.astro';
import SitesNav from '../components/sites/SitesNav.astro';
import { SITE } from '../config';
import '../styles/chatbots-v2.css';

/* ------------------------------------------------------------------
   Chatbots: uma conversa em 3D (mensagens dos canais, o assistente responde, leads e reuniões).
   Cada capítulo é uma secção alta com um quadro sticky de 100vh; as camadas
   de texto entram conforme o progresso do scroll (data-in / data-out).
   O 3D vive em src/scripts/chatbots-v2.js; os estilos em src/styles/chatbots-v2.css (tudo dentro de .sv2).
------------------------------------------------------------------- */

const demo = SITE.ctaFormUrl;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<Base
  title="Chatbots com IA para WhatsApp, site e email"
  description="Um assistente com IA que responde no WhatsApp, no site e no email, qualifica pedidos, marca reuniões e passa a conversa à equipa quando não sabe. Diagnóstico gratuito."
  canonicalPath="/chatbots"
>
  <SitesNav slot="header" cta="Pedir diagnóstico" ctaHref={demo} />
  <!-- Marca o suporte a JS antes de pintar: as camadas de texto ficam escondidas até o scroll as mostrar -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="preload" href="/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/general-sans-500.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Inter: a letra dos ecrãs desenhados no 3D -->
  <!-- não bloqueia a primeira pintura: as fontes entram por troca (display=swap) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" /></noscript>

  <div class="sv2" id="sv2">
    <canvas id="world" aria-hidden="true"></canvas>
    <canvas id="fg" aria-hidden="true"></canvas>

    <nav class="hud" aria-label="Capítulos da página">
      <b id="hud-n" aria-hidden="true">01</b><span id="hud-name" aria-hidden="true">Início</span><span class="track" aria-hidden="true"><i id="hud-bar"></i></span><span class="dots" id="hud-dots"></span>
    </nav>

    <div class="chapters">
    <!-- 00 início: uma mensagem às 23h47 e o assistente responde -->
      <section class="chapter" id="inicio" data-name="Início" data-beats="2" style="--beats:2">
        <div class="frame">
          <div class="layer pos-left m-high is-in" data-in="0" data-out="0.5">
            <div class="copy">
              <p class="eyebrow">Chatbots com IA · Portugal</p>
              <h1 class="split">Um assistente que responde <em>enquanto dormes</em>.</h1>
              <p class="lede fade" style="--d:1">Responde no WhatsApp, no site e no email, qualifica os pedidos e marca reuniões. Quando não sabe, passa a conversa a uma pessoa da tua equipa.</p>
              <div class="actions fade" style="--d:2">
                <a class="sbtn" href={demo} {...ext}>Pedir diagnóstico</a>
                <a class="sbtn sbtn-ghost" href="#funcoes" data-go="2">Ver o que faz</a>
              </div>
              <p class="fine fade" style="--d:3">Diagnóstico gratuito e sem compromisso.</p>
            </div>
          </div>
          <div class="layer pos-right m-low" data-in="0.5" data-out="1">
            <div class="copy">
              <p class="eyebrow">Sempre ligado</p>
              <h2 class="split">Às 23h47, <em>também responde</em>.</h2>
              <ul class="facts">
                <li class="fade" style="--d:1"><b data-count="24" data-suffix="h">24h</b><span>por dia, todos os dias</span></li>
                <li class="fade" style="--d:2"><b data-count="3">3</b><span>canais com o mesmo assistente</span></li>
                <li class="fade" style="--d:3"><b data-count="0">0</b><span>pedidos esquecidos</span></li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 01 canais: WhatsApp, site e email entram na mesma conversa -->
      <section class="chapter" id="canais" data-name="Canais" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer pos-left m-high" data-in="0" data-out="1">
            <div class="copy">
              <p class="eyebrow">Canais</p>
              <h2 class="split">WhatsApp, site e email. <em>Um só assistente</em>.</h2>
              <p class="lede fade" style="--d:1">O mesmo assistente responde no WhatsApp da empresa, na janela de chat do site e no email, com as mesmas respostas em todo o lado.</p>
              <ul class="tags"><li class="fade" style="--d:2">WhatsApp</li><li class="fade" style="--d:3">Chat no site</li><li class="fade" style="--d:4">Email</li></ul>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 02 o que faz: dúvidas, leads, reuniões e passagem a uma pessoa -->
      <section class="chapter" id="funcoes" data-name="O que faz" data-beats="4" style="--beats:4">
        <div class="frame">
          <div class="layer pos-right m-low" data-in="0" data-out="0.25">
            <div class="copy">
              <p class="eyebrow">O que faz <span class="n">1 de 4</span></p>
              <h2 class="split">Responde às dúvidas <em>com as tuas respostas</em>.</h2>
              <p class="lede fade" style="--d:1">Treinamos o assistente com os teus preços, horários e serviços. Responde como a tua equipa e não inventa o que não sabe.</p>
              <ul class="tags"><li class="fade" style="--d:2">Preços</li><li class="fade" style="--d:3">Horários</li><li class="fade" style="--d:4">Serviços</li><li class="fade" style="--d:5">Português de Portugal</li></ul>
            </div>
          </div>
          <div class="layer pos-left m-high" data-in="0.25" data-out="0.5">
            <div class="copy">
              <p class="eyebrow">O que faz <span class="n">2 de 4</span></p>
              <h2 class="split">Qualifica o pedido <em>e cria a lead</em>.</h2>
              <p class="lede fade" style="--d:1">Faz as perguntas certas, junta os dados do cliente e cria a lead no teu CRM, como o Senvia OS. A equipa recebe tudo pronto.</p>
              <ul class="tags"><li class="fade" style="--d:2">Perguntas certas</li><li class="fade" style="--d:3">Dados do cliente</li><li class="fade" style="--d:4">Senvia OS</li></ul>
            </div>
          </div>
          <div class="layer pos-right m-low" data-in="0.5" data-out="0.75">
            <div class="copy">
              <p class="eyebrow">O que faz <span class="n">3 de 4</span></p>
              <h2 class="split">Marca reuniões <em>na tua agenda</em>.</h2>
              <p class="lede fade" style="--d:1">Vê os horários livres, propõe uma hora e confirma com o cliente. A marcação aparece na agenda da equipa.</p>
              <ul class="tags"><li class="fade" style="--d:2">Horários livres</li><li class="fade" style="--d:3">Confirmação</li><li class="fade" style="--d:4">Agenda da equipa</li></ul>
            </div>
          </div>
          <div class="layer pos-left m-high" data-in="0.75" data-out="1">
            <div class="copy">
              <p class="eyebrow">O que faz <span class="n">4 de 4</span></p>
              <h2 class="split">Quando não sabe, <em>chama uma pessoa</em>.</h2>
              <p class="lede fade" style="--d:1">Nas perguntas fora do guião, passa a conversa a alguém da equipa, com o resumo do que já foi dito.</p>
              <ul class="tags"><li class="fade" style="--d:2">Passagem a uma pessoa</li><li class="fade" style="--d:3">Resumo da conversa</li><li class="fade" style="--d:4">Aviso à equipa</li></ul>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 03 como funciona (noite): diagnóstico, treino, publicação -->
      <section class="chapter" id="processo" data-name="Como funciona" data-beats="3" data-night="true" style="--beats:3">
        <div class="frame">
          <div class="layer pos-left m-high" data-in="0" data-out="0.3333">
            <div class="copy">
              <p class="eyebrow">Como funciona <span class="n">01 Diagnóstico</span></p>
              <h2 class="split">Começamos pelas <em>tuas conversas</em>.</h2>
              <p class="lede fade" style="--d:1">Vemos que perguntas recebes, a que horas chegam e onde perdes clientes. Sais com um plano claro, com ou sem a SENVIA.</p>
            </div>
          </div>
          <div class="layer pos-right m-low" data-in="0.3333" data-out="0.6667">
            <div class="copy">
              <p class="eyebrow">Como funciona <span class="n">02 Treino</span></p>
              <h2 class="split">Treinamos o assistente <em>com os teus dados</em>.</h2>
              <p class="lede fade" style="--d:1">Preços, horários, serviços e o tom da tua marca. Testamos as respostas contigo antes de publicar.</p>
            </div>
          </div>
          <div class="layer pos-left m-high" data-in="0.6667" data-out="1">
            <div class="copy">
              <p class="eyebrow">Como funciona <span class="n">03 Publicação</span></p>
              <h2 class="split">Publicamos e <em>acompanhamos</em>.</h2>
              <p class="lede fade" style="--d:1">Ligamos o assistente ao WhatsApp, ao site e ao email. Depois vemos as conversas contigo e afinamos as respostas.</p>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 04 começar -->
      <section class="chapter" id="comecar" data-name="Começar" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer pos-bottom m-low" data-in="0" data-out="1">
            <div class="copy">
              <p class="eyebrow">Próximo passo</p>
              <h2 class="split">Mostra-nos as perguntas que recebes. <em>Dizemos-te o que o assistente faz</em>.</h2>
              <p class="lede fade" style="--d:1">Numa conversa curta vemos os teus canais e sais com um plano concreto.</p>
              <div class="actions fade" style="--d:2">
                <a class="sbtn" href={demo} {...ext}>Pedir diagnóstico</a>
                <a class="sbtn sbtn-ghost" href="/senvia-os">Conhecer o Senvia OS</a>
              </div>
            </div>
          </div>
          <div class="wordmark" aria-hidden="true">SENVIA</div>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  // o texto pinta primeiro; o 3D (three.js, ~530 KB) só carrega depois da primeira pintura
  requestAnimationFrame(() => setTimeout(() => import('../scripts/chatbots-v2.js'), 0));
</script>

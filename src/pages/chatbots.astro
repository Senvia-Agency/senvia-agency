---
import Base from '../layouts/Base.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../config';

const chatbotTypes = [
  { icon: 'headphones', title: 'Atendimento ao Cliente', desc: 'Respostas instantâneas às perguntas mais frequentes. Reduz o tempo de espera e melhora a satisfação do cliente.', features: ['Respostas Instantâneas', 'Multi-Idioma', 'Escalação Inteligente', 'Histórico Completo'] },
  { icon: 'usercheck', title: 'Qualificação de Leads', desc: 'Identifica e qualifica potenciais clientes automaticamente, fazendo as perguntas certas no momento certo.', features: ['Perguntas Dinâmicas', 'Lead Scoring', 'Integração CRM', 'Notificações em Tempo Real'] },
  { icon: 'help', title: 'FAQ Inteligente', desc: 'Base de conhecimento alimentada por IA que aprende e evolui. Respostas contextuais e sempre atualizadas.', features: ['Aprendizagem Contínua', 'Respostas Contextuais', 'Auto-Atualização', 'Analytics Detalhado'] },
  { icon: 'cart', title: 'Assistente de Vendas', desc: 'Guia os clientes no processo de compra, recomenda produtos e fecha vendas — tudo de forma automatizada.', features: ['Recomendações IA', 'Upselling Automático', 'Checkout Assistido', 'Follow-up Inteligente'] },
];

const steps = [
  { step: '01', icon: 'search', title: 'Diagnóstico', desc: 'Analisamos os seus processos, canais de comunicação e necessidades para definir a estratégia ideal do chatbot.' },
  { step: '02', icon: 'settings', title: 'Configuração', desc: 'Desenhamos os fluxos de conversa, integrações com os seus sistemas e personalização da identidade do bot.' },
  { step: '03', icon: 'brain', title: 'Treino da IA', desc: 'Alimentamos o chatbot com dados do seu negócio, FAQs, catálogos e processos para respostas precisas e naturais.' },
  { step: '04', icon: 'rocket', title: 'Lançamento & Otimização', desc: 'Deploy nos seus canais (site, WhatsApp, redes sociais) com monitorização contínua e melhoria constante.' },
];

const differentials = [
  { icon: 'brain', title: 'IA Avançada', desc: 'Modelos de linguagem de última geração que compreendem contexto e respondem de forma natural e precisa.' },
  { icon: 'clock', title: 'Disponível 24/7', desc: 'O seu chatbot nunca dorme. Atendimento contínuo, sem pausas, fins de semana ou feriados.' },
  { icon: 'plug', title: 'Integração Total', desc: 'Conecta com os seus sistemas: CRM, ERP, e-commerce, calendários, email e muito mais.' },
  { icon: 'chart', title: 'Analytics em Tempo Real', desc: 'Dashboard completo com métricas de conversas, satisfação, conversões e oportunidades de melhoria.' },
  { icon: 'message', title: 'Respostas Naturais', desc: 'Conversas fluidas e humanas, sem respostas robóticas. O seu chatbot fala como a sua equipa.' },
  { icon: 'globe', title: 'Multicanal', desc: 'Um único chatbot presente no site, WhatsApp, Instagram, Facebook Messenger e mais canais.' },
];

const icons: Record<string, string> = {
  headphones: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>',
  usercheck: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>',
  help: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
  cart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>',
  search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  brain: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>',
  rocket: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  plug: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
  chart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
  message: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
};
---

<Base
  title="Chatbots com IA — Atendimento Inteligente 24/7"
  description="Chatbots com Inteligência Artificial que qualificam leads, respondem a clientes e automatizam processos — enquanto a sua equipa foca no que realmente importa."
  canonicalPath="/chatbots"
>
  <section class="hero aurora-bg" style="min-height: 85vh;">
    <div class="container">
      <div style="max-width: 48rem; margin-inline: auto; text-align: center;">
        <span class="badge mb-6" style="background: rgba(168, 85, 247, 0.1); border-color: rgba(168, 85, 247, 0.3); color: #c084fc;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>
          Chatbots & IA
        </span>

        <h1 class="hero__title">
          Atendimento Inteligente
          <br />
          <span class="gradient-text glow">24 Horas por Dia</span>
        </h1>

        <p class="hero__lead" style="margin-inline: auto;">
          Chatbots com Inteligência Artificial que qualificam leads, respondem a clientes e automatizam processos — enquanto a sua equipa foca no que realmente importa.
        </p>

        <div class="hero__actions" style="justify-content: center;">
          <a href={SITE.ctaFormUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg glow-pulse">
            Agendar Diagnóstico Gratuito
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge section-header__badge">Tipos de Chatbots</span>
        <h2>O chatbot certo para <span class="gradient-text">cada objetivo</span></h2>
        <p>Cada negócio tem necessidades únicas. Desenvolvemos chatbots especializados para o seu caso.</p>
      </div>

      <div class="service-grid">
        {chatbotTypes.map((type) => (
          <div class="service-card">
            <div class="service-card__icon" set:html={icons[type.icon]} />
            <h3>{type.title}</h3>
            <p class="service-card__desc">{type.desc}</p>
            <div class="service-card__features">
              {type.features.map((f) => <span class="service-card__feature">{f}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge section-header__badge">Como Trabalhamos</span>
        <h2>Do diagnóstico ao <span class="gradient-text">lançamento</span></h2>
        <p>Um processo estruturado em 4 fases para garantir um chatbot eficaz e alinhado ao seu negócio.</p>
      </div>

      <div class="process-grid">
        {steps.map((step) => (
          <div class="process-card">
            <span class="process-card__step">{step.step}</span>
            <div class="process-card__icon" set:html={icons[step.icon]} />
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-grid">
    <div class="container">
      <div class="section-header">
        <span class="badge section-header__badge">Porquê a SENVIA</span>
        <h2>O que nos <span class="gradient-text">diferencia</span></h2>
        <p>Não criamos chatbots genéricos. Desenvolvemos assistentes inteligentes treinados para o seu negócio.</p>
      </div>

      <div class="differential-grid" style="grid-template-columns: repeat(2, 1fr);">
        {differentials.map((item) => (
          <div class="differential-card" style="text-align: left;">
            <div class="differential-card__icon" style="margin: 0 0 1rem 0;">
              <div set:html={icons[item.icon]} />
            </div>
            <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">{item.title}</h3>
            <p style="font-size: 0.875rem;">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Pronto para automatizar o seu atendimento?"
    subtitle="Agende um diagnóstico gratuito. Vamos analisar os seus processos e mostrar como um chatbot com IA pode transformar o seu negócio."
    ctaText="Agendar Diagnóstico Gratuito"
    badge="Diagnóstico Gratuito"
  />
</Base>

<style>
  .differential-card .differential-card__icon svg { width: 1.5rem; height: 1.5rem; color: var(--senvia-500); }
  @media (min-width: 1024px) {
    .differential-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
</style>

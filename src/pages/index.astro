---
import Base from '../layouts/Base.astro';
import SitesNav from '../components/sites/SitesNav.astro';
import { SITE } from '../config';
import '../styles/home-v2.css';

/* ------------------------------------------------------------------
   Página inicial: sistemas à medida e sites, contados num mundo 3D.
   Cada capítulo é uma secção alta com um quadro sticky de 100vh; as camadas
   de texto entram conforme o progresso do scroll (data-in / data-out).
   O 3D e a coreografia vivem em src/scripts/home-v2.js; os estilos em
   src/styles/home-v2.css (tudo dentro de .sv2), no mesmo sistema da /sites.
------------------------------------------------------------------- */

const diagnostico = SITE.ctaFormUrl;
const ext = { target: '_blank', rel: 'noopener noreferrer' };

// o sistema em 3 momentos de 2 ideias; o texto muda de lado e o 3D vai para o oposto
const sistema = [
  {
    titulo: 'Tudo num <em>sítio só</em>.',
    pos: 'right',
    mobile: 'm-low',
    itens: [
      { title: 'Clientes e agenda', desc: 'Fichas, histórico e marcações da equipa, no lugar das folhas de Excel.' },
      { title: 'Os teus dados entram', desc: 'Importamos o que já tens, para não começares do zero.' },
    ],
  },
  {
    titulo: 'Trabalho que <em>se faz sozinho</em>.',
    pos: 'bottom',
    mobile: 'm-high',
    itens: [
      { title: 'Automações', desc: 'Lembretes, avisos e tarefas repetidas deixam de depender de alguém se lembrar.' },
      { title: 'WhatsApp, email e chat interno', desc: 'Mensagens aos clientes e a conversa da equipa, tudo dentro do sistema.' },
    ],
  },
  {
    titulo: 'Números <em>em tempo real</em>.',
    pos: 'left',
    mobile: 'm-low',
    itens: [
      { title: 'Faturação, stock e relatórios', desc: 'Sabes o que entrou, o que falta e o que vende, sem montar folhas.' },
      { title: 'Sem limite de utilizadores', desc: 'Licenças ilimitadas, servidor e backups, com manutenção desde 69€ por mês.' },
    ],
  },
];

// três formas de trabalhar connosco; cada uma tem um dispositivo no 3D (portátil, telemóvel, janela)
const servicos = [
  { key: 'sistema', kind: 'O nosso foco', name: 'Sistemas à medida', cta: 'Pedir diagnóstico', href: diagnostico, externo: true, tags: ['Desde 1.500€ + IVA', 'Utilizadores e licenças ilimitados', 'Manutenção desde 69€/mês'] },
  { key: 'sites', kind: 'Porta de entrada', name: 'Sites e lojas online', cta: 'Ver pacotes de sites', href: '/sites', externo: false, tags: ['Pacotes desde 280€ + IVA', 'Pronto em até 14 dias', 'WhatsApp e tracking incluídos'] },
  { key: 'os', kind: 'Produto próprio', name: 'Senvia OS', cta: 'Conhecer o Senvia OS', href: '/senvia-os', externo: false, tags: ['O nosso CRM Workplace', 'Clientes, pipeline e tarefas', 'Feito e mantido pela SENVIA'] },
];

// o processo, contado no capítulo noturno
const processo = [
  { k: 'Diagnóstico', pos: 'top', t: 'Primeiro, <em>percebemos o teu dia a dia</em>.', d: 'Vemos as folhas de Excel, os programas que pagas e onde se perde tempo. Sais com um caminho concreto.', fine: null as string | null },
  { k: 'Construção', pos: 'right', t: 'Construímos o sistema <em>à tua medida</em>.', d: 'Preço fechado antes de começar. Vais vendo o sistema crescer e validas cada parte.', fine: null },
  { k: 'Publicação', pos: 'left', t: 'Os teus dados passam para o sistema.', d: 'Importamos o que já tens em Excel, criamos os acessos da equipa e pomos tudo no ar.', fine: null },
  { k: 'Manutenção', pos: 'top', t: 'Depois, <em>desde 69€ por mês</em>.', d: 'Servidor, backups, segurança e o sistema a funcionar. Utilizadores e licenças ilimitados, por mais gente que entre na equipa.', fine: 'Novas funcionalidades são orçamentadas à parte, só quando as pedires.' },
];

// as cinco avaliações da ficha "Senvia Agency" no Google, tal como estão publicadas
const avaliacoes = [
  { nome: 'max henrique', texto: 'O Thiago me atendeu super bem e foi muito atencioso. Realizou tudo o que eu precisava para o meu site com eficiência e cuidado. Recomendo!' },
  { nome: 'Tiago Pereira', texto: 'Recomendo vivamente! Super profissional, disponível e honesto. Preço/qualidade fantástico. Super satisfeito! Muito obrigado pelo trabalho desenvolvido!' },
  { nome: 'Andreia Silva da Costa', texto: 'Excelência. Competência e comprometimento. Descrevem minha experiência com a equipe da Senvia.' },
  { nome: 'Cristina Sousa', texto: 'Excelente serviço. Disponibilidade, empenho, dedicação. Super recomendo!' },
  { nome: 'João Basilio', texto: 'Excelentes profissionais!' },
];

const pad = (n: number) => String(n).padStart(2, '0');
// janela de progresso do capítulo em que cada camada de texto está visível
const win = (i: number, n: number) => ({ 'data-in': (i / n).toFixed(4), 'data-out': ((i + 1) / n).toFixed(4) });
---

<Base
  title="Sistemas à medida e sites em Portugal"
  description="Sistemas à medida e sites para empresas em Portugal. Sai do Excel e das licenças caras com um sistema próprio, desde 1.500€ + IVA. Sites desde 280€ + IVA."
>
  <SitesNav slot="header" cta="Pedir diagnóstico" ctaHref={diagnostico} />
  <!-- Marca o suporte a JS antes de pintar: as camadas de texto ficam escondidas até o scroll as mostrar -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="preload" href="/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/general-sans-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&display=swap" />

  <div class="sv2" id="sv2">
    <canvas id="world" aria-hidden="true"></canvas>
    <canvas id="fg" aria-hidden="true"></canvas>

    <div class="tip" id="tip" aria-hidden="true"><b></b><span></span></div>

    <nav class="hud" aria-label="Capítulos da página">
      <b id="hud-n" aria-hidden="true">01</b><span id="hud-name" aria-hidden="true">Início</span><span class="track" aria-hidden="true"><i id="hud-bar"></i></span><span class="dots" id="hud-dots"></span>
    </nav>

    <div class="chapters">
      <!-- 00 início: os dois serviços; depois o Excel vira-se no sistema -->
      <section class="chapter" id="inicio" data-name="Início" data-beats="2" style="--beats:2">
        <div class="frame">
          <div class="layer pos-center m-low m-hero" data-in="0" data-out="0.5">
            <div class="copy">
              <p class="eyebrow">Software house · Portugal</p>
              <h1 class="split">Sistemas e sites, <em>feitos à medida</em>.</h1>
              <p class="lede fade" style="--d:1">Um sistema que tira a tua empresa do Excel e das licenças caras. Um site que transforma visitas em pedidos.</p>
              <!-- as duas portas: cada serviço com o seu argumento e o seu caminho -->
              <div class="doors fade" style="--d:2">
                <a class="door" href="/softwares"><b>Sistemas à medida</b><span>Desde 1.500€ + IVA. Depois, desde 69€ por mês.</span><i>Ver sistemas</i></a>
                <a class="door" href="/sites"><b>Sites e lojas online</b><span>Desde 280€ + IVA, prontos em 14 dias.</span><i>Ver pacotes</i></a>
              </div>
            </div>
          </div>
          <div class="layer pos-left m-high" data-in="0.5" data-out="1">
            <div class="copy">
              <p class="eyebrow">Do caos a um sistema</p>
              <h2 class="split">Excel, papéis e apps soltas, <em>num só sítio</em>.</h2>
              <ul class="facts">
                <li class="fade" style="--d:1"><b data-count="1">1</b><span>sistema em vez de várias apps</span></li>
                <li class="fade" style="--d:2"><b data-count="69" data-suffix="€">69€</b><span>desde, por mês de manutenção</span></li>
                <li class="fade" style="--d:3"><b data-count="0" data-suffix="€">0€</b><span>em licenças: utilizadores ilimitados</span></li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 01 a conta: faturas de licenças contra o recibo de 69€, ano a ano -->
      <section class="chapter" id="conta" data-name="A conta" data-beats="2" style="--beats:2">
        <div class="frame">
          <div class="layer pos-left m-high m-calc" data-in="0" data-out="1">
            <div class="copy">
              <p class="eyebrow">A conta das licenças</p>
              <h2 class="split">Com um sistema próprio, <em>não pagas licenças</em>.</h2>
              <div class="calc fade" style="--d:1">
                <label><span>Pessoas a usar</span><output id="c-n">8</output><input type="range" id="c-users" min="1" max="40" value="8" aria-label="Pessoas a usar" /></label>
                <label><span>Licenças por pessoa, por mês</span><output id="c-p">35€</output><input type="range" id="c-price" min="10" max="120" step="5" value="35" aria-label="Licenças por pessoa, por mês" /></label>
                <div class="calc-out">
                  <div><small>Em licenças, ao fim de <b id="c-y">1 ano</b></small><strong id="c-lic">3.360€</strong></div>
                  <div class="us"><small>Na SENVIA, no mesmo tempo</small><strong id="c-us">828€</strong><em>+ a construção (desde 1.500€ + IVA), paga uma vez</em></div>
                </div>
              </div>
              <p class="fine fade" style="--d:2">Exemplo ilustrativo: muda os valores para os da tua empresa.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 o sistema: monta-se dentro da janela com o scroll -->
      <section class="chapter" id="sistema" data-name="O sistema" data-beats="3" style="--beats:3">
        <div class="frame">
          {sistema.map((g, i) => (
            <div class={`layer pos-${g.pos} ${g.mobile}`} {...win(i, sistema.length)}>
              <div class="copy">
                <p class="eyebrow">O teu sistema <span class="n">{i + 1} de 3</span></p>
                <h2 class="split" set:html={g.titulo} />
                <div class="pairs">
                  {g.itens.map((it, j) => (
                    <div class="pair fade" style={`--d:${j + 1}`}><h3>{it.title}</h3><p>{it.desc}</p></div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 03 serviços: um dispositivo por serviço (sistema, sites, Senvia OS) -->
      <section class="chapter" id="servicos" data-name="Serviços" data-beats={servicos.length} style={`--beats:${servicos.length}`}>
        <div class="frame">
          {servicos.map((w, i) => (
            <div class={`layer pos-${i % 2 ? 'right' : 'left'} work ${i % 2 ? 'm-high' : 'm-low'}`} data-key={w.key} {...win(i, servicos.length)}>
              <div class="copy">
                <p class="eyebrow">Como trabalhar connosco <span class="n">{i + 1} de {servicos.length}</span></p>
                <span class="kind fade" style="--d:0">{w.kind}</span>
                <h2 class="split">{w.name}</h2>
                <ul class="tags">
                  {w.tags.map((t, k) => <li class="fade" style={`--d:${k + 1}`}>{t}</li>)}
                </ul>
                <a class="link fade" style="--d:4" href={w.href} {...(w.externo ? ext : {})}>{w.cta}</a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 04 processo (noite): diagnóstico, construção, publicação, manutenção -->
      <section class="chapter" id="processo" data-name="Processo" data-beats={processo.length} data-night="true" style={`--beats:${processo.length}`}>
        <div class="frame">
          {processo.map((v, i) => (
            <div class={`layer pos-${v.pos} m-high`} {...win(i, processo.length)}>
              <div class="copy">
                <p class="eyebrow">Como funciona <span class="n">{pad(i + 1)} {v.k}</span></p>
                <h2 class="split" set:html={v.t} />
                <p class="lede fade" style="--d:1">{v.d}</p>
                {v.fine && <p class="fine fade" style="--d:2">{v.fine}</p>}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 05 custos: o que pagas, sem surpresas -->
      <section class="chapter" id="custos" data-name="Custos" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer layer-plans pos-center" data-in="0" data-out="1">
            <div class="copy wide">
              <p class="eyebrow">Custos</p>
              <h2 class="split">O que pagas, <em>sem surpresas</em>.</h2>
              <div class="plans">
                <article class="plan fade" style="--d:1">
                  <span class="pn">Construção</span>
                  <span class="pp"><small class="from">desde</small><span data-count="1500" data-suffix="€">1.500€</span><small>+ IVA</small></span>
                  <ul><li>Utilizadores e licenças ilimitados</li><li>Automações</li><li>WhatsApp e cliente de email</li><li>Mensagens internas da equipa</li></ul>
                  <a class="sbtn sbtn-ghost sbtn-sm" href={diagnostico} {...ext}>Pedir diagnóstico</a>
                </article>
                <article class="plan rec fade" style="--d:2">
                  <div class="sbadges"><span class="sbadge">Único custo fixo</span></div>
                  <span class="pn">Servidor e manutenção</span>
                  <span class="pp"><small class="from">desde</small><span data-count="69" data-suffix="€">69€</span><small>/mês</small></span>
                  <ul><li>Servidor e alojamento</li><li>Backups e segurança</li><li>Atualizações técnicas</li><li>Sem custo por utilizador</li></ul>
                  <a class="sbtn sbtn-sm" href={diagnostico} {...ext}>Quero o meu sistema</a>
                </article>
                <article class="plan fade" style="--d:3">
                  <span class="pn">Evoluções</span>
                  <span class="pp pp-txt">Só se quiseres</span>
                  <ul><li>Novas funcionalidades</li><li>Ligações a outros programas</li><li>Orçamentadas à parte</li><li>Sem obrigação de pedir</li></ul>
                  <a class="sbtn sbtn-ghost sbtn-sm" href={diagnostico} {...ext}>Falar connosco</a>
                </article>
              </div>
              <div class="plan-dots" aria-hidden="true"><i></i><i class="on"></i><i></i></div>
              <p class="fine fade" style="--d:4">Pagas a construção uma vez, desde 1.500€ + IVA, e o sistema fica só para a tua empresa. Depois, o único custo fixo é a manutenção, desde 69€ por mês.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 06 avaliações reais do Google (Senvia Agency, Leiria) -->
      <section class="chapter" id="avaliacoes" data-name="Avaliações" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer layer-plans pos-bottom m-high" data-in="0" data-out="1">
            <div class="copy wide">
              <p class="eyebrow">Avaliações Google</p>
              <h2 class="split">5,0 no Google. <em>Cinco estrelas</em> em todas.</h2>
              <div class="reviews">
                {avaliacoes.map((a, k) => (
                  <figure class="review fade" style={`--d:${k + 1}`}><span class="stars" aria-label="5 de 5 estrelas">★★★★★</span><blockquote>{a.texto}</blockquote><figcaption>{a.nome}</figcaption></figure>
                ))}
              </div>
              <a class="link fade" style="--d:6" href="https://www.google.com/search?q=Senvia+Agency+Leiria" {...ext}>Ver as avaliações no Google</a>
            </div>
          </div>
        </div>
      </section>

      <!-- 07 contacto (id "contactos": é para aqui que levam a navbar e o rodapé) -->
      <section class="chapter" id="contactos" data-name="Contacto" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer pos-bottom m-low" data-in="0" data-out="1">
            <div class="copy">
              <p class="eyebrow">Próximo passo</p>
              <h2 class="split">Mostra-nos o teu Excel. <em>Dizemos-te o que dá para fazer</em>.</h2>
              <p class="lede fade" style="--d:1">Numa conversa curta vemos como trabalhas hoje e sais com um caminho concreto, com ou sem a SENVIA.</p>
              <div class="actions fade" style="--d:2">
                <a class="sbtn" href={diagnostico} {...ext}>Pedir diagnóstico</a>
                <a class="sbtn sbtn-ghost" href="/sites">Ver sites</a>
              </div>
            </div>
          </div>
          <div class="wordmark" aria-hidden="true">SENVIA</div>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import '../scripts/home-v2.js';
</script>

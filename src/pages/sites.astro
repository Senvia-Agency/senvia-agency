---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, whatsappUrl } from '../config';
import SitesNav from '../components/sites/SitesNav.astro';
import '../styles/sites-v2.css';

import longevStudio from '../assets/projetos/longev-studio.png';
import deltaCapital from '../assets/projetos/delta-capital.png';
import miraWay from '../assets/projetos/mira-way.png';
import draCristinaSousa from '../assets/projetos/dra-cristina-sousa.png';
import estudioTiagoPereira from '../assets/projetos/estudio-tiago-pereira.png';
import rdExcursoes from '../assets/projetos/rd-excursoes.png';
import clinicaRenascer from '../assets/projetos/clinica-renascer.png';

/* ------------------------------------------------------------------
   Página /sites: um mundo 3D fixo atrás da página, contado em capítulos.
   Cada capítulo é uma secção alta com um quadro sticky de 100vh; as camadas
   de texto entram conforme o progresso do scroll (data-in / data-out).
   O 3D e a coreografia vivem em src/scripts/sites-v2.js; os estilos em
   src/styles/sites-v2.css (tudo dentro de .sv2).
------------------------------------------------------------------- */

/* ------------------------------------------------------------------
   Contactos
------------------------------------------------------------------- */
const briefingUrl = SITE.ctaSiteFormUrl;
// Se o número de WhatsApp ainda não estiver configurado em src/config.ts,
// os CTAs de WhatsApp caem no formulário, e nada quebra.
const whatsapp = whatsappUrl('Olá! Queria um diagnóstico rápido para o site do meu negócio.');
const diagnosticoUrl = whatsapp ?? briefingUrl;
const pacoteUrl = (slug: string) => `${briefingUrl}?pacote=${slug}`;
const ext = { target: '_blank', rel: 'noopener noreferrer' };

/* ------------------------------------------------------------------
   Conteúdo
------------------------------------------------------------------- */
// os 6 pontos da solução em 3 momentos de 2; o texto muda de lado e o 3D vai para o oposto
const solucao = [
  {
    titulo: 'Clara e <em>profissional</em>.',
    pos: 'right',
    mobile: 'm-low',
    itens: [
      { title: 'Oferta clara', desc: 'Organizamos o que vendes, para quem e por que motivo te devem escolher.' },
      { title: 'Design profissional', desc: 'Layout limpo, legível e coerente com a tua marca, em desktop e telemóvel.' },
    ],
  },
  {
    titulo: 'Contactos <em>com contexto</em>.',
    pos: 'bottom',
    mobile: 'm-high',
    itens: [
      { title: 'Contacto por WhatsApp ou formulário', desc: 'A mensagem já chega com contexto: serviço, nome e o que a pessoa precisa.' },
      { title: 'Tracking de leads e cliques', desc: 'Para saberes de onde vêm os pedidos, e não andares a adivinhar.' },
    ],
  },
  {
    titulo: 'Encontrado e <em>sempre no ar</em>.',
    pos: 'left',
    mobile: 'm-low',
    itens: [
      { title: 'SEO básico', desc: 'Títulos, descrições, estrutura e velocidade tratados desde o primeiro dia.' },
      { title: 'Publicação e manutenção', desc: 'Domínio, alojamento, SSL e o site a funcionar depois de publicado.' },
    ],
  },
];

/* Classificação por estrutura, não por opinião: Website = tem páginas
   próprias no menu (/sobre, /contactos, ...); Landing page = tudo numa
   única página, com âncoras ou sem menu de navegação. */
const trabalhos = [
  { key: 'dra-cristina-sousa', img: draCristinaSousa, nome: 'Dra. Cristina Sousa', tipo: 'Website', href: 'https://dracristinasousa.com/', url: 'dracristinasousa.com', detalhes: ['Menu com 6 secções', 'E-book de vendas', 'Antes/depois e feedbacks'] },
  { key: 'longev-studio', img: longevStudio, nome: 'Longev Studio', tipo: 'Website', href: 'https://longevstudio.com/', url: 'longevstudio.com', detalhes: ['Menu multi-página', 'Agendamento de avaliação', 'Versão PT/EN'] },
  { key: 'estudio-tiago-pereira', img: estudioTiagoPereira, nome: 'Estúdio Tiago Pereira', tipo: 'Website', href: 'https://estudiotiagopereira.pt/', url: 'estudiotiagopereira.pt', detalhes: ['Programas e e-books', 'Área de login', 'Prova social em números'] },
  { key: 'clinica-renascer', img: clinicaRenascer, nome: 'Clínica Renascer', tipo: 'Landing page', href: 'https://clinicarenascer.pt/', url: 'clinicarenascer.pt', detalhes: ['Telefone direto no topo', 'Agendamento de avaliação', 'Botão de WhatsApp'] },
  { key: 'mira-way', img: miraWay, nome: 'Mira Way', tipo: 'Landing page', href: 'https://miraway.senvia.pt/', url: 'miraway.senvia.pt', detalhes: ['Registo em sessão', 'WhatsApp flutuante', 'Prova de escassez'] },
  { key: 'rd-excursoes', img: rdExcursoes, nome: 'RD Excursões', tipo: 'Landing page', href: 'https://rdexcursoes.senvia.pt/', url: 'rdexcursoes.senvia.pt', detalhes: ['Filtro de viagens por mês', 'Catálogo de excursões', 'CTAs de reserva'] },
  { key: 'delta-capital', img: deltaCapital, nome: 'Delta Capital', tipo: 'Landing page', href: 'https://deltacapital.pt/', url: 'deltacapital.pt', detalhes: ['Simulador de crédito', 'WhatsApp no topo', 'Selo Banco de Portugal'] },
];
// os ecrãs 3D usam as capturas em webp, já otimizadas pelo Astro
const imgs = Object.fromEntries(
  await Promise.all(trabalhos.map(async (t) => [t.key, (await getImage({ src: t.img, format: 'webp', width: 1600 })).src])),
);

const validacao = [
  { k: 'Anúncio', pos: 'top', t: 'Mais do que um site: um <em>teste comercial</em> com dados.', d: 'Ativamos 3 criativos com 100€ de investimento incluído e um público configurado para o teu negócio.', fine: null as string | null },
  { k: 'Página', pos: 'right', t: 'As visitas aterram numa página feita para converter.', d: 'Site de 3 a 12 páginas, pronto em 14 dias, com tracking de cliques e formulários.', fine: null },
  { k: 'WhatsApp', pos: 'left', t: 'O contacto chega <em>com contexto</em>.', d: 'Serviço, nome e o que a pessoa precisa, direto na tua conversa de WhatsApp.', fine: null },
  { k: 'Relatório', pos: 'top', t: 'No fim, um relatório e uma decisão.', d: 'Alcance, cliques, CTR, custo por contacto e o melhor criativo. A recomendação é uma de quatro: matar, ajustar, continuar ou escalar.', fine: '*Estimativa potencial de até 30.000 visualizações e 300 visitas. Resultados variam conforme nicho, verba, público, criativos e procura do mercado.' },
];

const pacotes = [
  {
    slug: 'presenca',
    nome: 'Presença',
    preco: 280,
    antes: null as number | null,
    desc: 'Para negócios que precisam sair do improviso e ter uma página profissional no ar.',
    inclui: ['1 landing page ou site simples', 'WhatsApp com mensagem organizada', 'Formulário simples e SEO básico', 'Publicação e 1 revisão'],
    cta: 'Começar com Presença',
    destaque: false,
  },
  {
    slug: 'validacao-comercial',
    nome: 'Validação Comercial',
    preco: 490,
    antes: 650,
    desc: 'Para negócios que querem site, captação e um teste comercial real com anúncios.',
    inclui: ['Site de 3 a 12 páginas, pronto em 14 dias', '14 dias de Meta Ads com 100€ incluídos', '3 criativos e público configurado', 'Tracking e relatório detalhado'],
    cta: 'Validar o meu negócio',
    destaque: true,
  },
  {
    slug: 'loja-online',
    nome: 'Loja Online',
    preco: 1190,
    antes: null,
    desc: 'Para negócios que querem vender produtos online com uma loja profissional e pronta para gestão.',
    inclui: ['Loja responsiva com design próprio', 'Páginas de produto, carrinho e checkout', 'Pagamentos e envios configurados', 'Formação para gerir a loja'],
    cta: 'Criar loja online',
    destaque: false,
  },
];

const manutencao = [
  {
    nome: 'Manutenção Básica',
    mes: '29€',
    ano: '290€/ano',
    para: 'Obrigatória em qualquer website.',
    itens: ['Alojamento', 'SSL', 'Backups', 'Atualizações técnicas', 'Monitorização básica', 'Pequenas correções técnicas', 'Site online e funcional'],
  },
  {
    nome: 'Manutenção Pro',
    mes: '49€',
    ano: '490€/ano',
    para: 'Para quem quer o site a mexer todos os meses.',
    itens: ['Tudo da Básica', 'Até 1 alteração simples por mês', 'Revisão mensal de formulário/links', 'Relatório simples de visitas/leads', 'Suporte prioritário'],
  },
  {
    nome: 'Manutenção Loja Online',
    mes: '79€',
    ano: '790€/ano',
    para: 'Obrigatória em lojas online.',
    itens: ['Alojamento', 'SSL', 'Backups', 'Atualizações técnicas', 'Segurança', 'Verificação de checkout', 'Suporte técnico', 'Pequenas correções', 'Monitorização de erros críticos'],
  },
];

const processo = [
  { label: 'Preenches o briefing' },
  { label: 'Validamos o melhor caminho' },
  { label: 'Pagas o sinal' },
  { label: 'Criamos o site' },
  { label: 'Revês' },
  { label: 'Publicamos' },
  { label: 'Se for Validação, ativamos os anúncios', condicional: true },
];

const faqs = [
  { q: 'O domínio está incluído?', a: 'Sim. Todos os pacotes incluem 1 ano de domínio gratuito como oferta especial, sujeito à disponibilidade do nome.' },
  { q: 'Tenho de pagar manutenção?', a: 'Sim. Websites exigem no mínimo Manutenção Básica para alojamento, segurança, backups e funcionamento técnico. Loja Online exige Manutenção Loja Online.' },
  { q: 'O investimento em anúncios está incluído?', a: 'No Pacote Validação Comercial, sim: estão incluídos 100€ de investimento para Meta Ads.' },
  { q: 'Em quanto tempo fica pronto?', a: 'O Pacote Validação Comercial fica pronto em até 14 dias, dependendo da entrega de materiais e validações.' },
  { q: 'O Pacote Presença também tem anúncios?', a: 'Não. O Pacote Presença é uma página/site simples de entrada. Para anúncios, tracking e relatório comercial, o pacote certo é o Validação Comercial.' },
  { q: 'Posso pedir alterações?', a: 'Sim. O Pacote Presença inclui 1 revisão. Alterações adicionais ou acompanhamento contínuo podem entrar na manutenção ou ser orçamentados à parte.' },
];

/* ------------------------------------------------------------------
   SEO
------------------------------------------------------------------- */
const pageTitle = 'Criação de Sites Profissionais em Portugal';
const pageDescription =
  'Sites, landing pages e lojas online com preço fechado, captação por WhatsApp/formulário, SEO básico, tracking e manutenção. Pacotes desde 280€ + IVA.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Criação de sites, landing pages e lojas online',
    serviceType: 'Desenvolvimento de websites',
    provider: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Leiria', addressCountry: 'PT' },
    },
    areaServed: { '@type': 'Country', name: 'Portugal' },
    description: pageDescription,
    url: new URL('/sites', SITE.url).toString(),
    offers: pacotes.map((p) => ({
      '@type': 'Offer',
      name: `Pacote ${p.nome}`,
      description: p.desc,
      // Os preços da página são sem IVA, declarado explicitamente.
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: String(p.preco),
        priceCurrency: 'EUR',
        valueAddedTaxIncluded: false,
      },
      url: new URL('/sites#pacotes', SITE.url).toString(),
      availability: 'https://schema.org/InStock',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
// janela de progresso do capítulo em que cada camada de texto está visível
const win = (i: number, n: number) => ({ 'data-in': (i / n).toFixed(4), 'data-out': ((i + 1) / n).toFixed(4) });
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/sites"
  image="/images/og-sites.jpg"
  jsonLd={jsonLd}
>
  <!-- Marca o suporte a JS antes de pintar: as camadas de texto ficam escondidas até o scroll as mostrar -->
  <SitesNav slot="header" cta="Pedir diagnóstico" ctaHref={diagnosticoUrl} />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="preload" href="/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/general-sans-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&display=swap" />

  <div class="sv2" id="sv2" data-imgs={JSON.stringify(imgs)}>
    <canvas id="world" aria-hidden="true"></canvas>
    <canvas id="fg" aria-hidden="true"></canvas>

    <div class="tip" id="tip" aria-hidden="true"><b></b><span></span></div>

    <nav class="hud" aria-label="Capítulos da página">
      <b id="hud-n" aria-hidden="true">01</b><span id="hud-name" aria-hidden="true">Início</span><span class="track" aria-hidden="true"><i id="hud-bar"></i></span><span class="dots" id="hud-dots"></span>
    </nav>

    <div class="chapters">
      <!-- 00 início -->
      <section class="chapter" id="inicio" data-name="Início" data-beats="2" style="--beats:2">
        <div class="frame">
          <div class="layer pos-center" data-in="0" data-out="0.5">
            <div class="copy">
              <p class="eyebrow">Criação de sites · Portugal</p>
              <h1 class="split">Sites que transformam visitantes em <em>pedidos</em>.</h1>
              <p class="lede fade" style="--d:1">Páginas, sites e lojas online para negócios que precisam de parecer profissionais, explicar bem a oferta e receber contactos pelo WhatsApp ou formulário.</p>
              <div class="actions fade" style="--d:2">
                <a class="sbtn" href="#pacotes" data-go="5">Ver pacotes</a>
                <a class="sbtn sbtn-ghost" href={diagnosticoUrl} {...ext}>Pedir diagnóstico</a>
              </div>
            </div>
          </div>
          <div class="layer pos-center m-high" data-in="0.5" data-out="1">
            <div class="copy">
              <p class="eyebrow">Feito para o teu negócio</p>
              <h2 class="split">Preço fechado, prazo curto e <em>um objetivo</em>.</h2>
              <ul class="facts">
                <li class="fade" style="--d:1"><b data-count="280" data-suffix="€">280€</b><span>desde, + IVA</span></li>
                <li class="fade" style="--d:2"><b data-count="14">14</b><span>dias até estar no ar</span></li>
                <li class="fade" style="--d:3"><b data-count="1">1</b><span>botão que leva a falar contigo</span></li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 01 problema -->
      <section class="chapter" id="problema" data-name="Problema" data-beats="3" style="--beats:3">
        <div class="frame">
          <div class="layer pos-center" data-in="0" data-out="0.3333">
            <div class="copy">
              <p class="eyebrow">O problema</p>
              <h2 class="split">O teu negócio não precisa de <em>mais um site</em>.</h2>
              <p class="lede fade" style="--d:1">Precisa de uma página que explique, organize e gere contactos. Um site bonito não chega: se a pessoa entra, não entende a oferta e não sabe o que fazer a seguir, o site falhou.</p>
            </div>
          </div>
          <!-- três frases que entram uma de cada vez com o scroll; a cada uma, um losango perde a cor e cai -->
          <div class="layer pos-center" data-in="0.3333" data-out="1">
            <div class="copy">
              <p class="eyebrow">Soa familiar?</p>
              <p class="lines">
                <span class="bl" data-at="0.04">Perfil <em>sem confiança</em>.</span>
                <span class="bl" data-at="0.34">Mensagens <em>sem contexto</em>.</span>
                <span class="bl" data-at="0.64">Clientes que <em class="gone">desaparecem</em>.</span>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 solução: as peças montam um site dentro da janela de browser -->
      <section class="chapter" id="solucao" data-name="Solução" data-beats="3" style="--beats:3">
        <div class="frame">
          {solucao.map((g, i) => (
            <div class={`layer pos-${g.pos} ${g.mobile}`} {...win(i, solucao.length)}>
              <div class="copy">
                <p class="eyebrow">O que o teu site precisa ter <span class="n">{i + 1} de 3</span></p>
                <h2 class="split" set:html={g.titulo} />
                <div class="pairs">
                  {g.itens.map((it, j) => (
                    <div class="pair fade" style={`--d:${j + 1}`}><h3>{it.title}</h3><p>{it.desc}</p></div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 03 trabalho: um ecrã 3D por projeto, num corredor -->
      <section class="chapter" id="trabalho" data-name="Trabalho" data-beats={trabalhos.length} style={`--beats:${trabalhos.length}`}>
        <div class="frame">
          {trabalhos.map((w, i) => (
            <div class={`layer pos-${i % 2 ? 'right' : 'left'} work ${i % 2 ? 'm-high' : 'm-low'}`} data-key={w.key} data-dom={w.url} {...win(i, trabalhos.length)}>
              <div class="copy">
                <p class="eyebrow">Trabalho real <span class="n">{pad(i + 1)} de {pad(trabalhos.length)}</span></p>
                <span class="kind fade" style="--d:0">{w.tipo}</span>
                <h2 class="split">{w.nome}</h2>
                <ul class="tags">
                  {w.detalhes.map((t, k) => <li class="fade" style={`--d:${k + 1}`}>{t}</li>)}
                </ul>
                <a class="link fade" style="--d:4" href={w.href} {...ext}>Ver {w.url}</a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 04 validação (noite): o percurso anúncio, página, WhatsApp e relatório -->
      <section class="chapter" id="validacao" data-name="Validação" data-beats={validacao.length} data-night="true" style={`--beats:${validacao.length}`}>
        <div class="frame">
          {validacao.map((v, i) => (
            <div class={`layer pos-${v.pos} m-high`} {...win(i, validacao.length)}>
              <div class="copy">
                <p class="eyebrow">Validação Comercial · 490€ <span class="n">{pad(i + 1)} {v.k}</span></p>
                <h2 class="split" set:html={v.t} />
                <p class="lede fade" style="--d:1">{v.d}</p>
                {v.fine && <p class="fine fade" style="--d:2">{v.fine}</p>}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 05 pacotes -->
      <section class="chapter" id="pacotes" data-name="Pacotes" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer layer-plans pos-center" data-in="0" data-out="1">
            <div class="copy wide">
              <p class="eyebrow">Pacotes</p>
              <h2 class="split">Preço fechado e escopo claro.</h2>
              <div class="plans">
                {pacotes.map((p, k) => (
                  <article class={`plan fade${p.destaque ? ' rec' : ''}`} style={`--d:${k + 1}`}>
                    {p.destaque && (
                      <div class="sbadges">
                        <span class="sbadge">Recomendado</span>
                        {p.antes && <span class="sbadge off">Poupas {p.antes - p.preco}€</span>}
                      </div>
                    )}
                    <span class="pn">{p.nome}</span>
                    <span class="pp">
                      <span data-count={p.preco} data-suffix="€">{p.preco}€</span>
                      {p.antes && <s><span class="sr">antes </span>{p.antes}€</s>}
                      <small>+ IVA</small>
                    </span>
                    <ul>{p.inclui.map((i) => <li>{i}</li>)}</ul>
                    <a class={`sbtn sbtn-sm${p.destaque ? '' : ' sbtn-ghost'}`} href={pacoteUrl(p.slug)} {...ext}>{p.cta}</a>
                  </article>
                ))}
              </div>
              <div class="plan-dots" aria-hidden="true"><i></i><i class="on"></i><i></i></div>
              <p class="fine fade" style="--d:4">Todos os sites exigem manutenção, desde 29€/mês + IVA (<a href="#manutencao">ver planos</a>). Todos os pacotes incluem 1 ano de domínio, sujeito à disponibilidade do nome.</p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- detalhes: secções normais, por cima do mundo 3D -->
    <section class="info" aria-label="Manutenção, processo e perguntas frequentes">
      <div class="info-in">
        <div class="info-block" id="manutencao">
          <p class="eyebrow">Manutenção</p>
          <h2 class="split">Depois de publicar, o site continua <em>seguro e no ar</em>.</h2>
          <p class="lede fade" style="--d:1">Todos os websites exigem manutenção para garantir alojamento, segurança, backups e suporte técnico desde o lançamento.</p>
          <div class="care">
            {manutencao.map((m, k) => (
              <article class="fade" style={`--d:${k + 2}`}>
                <h3>{m.nome}</h3>
                <p class="cp">{m.mes}<small>/mês + IVA</small></p>
                <p class="cy">ou {m.ano} + IVA</p>
                <p class="for">{m.para}</p>
                <ul>{m.itens.map((i) => <li>{i}</li>)}</ul>
              </article>
            ))}
          </div>
          <p class="rule fade" style="--d:5"><strong>Regra simples, sem letra pequena:</strong> websites exigem no mínimo Manutenção Básica. Loja Online exige Manutenção Loja Online. A manutenção é proteção do que pagaste, não uma taxa escondida.</p>
        </div>

        <div class="info-block" id="processo">
          <p class="eyebrow">Como funciona</p>
          <h2 class="split">Do briefing ao site no ar, <em>sem arrastar</em>.</h2>
          <p class="lede fade" style="--d:1">Um processo simples para tirar o site do papel sem decisões a arrastar durante meses.</p>
          <ol class="steps">
            {processo.map((s, k) => (
              <li class={`fade${s.condicional ? ' cond' : ''}`} style={`--d:${k + 2}`}><b>{pad(k + 1)}</b><span>{s.label}</span></li>
            ))}
          </ol>
        </div>

        <div class="info-block faq" id="faq">
          <div class="faq-aside">
            <p class="eyebrow">Perguntas frequentes</p>
            <h2 class="split">As perguntas que nos fazem <em>sempre</em>.</h2>
            <p class="lede fade" style="--d:1">Se ficar alguma dúvida de fora, escreve-nos. Respondemos sem rodeios.</p>
            <a class="link fade" style="--d:2" href={diagnosticoUrl} {...ext}>Pedir diagnóstico rápido</a>
          </div>
          <div class="faqs fade" style="--d:2">
            {faqs.map((f) => (
              <details>
                <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="chapters">
      <!-- 06 contacto: as peças montam a marca -->
      <section class="chapter" id="contacto" data-name="Contacto" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer pos-bottom m-low" data-in="0" data-out="1">
            <div class="copy">
              <p class="eyebrow">Próximo passo</p>
              <h2 class="split">Decide isto numa conversa de <em>10 minutos</em>.</h2>
              <p class="lede fade" style="--d:1">Pede um diagnóstico rápido e sai com um caminho concreto, ou avança já para o pacote que faz sentido.</p>
              <div class="actions fade" style="--d:2">
                <a class="sbtn" href={diagnosticoUrl} {...ext}>Pedir diagnóstico rápido</a>
                <a class="sbtn sbtn-ghost" href="#pacotes" data-go="5">Ver pacotes</a>
              </div>
            </div>
          </div>
          <div class="wordmark" aria-hidden="true">SENVIA</div>
        </div>
      </section>
    </div>
  </div>
</Base>


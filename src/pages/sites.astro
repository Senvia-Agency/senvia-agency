---
import fs from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BrowserFrame from '../components/sites/BrowserFrame.astro';
import CinematicHero from '../components/sites/CinematicHero.astro';
import { SITE, whatsappUrl } from '../config';

import longevStudio from '../assets/projetos/longev-studio.png';
import deltaCapital from '../assets/projetos/delta-capital.png';
import miraWay from '../assets/projetos/mira-way.png';
import draCristinaSousa from '../assets/projetos/dra-cristina-sousa.png';
import estudioTiagoPereira from '../assets/projetos/estudio-tiago-pereira.png';
import rdExcursoes from '../assets/projetos/rd-excursoes.png';
import clinicaRenascer from '../assets/projetos/clinica-renascer.png';

/* ------------------------------------------------------------------
   Vídeo da hero
   Caminho esperado: public/videos/sites-hero.mp4
   A existência é verificada em build-time: se o ficheiro estiver lá, a
   hero usa vídeo (com poster); se não, usa o screenshot real como imagem.
   Ver public/videos/README.md.
------------------------------------------------------------------- */
const HERO_VIDEO_SRC = '/videos/sites-hero.mp4';
const hasHeroVideo = fs.existsSync(path.join(process.cwd(), 'public', 'videos', 'sites-hero.mp4'));

/* ------------------------------------------------------------------
   Contactos
------------------------------------------------------------------- */
const briefingUrl = SITE.ctaSiteFormUrl;
// Se o número de WhatsApp ainda não estiver configurado em src/config.ts,
// os CTAs de WhatsApp caem no formulário, e nada quebra.
const whatsapp = whatsappUrl('Olá! Queria um diagnóstico rápido para o site do meu negócio.');
const diagnosticoUrl = whatsapp ?? briefingUrl;
const isExternal = (url: string) => url.startsWith('http');
const pacoteUrl = (slug: string) => `${briefingUrl}?pacote=${slug}`;
const diagAttrs: Record<string, string> = isExternal(diagnosticoUrl)
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
// Pílula de WhatsApp da hero: link real assim que houver número; até lá é só
// anotação do mockup e fica escondida da tecnologia de apoio.
const waAttrs: Record<string, string> = whatsapp
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : { 'aria-hidden': 'true' };

/* ------------------------------------------------------------------
   Conteúdo
------------------------------------------------------------------- */
const dores = [
  'O Instagram não transmite confiança suficiente.',
  'As mensagens chegam sem contexto.',
  'O cliente pergunta preço e desaparece.',
  'Anúncio sem landing desperdiça dinheiro.',
  'Site antigo não converte nem passa profissionalismo.',
];

const solucao = [
  { title: 'Oferta clara', desc: 'Organizamos o que vendes, para quem e por que motivo te devem escolher.' },
  { title: 'Design profissional', desc: 'Layout limpo, legível e coerente com a tua marca, em desktop e telemóvel.' },
  { title: 'Contacto por WhatsApp ou formulário', desc: 'A mensagem já chega com contexto: serviço, nome e o que a pessoa precisa.' },
  { title: 'SEO básico', desc: 'Títulos, descrições, estrutura e velocidade tratados desde o primeiro dia.' },
  { title: 'Tracking de leads e cliques', desc: 'Para saberes de onde vêm os pedidos, e não andares a adivinhar.' },
  { title: 'Publicação e manutenção', desc: 'Domínio, alojamento, SSL e o site a funcionar depois de publicado.' },
];

const pacotes = [
  {
    slug: 'presenca',
    nome: 'Presença',
    preco: '280€',
    precoNota: '+ IVA',
    antes: null as string | null,
    promo: null as string | null,
    desc: 'Para negócios que precisam sair do improviso e ter uma página profissional no ar.',
    inclui: [
      '1 landing page/site simples',
      'Até 5 blocos ou página única',
      'Copy básica baseada em template',
      'WhatsApp com mensagem organizada',
      'Formulário simples',
      'SEO básico',
      'Publicação',
      '1 revisão',
    ],
    cta: 'Começar com Presença',
    destaque: false,
    nota: null as string | null,
  },
  {
    slug: 'validacao-comercial',
    nome: 'Validação Comercial',
    preco: '490€',
    precoNota: '+ IVA',
    antes: '650€ + IVA',
    promo: 'Promoção',
    desc: 'Para negócios que querem site, captação e um teste comercial real com anúncios.',
    inclui: [
      'Tudo do Pacote Presença',
      'Site de 3 a 12 páginas',
      'Pronto em 14 dias',
      '14 dias de acompanhamento em Meta Ads',
      '100€ de investimento incluído para Meta Ads',
      '3 criativos de imagem',
      'Configuração de público',
      'SEO básico',
      'Tracking de leads e cliques',
      'Relatório detalhado',
      'Até 30.000 visualizações*',
      'Até 300 visitas no site',
    ],
    cta: 'Validar meu negócio',
    destaque: true,
    // Rodapé do próprio pacote: fica junto de "Até 30.000 visualizações*",
    // para o asterisco apontar para a nota certa.
    nota: '*Estimativa potencial baseada em campanha e distribuição. Resultados variam conforme nicho, verba, público, criativos e procura do mercado.',
  },
  {
    slug: 'loja-online',
    nome: 'Loja Online',
    preco: '1190€',
    precoNota: '+ IVA',
    antes: null as string | null,
    promo: null as string | null,
    desc: 'Para negócios que querem vender produtos online com uma loja profissional e pronta para gestão.',
    inclui: [
      'Loja online responsiva',
      'Design profissional personalizado',
      'Páginas de produto',
      'Carrinho e checkout',
      'Métodos de pagamento',
      'Configuração de envios',
      'SEO básico para produtos',
      'Formação para gestão da loja',
    ],
    cta: 'Criar loja online',
    destaque: false,
    nota: null as string | null,
  },
];

const momentos = [
  { n: '01', title: 'Criamos a presença', desc: 'Página, oferta, pontos de contacto e tracking prontos antes de gastar um euro em anúncios.' },
  { n: '02', title: 'Ativamos a campanha', desc: '3 criativos, público configurado e 100€ de investimento incluído a correr durante 14 dias.' },
  { n: '03', title: 'Medimos os pedidos', desc: 'No fim recebes o relatório com o que aconteceu e uma recomendação objetiva do próximo passo.' },
];

const relatorioCampos = [
  'Investimento total',
  'Alcance',
  'Impressões',
  'Cliques',
  'CTR',
  'Leads/contactos gerados',
  'Custo por lead/contacto',
  'Comparação dos 3 criativos',
  'Melhor criativo',
  'Público usado',
];

const processo = [
  { n: '1', label: 'Preenches o briefing' },
  { n: '2', label: 'Validamos o melhor caminho' },
  { n: '3', label: 'Pagas o sinal' },
  { n: '4', label: 'Criamos o site' },
  { n: '5', label: 'Revisas' },
  { n: '6', label: 'Publicamos' },
  { n: '7', label: 'Se for Validação, ativamos os anúncios', condicional: true },
];

const manutencao = [
  {
    nome: 'Manutenção Básica',
    mes: '29€/mês',
    ano: '290€/ano',
    para: 'Obrigatória em qualquer website.',
    itens: [
      'Alojamento',
      'SSL',
      'Backups',
      'Atualizações técnicas',
      'Monitorização básica',
      'Pequenas correções técnicas',
      'Site online e funcional',
    ],
  },
  {
    nome: 'Manutenção Pro',
    mes: '49€/mês',
    ano: '490€/ano',
    para: 'Para quem quer o site a mexer todos os meses.',
    itens: [
      'Tudo da Básica',
      'Até 1 alteração simples por mês',
      'Revisão mensal de formulário/links',
      'Relatório simples de visitas/leads',
      'Suporte prioritário',
    ],
  },
  {
    nome: 'Manutenção Loja Online',
    mes: '79€/mês',
    ano: '790€/ano',
    para: 'Obrigatória em lojas online.',
    itens: [
      'Alojamento',
      'SSL',
      'Backups',
      'Atualizações técnicas',
      'Segurança',
      'Verificação de checkout',
      'Suporte técnico',
      'Pequenas correções',
      'Monitorização de erros críticos',
    ],
  },
];

const faqs = [
  {
    q: 'O domínio está incluído?',
    a: 'Sim. Todos os pacotes incluem 1 ano de domínio gratuito como oferta especial, sujeito à disponibilidade do nome.',
  },
  {
    q: 'Tenho de pagar manutenção?',
    a: 'Sim. Websites exigem no mínimo Manutenção Básica para alojamento, segurança, backups e funcionamento técnico. Loja Online exige Manutenção Loja Online.',
  },
  {
    q: 'O investimento em anúncios está incluído?',
    a: 'No Pacote Validação Comercial, sim: estão incluídos 100€ de investimento para Meta Ads.',
  },
  {
    q: 'Em quanto tempo fica pronto?',
    a: 'O Pacote Validação Comercial fica pronto em até 14 dias, dependendo da entrega de materiais e validações.',
  },
  {
    q: 'O Pacote Presença também tem anúncios?',
    a: 'Não. O Pacote Presença é uma página/site simples de entrada. Para anúncios, tracking e relatório comercial, o pacote certo é o Validação Comercial.',
  },
  {
    q: 'Posso pedir alterações?',
    a: 'Sim. O Pacote Presença inclui 1 revisão. Alterações adicionais ou acompanhamento contínuo podem entrar na manutenção ou ser orçamentados à parte.',
  },
];

/* Classificação por estrutura, não por opinião: Website = tem páginas
   próprias no menu (/sobre, /contactos, ...); Landing page = tudo numa
   única página, com âncoras ou sem menu de navegação. */
const trabalhos = [
  {
    img: draCristinaSousa,
    nome: 'Dra. Cristina Sousa',
    tipo: 'Website',
    href: 'https://dracristinasousa.com/',
    url: 'dracristinasousa.com',
    alt: 'Website da Dra. Cristina Sousa, oftalmologista e cirurgiã oculoplástica: hero "Cirurgia Oculoplástica de Excelência" e menu com Procedimentos, Feedbacks, Antes e Depois e E-book.',
    detalhes: ['Menu com 6 secções', 'E-book de vendas', 'Antes/depois e feedbacks'],
  },
  {
    img: longevStudio,
    nome: 'Longev Studio',
    tipo: 'Website',
    href: 'https://longevstudio.com/',
    url: 'longevstudio.com',
    alt: 'Website institucional do Longev Studio: menu com Equipa, Serviços e Contactos, hero "Treino de Força e Longevidade" e botão de agendamento.',
    detalhes: ['Menu multi-página', 'Agendamento de avaliação', 'Versão PT/EN'],
  },
  {
    img: estudioTiagoPereira,
    nome: 'Estúdio Tiago Pereira',
    tipo: 'Website',
    href: 'https://estudiotiagopereira.pt/',
    url: 'estudiotiagopereira.pt',
    alt: 'Website do Estúdio Tiago Pereira, especialista em lipedema: hero com estatísticas "+100 mulheres acompanhadas" e botões Agendar Consulta e Ver Programas.',
    detalhes: ['Programas e e-books', 'Área de login', 'Prova social em números'],
  },
  {
    img: clinicaRenascer,
    nome: 'Clínica Renascer',
    tipo: 'Landing page',
    href: 'https://clinicarenascer.pt/',
    url: 'clinicarenascer.pt',
    alt: 'Landing page da Clínica Renascer, estética e bem-estar: hero com localização "Valença, Portugal" e botões Agendar Avaliação e Falar com a Equipa.',
    detalhes: ['Telefone direto no topo', 'Agendamento de avaliação', 'Botão de WhatsApp'],
  },
  {
    img: miraWay,
    nome: 'Mira Way',
    tipo: 'Landing page',
    href: 'https://miraway.senvia.pt/',
    url: 'miraway.senvia.pt',
    alt: 'Página de captação da Mira Way para uma sessão online gratuita, com lista de benefícios, botão de registo e WhatsApp flutuante.',
    detalhes: ['Registo em sessão', 'WhatsApp flutuante', 'Prova de escassez'],
  },
  {
    img: rdExcursoes,
    nome: 'RD Excursões',
    tipo: 'Landing page',
    href: 'https://rdexcursoes.senvia.pt/',
    url: 'rdexcursoes.senvia.pt',
    alt: 'Landing page da RD Excursões, agência de viagens: hero "Descubra Portugal com a RD Excursões", filtro de mês/programa e catálogo de próximas viagens.',
    detalhes: ['Filtro de viagens por mês', 'Catálogo de próximas excursões', 'CTAs de reserva'],
  },
  {
    img: deltaCapital,
    nome: 'Delta Capital',
    tipo: 'Landing page',
    href: 'https://deltacapital.pt/',
    url: 'deltacapital.pt',
    alt: 'Landing page da Delta Capital, intermediário de crédito: simulador de crédito habitação, botão "Falar connosco" por WhatsApp e selo do Banco de Portugal.',
    detalhes: ['Simulador de crédito', 'WhatsApp no topo', 'Selo Banco de Portugal'],
  },
];

/* ------------------------------------------------------------------
   SEO
------------------------------------------------------------------- */
const pageTitle = 'Criação de Sites Profissionais em Portugal';
const pageDescription =
  'Sites, landing pages e lojas online com preço fechado, captação por WhatsApp/formulário, SEO básico, tracking e manutenção. Pacotes desde 280€ + IVA.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Criação de sites, landing pages e lojas online',
    serviceType: 'Desenvolvimento de websites',
    provider: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Leiria', addressCountry: 'PT' },
    },
    areaServed: { '@type': 'Country', name: 'Portugal' },
    description: pageDescription,
    url: new URL('/sites', SITE.url).toString(),
    offers: pacotes.map((p) => ({
      '@type': 'Offer',
      name: `Pacote ${p.nome}`,
      description: p.desc,
      // Os preços da página são sem IVA, declarado explicitamente.
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: p.preco.replace('€', ''),
        priceCurrency: 'EUR',
        valueAddedTaxIncluded: false,
      },
      url: new URL('/sites#pacotes', SITE.url).toString(),
      availability: 'https://schema.org/InStock',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/sites"
  image="/images/og-sites.jpg"
  jsonLd={jsonLd}
>
  <!-- Marca o suporte a JS antes de o herói ser processado: sem isto o browser
       pinta o herói, o script chega ~30 kB depois e o herói pisca ao esconder-se.
       Aqui não há flash e o LCP não é adiado. -->
  <script is:inline>document.documentElement.classList.add('sv-js');</script>

  <div id="sv-page">
    <!-- ==========================================================
         1. HERO
    =========================================================== -->
    <CinematicHero
      pacotesHref="#pacotes"
      diagnosticoHref={diagnosticoUrl}
      diagnosticoAttrs={diagAttrs}
      whatsappHref={whatsapp}
      hasVideo={hasHeroVideo}
      videoSrc={HERO_VIDEO_SRC}
    >

    <!-- ==========================================================
         2. DOR
    =========================================================== -->
    <section class="sv-section sv-section--pain">
      <div class="sv-container sv-pain__inner">
        <div class="sv-pain__copy">
          <h2>
            O teu negócio não precisa de mais um site. Precisa de uma página que
            <em>explique, organize e gere contactos</em>.
          </h2>
          <p class="sv-lead">
            Um site bonito não chega. Se a pessoa entra, não entende a oferta e não sabe o que fazer
            a seguir, o site falhou.
          </p>

        </div>

        <div class="sv-pain__right">
          <ul class="sv-pain__list">
            {
              dores.map((d, i) => (
                <li data-reveal style={`--d:${i * 70}ms`}>
                  <span class="sv-pain__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="sv-pain__text">{d}</span>
                </li>
              ))
            }
          </ul>

          <figure class="sv-pain__figure">
            <BrowserFrame url="miraway.pt">
              <Image
                src={miraWay}
                alt="Página de captação da Mira Way com botão de registo e WhatsApp flutuante no canto inferior direito."
                widths={[520, 780]}
                sizes="(max-width: 900px) 88vw, 420px"
                loading="lazy"
                quality={68}
              />
            </BrowserFrame>
            <figcaption>
              O oposto disto: um caminho único. Entender a oferta, clicar e falar connosco pelo
              WhatsApp ou formulário.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         3. SOLUÇÃO
    =========================================================== -->
    <section class="sv-section sv-section--solution">
      <div class="sv-container sv-solution__inner">
        <div class="sv-solution__visual">
          <BrowserFrame url="deltacapital.pt">
            <Image
              src={deltaCapital}
              alt="Landing page da Delta Capital com simulador de crédito e botão de WhatsApp no menu."
              widths={[640, 960, 1280]}
              sizes="(max-width: 1023px) 92vw, 560px"
              loading="lazy"
              quality={70}
            />
          </BrowserFrame>

          <div class="sv-specimens" aria-hidden="true">
            <div class="sv-specimen">
              <p class="sv-specimen__label">Botão de WhatsApp</p>
              <span class="sv-specimen__wa">
                <svg viewBox="0 0 24 24" fill="currentColor"
                  ><path
                    d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.47 1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.5 9.5 0 0 1-4.83-1.32l-.35-.2-3.59.94.96-3.5-.23-.36a9.42 9.42 0 0 1-1.45-5.05c0-5.21 4.26-9.46 9.5-9.46 2.54 0 4.92.99 6.71 2.78a9.4 9.4 0 0 1 2.78 6.69c0 5.21-4.26 9.46-9.5 9.46m8.08-17.54A11.36 11.36 0 0 0 12.05 1C5.79 1 .7 6.07.7 12.3c0 1.99.52 3.93 1.51 5.64L.6 24l6.22-1.62a11.4 11.4 0 0 0 5.22 1.33h.01c6.26 0 11.35-5.07 11.35-11.3 0-3.02-1.18-5.86-3.32-8Z"
                  /></svg
                >
                Falar connosco
              </span>
            </div>

            <div class="sv-specimen">
              <p class="sv-specimen__label">Formulário</p>
              <span class="sv-field"></span>
              <span class="sv-field sv-field--short"></span>
            </div>

            <div class="sv-specimen">
              <p class="sv-specimen__label">Tracking</p>
              <span class="sv-specimen__row"><i></i> Cliques no WhatsApp</span>
              <span class="sv-specimen__row"><i></i> Formulários enviados</span>
            </div>
          </div>
        </div>

        <div class="sv-solution__copy">
          <h2>O que o teu site <em>precisa mesmo</em> de ter.</h2>
          <p class="sv-lead sv-solution__hint">
            <span>Desliza</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
          </p>

          <ul class="sv-solution__list">
            {
              solucao.map((s) => (
                <li>
                  <h3>{s.title}</h3>
                  <p>{s.desc}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         4. PROVA E TRABALHOS
    =========================================================== -->
    <section class="sv-section sv-section--work" id="trabalhos">
      <div class="sv-container">
        <div class="sv-head">
          <div>
            <p class="sv-eyebrow">Trabalhos</p>
            <h2>Trabalho real, não promessa abstrata.</h2>
          </div>
          <p class="sv-head__aside">
            Usamos estrutura, design e tracking para transformar a presença online numa ferramenta
            comercial.
          </p>
        </div>

        <div class="sv-work">
          {
            trabalhos.map((t, i) => (
              <figure class:list={['sv-work__item', i === 0 && 'sv-work__item--lead']} data-reveal>
                <a
                  href={t.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sv-work__link"
                  aria-label={`Abrir o site de ${t.nome} numa nova aba`}
                >
                  <BrowserFrame url={t.url}>
                    <Image
                      src={t.img}
                      alt={t.alt}
                      widths={i === 0 ? [800, 1200, 1600] : [560, 840, 1120]}
                      sizes={i === 0 ? '(max-width: 900px) 92vw, 1100px' : '(max-width: 900px) 92vw, 540px'}
                      loading="lazy"
                      quality={72}
                    />
                  </BrowserFrame>
                </a>
                <figcaption>
                  <a href={t.href} target="_blank" rel="noopener noreferrer" class="sv-work__name">
                    {t.nome}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                  </a>
                  <span class="sv-work__cat">{t.tipo}</span>
                  <span class="sv-work__details">{t.detalhes.join(' · ')}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <div class="sv-work__cta">
          <p>Queres uma página assim para o teu negócio?</p>
          <a href="#pacotes" class="sv-btn sv-btn--dark">
            Ver pacotes
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         5. VALIDAÇÃO COMERCIAL EM DESTAQUE
    =========================================================== -->
    <section class="sv-section sv-section--dark" id="validacao">
      <div class="sv-container sv-validation__inner">
        <div class="sv-validation__copy">
          <p class="sv-eyebrow sv-eyebrow--onDark">Pacote Validação Comercial</p>
          <h2>Mais do que um site: um <em>teste comercial com dados</em>.</h2>
          <p class="sv-lead sv-lead--onDark">
            O pacote Validação Comercial junta página, criativos, tráfego pago, tracking e relatório

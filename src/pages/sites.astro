    </section>
    </CinematicHero>
  </div>

  <script is:inline>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var targets = document.querySelectorAll('[data-reveal]');

      var revealAll = function () {
        for (var i = 0; i < targets.length; i++) targets[i].setAttribute('data-revealed', '');
      };

      /* --- Reveal discreto (só onde faz sentido) --- */
      try {
        if (reduced || !('IntersectionObserver' in window)) {
          revealAll();
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                  entries[i].target.setAttribute('data-revealed', '');
                  io.unobserve(entries[i].target);
                }
              }
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.12 }
          );
          for (var j = 0; j < targets.length; j++) io.observe(targets[j]);
        }
      } catch (err) {
        /* Nada pode ficar invisível por causa de um erro de script. */
        revealAll();
      }

      /* --- Selo de marca do CTA final ---
         4,7 MB: só se descarrega quando o selo entra no ecrã, e nunca com
         reduced-motion. Loop infinito precisa de mecanismo de pausa
         (WCAG 2.2.2, nível A). */
      var selo = document.querySelector('[data-sv-selo]');
      var logoV = document.getElementById('sv-logo-video');

      if (selo && logoV && !reduced) {
        /* A cena do CTA está sempre dentro do ecrã (posicionada absoluta),
           só com opacity 0 — um IntersectionObserver disparava logo ao abrir
           a página e descarregava os 4,7 MB a todos. O gatilho é a opacidade
           real da cena. */
        var cenaSelo = selo.closest('[data-cine-scenes] > *') || selo;
        var carregado = false;

        var talvezCarregar = function () {
          if (carregado) return;
          if (parseFloat(getComputedStyle(cenaSelo).opacity) < 0.5) return;
          carregado = true;
          window.removeEventListener('scroll', talvezCarregar);

          (function () {
            var src = document.createElement('source');
            src.src = logoV.getAttribute('data-src');
            src.type = 'video/mp4';
            logoV.appendChild(src);
            logoV.load();

            /* Toca uma vez até ao fim e fica parado no último fotograma.
               Sem loop, portanto não precisa de botão de pausa: o movimento
               termina sozinho e não se repete. */
            var pr = logoV.play();
            var ligar = function () {
              logoV.setAttribute('data-playing', '');
            };
            if (pr && pr.then) pr.then(ligar).catch(function () {});
            else ligar();
          })();
        };

        /* Sem chamada imediata: este script corre ANTES do módulo do
           componente, portanto as cenas ainda estão a opacity 1 e o vídeo
           era descarregado logo ao abrir a página. Só o scroll o dispara,
           e para chegar ao CTA é sempre preciso fazer scroll. */
        window.addEventListener('scroll', talvezCarregar, { passive: true });
      }

      /* --- Vídeo da hero: só carrega quando compensa ---
         O resto da hero (tilt, brilho, sequência de scroll, contador) vive
         agora no próprio componente CinematicHero.astro. Isto fica cá porque
         é o único ponto que carrega o vídeo em si — o componente só marca o
         <video> com data-src, não lhe injeta a fonte nem lhe chama .play(). */
      var video = document.getElementById('sv-hero-video');
      if (!video) return;

      var saveData = navigator.connection && navigator.connection.saveData === true;
      var wideEnough = window.innerWidth >= 768;

      if (reduced || saveData || !wideEnough) return; // fica o poster estático

      var start = function () {
        var source = document.createElement('source');
        source.src = video.getAttribute('data-src');
        source.type = 'video/mp4';
        video.appendChild(source);
        video.load();

        var toggle = document.getElementById('sv-hero-video-toggle');
        var p = video.play();

        var enableToggle = function () {
          video.setAttribute('data-playing', '');
          if (!toggle) return;
          toggle.hidden = false;
          var pauseIcon = toggle.querySelector('.sv-hero__vtoggle-pause');
          var playIcon = toggle.querySelector('.sv-hero__vtoggle-play');
          var label = toggle.querySelector('.sv-hero__vtoggle-text');

          var sync = function () {
            var paused = video.paused;
            toggle.setAttribute('aria-pressed', String(paused));
            pauseIcon.style.display = paused ? 'none' : '';
            playIcon.style.display = paused ? '' : 'none';
            label.textContent = paused ? 'Retomar animação' : 'Parar animação';
          };

          toggle.addEventListener('click', function () {
            if (video.paused) video.play();
            else video.pause();
          });
          video.addEventListener('play', sync);
          video.addEventListener('pause', sync);
          sync();
        };

        if (p && p.then) p.then(enableToggle).catch(function () {});
        else enableToggle();
      };

      if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 2000 });
      else window.setTimeout(start, 600);
    })();
  </script>
</Base>

<style is:global>
  /* =========================================================
     SENVIA, página /sites
     Direção: editorial claro, carvão + verde. Sem dark/ciano global.
     Todos os seletores usam o prefixo .sv- ou estão presos a #sv-page,
     por isso este ficheiro não afeta nenhuma outra página.
     ========================================================= */

  #sv-page {
    /* --- Paleta SENVIA --- */
    --sv-cyan: #00c3ff; /* Primary SENVIA Cyan */
    --sv-cyan-hover: #33ffe3; /* Hover Cyan */
    --sv-cyan-mid: #009ccc; /* Mid Cyan Blue */
    --sv-petrol: #007599; /* Petrol Blue */
    --sv-petrol-dark: #004e66; /* Dark Petrol */
    --sv-ink: #0b1f2a; /* Deep Navy, para blocos escuros e títulos */
    --sv-ink-soft: #0f2937; /* Secondary Navy */

    /* Texto sobre superfície escura (paleta SENVIA) */
    --sv-on-dark: #f1f5f9; /* Text Light */
    --sv-on-dark-soft: #cbd6de; /* Text Soft */
    --sv-on-dark-muted: #8a98a6; /* Text Muted */
    --sv-border-dark: rgba(148, 163, 184, 0.15);

    /* Papéis:
       o ciano #00c3ff só tem 2.05:1 em fundo claro, por isso nunca é texto
       aqui. É fundo de botão (8.1:1 com navy por cima) e acento em escuro.
       Para texto/links em claro usa-se o Petrol Blue. */
    --sv-accent: var(--sv-cyan); /* superfícies e acentos */
    --sv-accent-hover: var(--sv-cyan-hover);
    --sv-accent-ink: var(--sv-petrol); /* texto de acento em claro, 4.9:1 */
    --sv-accent-strong: var(--sv-petrol-dark); /* texto de acento forte, 8.6:1 */
    --sv-accent-soft: #e4f4fc;
    --sv-on-accent: #04212c; /* texto por cima do ciano */

    /* Verde: só semântico (WhatsApp). Nunca como identidade da página. */
    --sv-whatsapp: #25d366;

    /* Neutros frios, derivados do navy para não destoarem do sistema */
    --sv-paper: #f4f7f9;
    --sv-paper-2: #e9eff3;
    --sv-white: #ffffff;
    --sv-text: #2c3f4b;
    --sv-muted: #4f6a78;
    --sv-line: #d3dde4;
    --sv-line-soft: #e4ebf0;
    --sv-line-ui: #788d9a; /* contorno de componentes, 3.2:1 no fundo claro */

    --sv-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;

    background: var(--sv-paper);
    color: var(--sv-text);
  }

  /* Fundo da página (evita carvão em overscroll) */
  body:has(#sv-page) {
    background: #f4f7f9;
  }

  /* O header e o rodapé partilhados já são navy + ciano, ou seja, já são a
     identidade SENVIA. Nesta rota não se recolorem, só se retira o brilho
     do botão para acompanhar o registo mais sóbrio da página. */
  body:has(#sv-page) .site-header--scrolled {
    box-shadow: none;
  }
  body:has(#sv-page) .nav .btn--primary:hover {
    box-shadow: none;
    transform: none;
  }

  /* O rodapé global é rgba(15,41,55,0.2): 20% de navy. Nas outras páginas
     assenta sobre fundo escuro e lê-se navy; aqui o fundo é claro e dava
     cinzento. Passa a navy opaco, a seguir ao CTA final que já é navy. */
  body:has(#sv-page) .site-footer {
    background: #0b1f2a;
    border-top-color: rgba(148, 163, 184, 0.16);
  }
  /* Entre o burger (≤768px) e o desktop folgado (≥900px) o menu partilhado
     não tem espaço: a marca e o botão partem-se em duas linhas. Aperta-se
     aqui, só nesta rota, e o comportamento das outras páginas fica intacto. */
  @media (min-width: 769px) and (max-width: 899px) {
    body:has(#sv-page) .nav {
      gap: 0.85rem;
    }
    body:has(#sv-page) .nav__link {
      font-size: 0.8rem;
      white-space: nowrap;
    }
    body:has(#sv-page) .nav .btn--primary {
      padding: 0.7rem 1rem;
      font-size: 0.82rem;
      white-space: nowrap;
    }
    body:has(#sv-page) .brand__text {
      white-space: nowrap;
    }
    body:has(#sv-page) .brand__logo {
      width: 2rem;
      height: 2rem;
    }
  }

  /* O foco global é ciano (#00c3ff): 9.2:1 em navy, mas só 1.9:1 em fundo
     claro. Nas secções claras passa a Petrol Blue; nas escuras fica ciano.
     Sem depender de :has(), para não cair em browsers sem suporte. */
  #sv-page :focus-visible {
    outline-color: var(--sv-petrol);
  }
  #sv-page .sv-section--dark :focus-visible,
  #sv-page .sv-final :focus-visible {
    outline-color: var(--sv-cyan);
  }

  /* ---------- Base ---------- */
  #sv-page .sv-container {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    /* O tablet deixa de levar a mesma goteira de 20px de um telemóvel */
    padding-inline: clamp(1.25rem, 3.6vw, 2.5rem);
  }

  #sv-page .sv-section {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  #sv-page h1,
  #sv-page h2,
  #sv-page h3 {
    color: var(--sv-ink);
    letter-spacing: -0.032em;
    font-weight: 700;
  }

  #sv-page h2 {
    font-size: clamp(1.6rem, 2.4vw + 0.8rem, 2.4rem);
    line-height: 1.12;
    max-width: 20ch;
  }

  #sv-page h2 em,
  #sv-page h1 em {
    font-style: normal;
    color: var(--sv-accent-ink);
  }

  #sv-page p {
    margin: 0;
  }

  #sv-page .sv-lead {
    font-size: clamp(1.02rem, 0.35vw + 0.95rem, 1.15rem);
    line-height: 1.6;
    color: var(--sv-muted);
    max-width: 46ch;
  }

  #sv-page .sv-lead--onDark {
    color: #cbd6de;
  }

  #sv-page .sv-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--sv-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sv-muted);
    margin-bottom: 1rem;
  }

  #sv-page .sv-eyebrow::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    background: var(--sv-accent-ink);
    flex: none;
  }

  #sv-page .sv-eyebrow--onDark {
    color: #8a98a6;
  }

  #sv-page .sv-eyebrow--onDark::before {
    background: var(--sv-cyan);
  }

  #sv-page .sv-fine {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--sv-muted);
  }

  /* ---------- Cabeçalho de secção ---------- */
  #sv-page .sv-head {
    display: grid;
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sv-line);
  }

  #sv-page .sv-head__aside {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--sv-muted);
    max-width: 44ch;
  }

  @media (min-width: 900px) {
    #sv-page .sv-head {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  /* ---------- Botões ---------- */
  #sv-page .sv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.8rem 1.4rem;
    border-radius: 8px;
    border: 1px solid transparent;
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-align: center;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  #sv-page .sv-btn svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #sv-page .sv-btn--primary {
    background: var(--sv-accent);
    color: #04212c;
  }
  #sv-page .sv-btn--primary:hover {
    background: #33ffe3;
  }

  #sv-page .sv-btn--dark {
    background: var(--sv-ink);
    color: #fff;
  }
  #sv-page .sv-btn--dark:hover {
    background: #16323f;
  }

  /* --sv-line (#d3dde4) é para réguas decorativas: 1.28:1 no fundo claro.
     Contornos de componentes precisam de 3:1 (WCAG 1.4.11) → --sv-line-ui. */
  #sv-page .sv-btn--ghost {
    background: transparent;
    border-color: var(--sv-line-ui);
    color: var(--sv-ink);
  }
  #sv-page .sv-btn--ghost:hover {
    border-color: var(--sv-ink);
    background: rgba(11, 31, 42, 0.04);
  }

  #sv-page .sv-btn--outline {
    background: transparent;
    border-color: rgba(148, 163, 184, 0.28);
    color: #fff;
  }
  #sv-page .sv-btn--outline:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  #sv-page .sv-btn--block {
    width: 100%;
  }

  #sv-page .sv-btn--lg {
    min-height: 54px;
    padding: 1rem 1.75rem;
    font-size: 1.02rem;
  }

  #sv-page .sv-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--sv-accent-ink);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    min-height: 44px;
  }
  #sv-page .sv-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }
  #sv-page .sv-link:hover svg {
    transform: translateX(3px);
  }


  /* =========================================================
     2. DOR
     ========================================================= */
  #sv-page .sv-section--pain {
    background: var(--sv-paper);
  }

  #sv-page .sv-pain__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 940px) {
    #sv-page .sv-pain__inner {
      grid-template-columns: 1fr 1fr;
    }
    #sv-page .sv-pain__copy {
      position: sticky;
      top: 7.5rem;
    }
  }

  #sv-page .sv-pain__copy h2 {
    max-width: 17ch;
    margin-bottom: 1.25rem;
  }

  #sv-page .sv-pain__figure {
    margin: 2.75rem 0 0;
  }

  #sv-page .sv-pain__figure figcaption {
    margin-top: 0.85rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--sv-muted);
    padding-left: 0.85rem;
    border-left: 2px solid var(--sv-accent-ink);
  }

  #sv-page .sv-pain__list {
    border-top: 1px solid var(--sv-line);
  }

  #sv-page .sv-pain__list li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--sv-line);
  }

  #sv-page .sv-pain__num {
    font-family: var(--sv-mono);
    font-size: 0.78rem;
    color: var(--sv-accent-ink);
    flex: none;
    padding-top: 0.15rem;
  }

  #sv-page .sv-pain__text {
    font-size: clamp(1.05rem, 0.6vw + 0.95rem, 1.3rem);
    line-height: 1.4;
    letter-spacing: -0.018em;
    color: var(--sv-ink);
    font-weight: 500;
  }

  /* =========================================================
     3. SOLUÇÃO
     ========================================================= */
  #sv-page .sv-section--solution {
    background: var(--sv-white);
    border-block: 1px solid var(--sv-line-soft);
  }

  #sv-page .sv-solution__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    #sv-page .sv-solution__inner {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  #sv-page .sv-solution__copy h2 {
    margin-bottom: 1.1rem;
  }

  #sv-page .sv-solution__list {
    display: grid;
    gap: 0;
    margin-top: 2rem;
    border-top: 1px solid var(--sv-line);
  }

  @media (min-width: 620px) {
    #sv-page .sv-solution__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
  }

  #sv-page .sv-solution__list li {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--sv-line-soft);
  }

  #sv-page .sv-solution__list h3 {
    font-size: 1rem;
    line-height: 1.3;
    margin-bottom: 0.3rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  #sv-page .sv-solution__list h3::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    background: var(--sv-accent-ink);
    flex: none;
    transform: translateY(-0.15rem);
  }

  #sv-page .sv-solution__list p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--sv-muted);
    padding-left: 0.9rem;
  }

  /* Recortes de UI */
  #sv-page .sv-specimens {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
  }

  #sv-page .sv-specimen {
    padding: 0.8rem;
    border: 1px solid var(--sv-line);
    border-radius: 10px;
    background: var(--sv-paper);
  }

  #sv-page .sv-specimen__label {
    font-family: var(--sv-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sv-muted);
    margin-bottom: 0.55rem !important;
  }

  #sv-page .sv-specimen__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--sv-line);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--sv-ink);
    white-space: nowrap;
  }

  #sv-page .sv-specimen__wa svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--sv-whatsapp);
    flex: none;
  }

  #sv-page .sv-specimen__row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    color: var(--sv-muted);
    margin-bottom: 0.3rem;
  }

  #sv-page .sv-specimen__row i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--sv-accent-ink);
    flex: none;
  }

  @media (max-width: 520px) {
    #sv-page .sv-specimens {
      grid-template-columns: 1fr;
    }
  }

  /* =========================================================
     6. PACOTES
     ========================================================= */
  #sv-page .sv-section--plans {
    background: var(--sv-paper);
  }

  #sv-page .sv-plans {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 960px) {
    #sv-page .sv-plans {
      grid-template-columns: 1fr 1.14fr 1fr;
      gap: 0;
      align-items: stretch;
    }
  }

  #sv-page .sv-plan {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--sv-line);
    border-radius: 14px;
    background: var(--sv-white);
  }

  /* Empilhado (tablet/telemóvel) não deve esticar até aos 800px de largura */
  @media (max-width: 959px) {
    #sv-page .sv-plan {
      width: 100%;
      max-width: 34rem;
      margin-inline: auto;
    }
  }

  @media (min-width: 960px) {
    #sv-page .sv-plan {
      border: 0;
      border-radius: 0;
      background: transparent;
      padding: 0.5rem 2rem 0;
    }
    /* As colunas das pontas alinham com a margem da secção */
    #sv-page .sv-plan:first-child {
      padding-left: 0;
    }
    #sv-page .sv-plan:last-child {
      padding-right: 0;
    }
    #sv-page .sv-plan + .sv-plan {
      border-left: 1px solid var(--sv-line);
    }
    #sv-page .sv-plan--feature,
    #sv-page .sv-plan--feature + .sv-plan {
      border-left: 0;
    }
  }

  #sv-page .sv-plan--feature {
    background: var(--sv-ink);
    border-color: var(--sv-ink);
    color: #cbd6de;
  }

  @media (min-width: 960px) {
    #sv-page .sv-plan--feature {
      position: relative;
      background: var(--sv-ink);
      border-radius: 16px;
      padding: 2.25rem 2rem;
      margin-top: -1.75rem;
      box-shadow: 0 30px 60px -40px rgba(11, 31, 42, 0.8);
    }
    /* As colunas sem etiqueta reservam exatamente a mesma altura que ela ocupa,
       para os 3 preços ficarem na mesma linha de base e a escada
       280 → 490 → 1190 ler-se de uma só vez, em qualquer largura. */
    #sv-page .sv-plan:not(.sv-plan--feature) .sv-plan__top {
      padding-top: calc(1.35rem + 0.85rem);
    }
  }

  #sv-page .sv-plan--feature h3,
  #sv-page .sv-plan--feature .sv-plan__amount {
    color: #fff;
  }

  #sv-page .sv-plan__tag {
    display: block;
    width: fit-content;
    height: 1.35rem;
    line-height: 1.35rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    background: var(--sv-accent);
    color: #04212c;
    font-family: var(--sv-mono);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  #sv-page .sv-plan__name {
    font-size: 1.18rem;
    margin-bottom: 0.6rem;
  }

  #sv-page .sv-plan__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.35rem;
  }

  #sv-page .sv-plan__amount {
    font-size: clamp(2.1rem, 1.6vw + 1.6rem, 2.7rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--sv-ink);
    font-variant-numeric: tabular-nums;
  }

  #sv-page .sv-plan__vat {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sv-muted);
  }

  #sv-page .sv-plan--feature .sv-plan__vat {
    color: #8a98a6;
  }

  #sv-page .sv-plan__was {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--sv-muted);
    text-decoration-thickness: 1px;
  }

  #sv-page .sv-plan--feature .sv-plan__was {
    color: #8a98a6;
  }

  #sv-page .sv-plan__promo {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--sv-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sv-accent);
    border: 1px solid rgba(0, 195, 255, 0.45);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    margin-bottom: 0.9rem;
  }

  #sv-page .sv-plan__desc {
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--sv-muted);
    margin-bottom: 1.35rem;
    min-height: 0;
  }

  #sv-page .sv-plan--feature .sv-plan__desc {
    color: #cbd6de;
  }

  @media (min-width: 960px) {
    #sv-page .sv-plan__desc {
      min-height: 4.5rem;
    }
  }

  #sv-page .sv-plan__body {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sv-line);
  }

  #sv-page .sv-plan--feature .sv-plan__body {
    border-top-color: rgba(148, 163, 184, 0.16);
  }

  #sv-page .sv-plan__incl {
    font-family: var(--sv-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sv-muted);
    margin-bottom: 0.9rem !important;
  }

  #sv-page .sv-plan--feature .sv-plan__incl {
    color: #8a98a6;
  }

  #sv-page .sv-plan__list li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.94rem;
    line-height: 1.45;
    color: var(--sv-text);
    padding: 0.42rem 0;
  }

  #sv-page .sv-plan--feature .sv-plan__list li {
    color: #f1f5f9;
  }

  #sv-page .sv-plan__list svg,
  #sv-page .sv-care__item svg,
  #sv-page .sv-plans__gift svg {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    margin-top: 0.22rem;
    fill: none;
    stroke: var(--sv-accent-ink);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #sv-page .sv-plan--feature .sv-plan__list svg {
    stroke: var(--sv-accent);
  }

  #sv-page .sv-plans__note {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--sv-line);
    display: grid;
    gap: 0.5rem;
  }

  #sv-page .sv-plans__gift {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sv-ink);
    margin-bottom: 0.35rem;
  }

  #sv-page .sv-plans__gift strong {
    font-weight: 700;
  }

  #sv-page .sv-plans__reassure {
    color: var(--sv-ink);
  }

  /* Aviso explícito de manutenção, ao lado do preço, não em letra pequena.
     A manutenção é obrigatória, por isso aparece antes de escolherem. */
  #sv-page .sv-plans__care {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--sv-white);
    border: 1px solid var(--sv-line);
    border-left: 3px solid var(--sv-accent-ink);
    border-radius: 0 10px 10px 0;
  }

  #sv-page .sv-plans__care p {
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--sv-text);
    max-width: 62ch;
  }

  #sv-page .sv-plans__care strong {
    color: var(--sv-ink);
    font-weight: 700;
  }

  #sv-page .sv-plans__care .sv-link {
    flex: none;
  }

  #sv-page .sv-plan__note {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(148, 163, 184, 0.22);
    font-size: 0.78rem;
    line-height: 1.5;
    color: #8a98a6;
  }

  #sv-page .sv-work__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--sv-line);
  }

  #sv-page .sv-work__cta p {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sv-ink);
  }

  /* =========================================================
     5. VALIDAÇÃO COMERCIAL
     ========================================================= */
  #sv-page .sv-section--dark {
    background: var(--sv-ink);
    color: #cbd6de;
  }

  #sv-page .sv-section--dark h2,
  #sv-page .sv-section--dark h3 {
    color: #fff;
  }

  #sv-page .sv-section--dark h2 em {
    color: var(--sv-accent);
  }

  #sv-page .sv-validation__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 980px) {
    #sv-page .sv-validation__inner {
      grid-template-columns: 1fr 0.92fr;
      gap: 4.5rem;
    }
  }

  #sv-page .sv-validation__copy h2 {
    margin-bottom: 1.1rem;
  }

  #sv-page .sv-moments {
    margin: 2.25rem 0;
    border-top: 1px solid rgba(148, 163, 184, 0.22);
  }

  #sv-page .sv-moments li {
    display: flex;
    gap: 1.1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.22);
  }

  #sv-page .sv-moments__n {
    font-family: var(--sv-mono);
    font-size: 0.78rem;
    color: var(--sv-accent);
    flex: none;
    padding-top: 0.2rem;
  }

  #sv-page .sv-moments h3 {
    font-size: 1.02rem;
    margin-bottom: 0.25rem;
    letter-spacing: -0.02em;
  }

  #sv-page .sv-moments p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #cbd6de;
  }

  /* Documento de relatório */
  #sv-page .sv-report {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.9);
  }

  #sv-page .sv-report__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.35rem;
    border-bottom: 1px solid var(--sv-line);
    background: var(--sv-paper);
  }

  #sv-page .sv-report__kicker {
    font-family: var(--sv-mono);
    font-size: 0.63rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sv-muted);
    margin-bottom: 0.2rem !important;
  }

  #sv-page .sv-report__title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--sv-ink);
    letter-spacing: -0.02em;
  }

  #sv-page .sv-report__seal {
    font-family: var(--sv-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--sv-muted);
    border: 1px solid var(--sv-line);
    border-radius: 4px;
    padding: 0.3rem 0.5rem;
    flex: none;
  }

  #sv-page .sv-report__fields {
    padding: 0.5rem 1.35rem;
  }

  #sv-page .sv-report__fields li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.62rem 0;
    border-bottom: 1px dashed var(--sv-line-soft);
    font-size: 0.9rem;
    color: var(--sv-text);
  }

  #sv-page .sv-report__fields li:last-child {
    border-bottom: 0;
  }

  #sv-page .sv-report__fields i {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--sv-line) 0 6px, transparent 6px 12px);
    min-width: 2.5rem;
  }

  #sv-page .sv-report__foot {
    padding: 1.15rem 1.35rem 1.35rem;
    border-top: 1px solid var(--sv-line);
    background: var(--sv-paper);
  }

  #sv-page .sv-report__concl {
    font-size: 0.86rem;
    color: var(--sv-muted);
    margin-bottom: 0.7rem !important;
  }

  #sv-page .sv-report__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  #sv-page .sv-report__pills span {
    padding: 0.32rem 0.75rem;
    border: 1px solid var(--sv-line);
    border-radius: 999px;
    background: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sv-ink);
  }

  #sv-page .sv-report__caption {
    margin-top: 1rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: #8a98a6;
    max-width: 42ch;
  }

  /* =========================================================
     7. PROCESSO
     ========================================================= */
  #sv-page .sv-section--process {
    background: var(--sv-paper);
  }

  #sv-page .sv-steps {
    display: grid;
    gap: 0;
  }

  #sv-page .sv-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 0 1.05rem 0;
    border-bottom: 1px solid var(--sv-line);
  }

  #sv-page .sv-step:last-child {
    border-bottom: 0;
  }

  #sv-page .sv-step__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--sv-line);
    background: var(--sv-white);
    font-family: var(--sv-mono);
    font-size: 0.82rem;
    color: var(--sv-ink);
  }

  #sv-page .sv-step__label {
    font-size: 1rem;
    line-height: 1.4;
    color: var(--sv-ink);
    font-weight: 500;
  }

  #sv-page .sv-step--cond .sv-step__n {
    border-style: dashed;
    border-color: var(--sv-accent-ink);
    color: var(--sv-accent-ink);
  }

  #sv-page .sv-step--cond .sv-step__label {
    color: var(--sv-accent-ink);
  }

  @media (min-width: 900px) {
    #sv-page .sv-steps {
      grid-template-columns: repeat(7, 1fr);
    }
    #sv-page .sv-step {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 0 1.1rem 0 0;

---
import Base from '../layouts/Base.astro';
import SitesNav from '../components/sites/SitesNav.astro';
import { SITE } from '../config';
import '../styles/sobre-nos-v2.css';

/* ------------------------------------------------------------------
   Sobre nós: a mesa de trabalho da SENVIA, vista de cima, em 3D.
   Uma secção alta com um quadro sticky; o scroll leva a câmara de objeto em objeto
   (polaroid, portátil, caderno, post-its, telemóvel, cartão) e as notas de papel
   entram e saem com o scroll. O 3D vive em src/scripts/sobre-nos-v2.js;
   os estilos em src/styles/sobre-nos-v2.css (tudo dentro de .sv2).
------------------------------------------------------------------- */

const demo = SITE.ctaFormUrl;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<Base
  title="Sobre nós: a software house de Leiria"
  description="A SENVIA é uma software house em Leiria, desde 2025. Sistemas à medida sem licenças por pessoa, sites que trazem pedidos e o nosso CRM, o Senvia OS."
  canonicalPath="/sobre-nos"
>
  <SitesNav slot="header" cta="Pedir diagnóstico" ctaHref={demo} />
  <!-- Marca o suporte a JS antes de pintar: as notas ficam escondidas até o scroll as mostrar -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="preload" href="/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/general-sans-500.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Inter e Caveat: as letras desenhadas nos objetos da mesa -->
  <!-- não bloqueia a primeira pintura: as fontes entram por troca (display=swap) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&family=Caveat:wght@500;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&family=Caveat:wght@500;700&display=swap" /></noscript>

  <div class="sv2" id="sv2">
    <canvas id="world" aria-hidden="true"></canvas>
    <div class="vignette" aria-hidden="true"></div>
    <div class="tip" id="tip" aria-hidden="true"></div>

    <div class="desk-page">
    <!-- A mesa de trabalho da SENVIA: o scroll leva a câmara de objeto em objeto e o objeto levanta-se; cada nota de papel conta uma parte -->
      <section class="track" id="inicio" style="--stops:7">
        <div class="frame">
          <article class="note left vis full on" data-stop="0" style="--rot:-1.2deg;--v:1">
            <p class="hand">Olá!</p>
            <h1>Puxa uma cadeira. <em>Vamos falar do teu negócio</em>.</h1>
            <p class="lede">Somos a SENVIA, uma software house em Leiria, desde 2025. Daqui saem sistemas à medida, sites e o nosso CRM, o Senvia OS.</p>
            <div class="actions">
              <a class="sbtn" href={demo} {...ext}>Pedir diagnóstico</a>
              <a class="sbtn sbtn-ghost" href="#mesa" data-go="1">Ver a mesa</a>
            </div>
          </article>
    
          <article class="note right" data-stop="1" style="--rot:1.1deg">
            <p class="hand">A polaroid</p>
            <h2>Quem está <em>por trás</em>.</h2>
            <blockquote class="quote">
              <p class="q1">“Durante anos vi empresas presas a folhas de Excel e a pagar licenças de programas que não faziam o que precisavam.</p>
              <p>Criei a SENVIA para fazer o contrário: sistemas desenhados à medida de cada empresa, que ficam delas, e sites que trazem pedidos a sério.”</p>
            </blockquote>
            <div class="who"><b>Thiago Sousa</b><span>Fundador da SENVIA</span></div>
          </article>
    
          <article class="note left" data-stop="2" style="--rot:-0.9deg">
            <p class="hand">No portátil</p>
            <h2>O que sai <em>desta mesa</em>.</h2>
            <!-- cada cartão muda o ecrã do portátil 3D; o link por baixo leva à página do que está no ecrã -->
            <div class="doors" role="group" aria-label="Mostrar no ecrã do portátil">
              <button type="button" class="door" data-scene="0" aria-pressed="true"><b>Sistemas à medida</b><span>Feitos para a tua empresa, sem licenças por pessoa.</span></button>
              <button type="button" class="door" data-scene="2" aria-pressed="false"><b>Sites e lojas online</b><span>Pensados para o telemóvel, para trazer pedidos.</span></button>
              <button type="button" class="door" data-scene="1" aria-pressed="false"><b>Senvia OS</b><span>O nosso CRM, pronto a usar.</span></button>
            </div>
            <a class="link" id="door-link" href="/softwares" {...ext}>Ver sistemas à medida</a>
          </article>
    
          <article class="note right" data-stop="3" style="--rot:1.3deg">
            <p class="hand">No caderno</p>
            <h2>Primeiro <em>desenhamos contigo</em>.</h2>
            <p class="lede">Antes de escrever uma linha de código, vemos como trabalhas e desenhamos cada ecrã contigo. Sabes o preço antes de começarmos.</p>
          </article>
    
          <article class="note left" data-stop="4" style="--rot:-1.4deg">
            <p class="hand">Nos post-its</p>
            <h2>Três regras <em>que não mudam</em>.</h2>
            <ul class="rules">
              <li><b>À medida.</b> Nada de pacotes tamanho único.</li>
              <li><b>Preço fechado.</b> Sem licenças por pessoa.</li>
              <li><b>Falas com quem faz.</b> Quem constrói é quem te atende.</li>
            </ul>
          </article>
    
          <article class="note right" data-stop="5" style="--rot:0.9deg">
            <p class="hand">No telemóvel</p>
            <h2>5,0 no Google. <em>Em todas as avaliações</em>.</h2>
            <figure class="mini-review"><blockquote>“Recomendo vivamente! Super profissional, disponível e honesto. Preço/qualidade fantástico.”</blockquote><figcaption>Tiago Pereira · Google</figcaption></figure>
            <a class="link" href="https://www.google.com/search?q=Senvia+Agency+Leiria" {...ext}>Ver as avaliações no Google</a>
          </article>
    
          <article class="note left" data-stop="6" style="--rot:-0.8deg">
            <p class="hand">O cartão</p>
            <h2>Estamos <em>em Leiria</em>.</h2>
            <p class="addr">R. de Atenas 149<br>2415-585 Leiria</p>
            <div class="actions">
              <a class="sbtn" href={demo} {...ext}>Pedir diagnóstico</a>
              <a class="sbtn sbtn-ghost" href="https://www.google.com/maps/search/?api=1&amp;query=R.+de+Atenas+149+2415-585+Leiria" {...ext}>Abrir no mapa</a>
            </div>
          </article>
    
          <nav class="stops" id="stops" aria-label="Objetos da mesa"></nav>
          <p class="hint" id="hint" aria-hidden="true"><span class="h-d">Faz scroll ou clica nos objetos</span><span class="h-m">Desliza ou toca nos objetos</span></p>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  // o texto pinta primeiro; o 3D (three.js, ~530 KB) só carrega depois da primeira pintura
  requestAnimationFrame(() => setTimeout(() => import('../scripts/sobre-nos-v2.js'), 0));
</script>

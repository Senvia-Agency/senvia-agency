---
import Base from '../layouts/Base.astro';
import SitesNav from '../components/sites/SitesNav.astro';
import { SITE } from '../config';
import '../styles/softwares-v2.css';

/* ------------------------------------------------------------------
   Sistemas à medida: uma planta que vira o sistema (exemplos, sistemas já feitos, preço).
   Cada capítulo é uma secção alta com um quadro sticky de 100vh; as camadas
   de texto entram conforme o progresso do scroll (data-in / data-out).
   O 3D vive em src/scripts/softwares-v2.js; os estilos em src/styles/softwares-v2.css (tudo dentro de .sv2).
------------------------------------------------------------------- */

const demo = SITE.ctaFormUrl;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<Base
  title="Sistemas à medida para a tua empresa"
  description="Clientes, agenda, faturas, stock e equipa num sistema só teu, desde 1.500€ + IVA e manutenção desde 69€ por mês. Sem licenças por pessoa. Pronto em 4 a 8 semanas."
  canonicalPath="/softwares"
>
  <SitesNav slot="header" cta="Pedir diagnóstico" ctaHref={demo} />
  <!-- Marca o suporte a JS antes de pintar: as camadas de texto ficam escondidas até o scroll as mostrar -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="preload" href="/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/general-sans-500.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Inter: a letra dos ecrãs desenhados no 3D -->
  <!-- não bloqueia a primeira pintura: as fontes entram por troca (display=swap) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" /></noscript>

  <div class="sv2" id="sv2">
    <canvas id="world" aria-hidden="true"></canvas>
    <canvas id="fg" aria-hidden="true"></canvas>

    <nav class="hud" aria-label="Capítulos da página">
      <b id="hud-n" aria-hidden="true">01</b><span id="hud-name" aria-hidden="true">Início</span><span class="track" aria-hidden="true"><i id="hud-bar"></i></span><span class="dots" id="hud-dots"></span>
    </nav>

    <div class="chapters">
    <!-- 00 início: a planta desenha-se e vira o sistema -->
      <section class="chapter" id="inicio" data-name="Início" data-beats="2" style="--beats:2">
        <div class="frame">
          <div class="layer pos-left m-low is-in" data-in="0" data-out="0.5">
            <div class="copy">
              <p class="eyebrow">Sistemas à medida · Portugal</p>
              <h1 class="split">O sistema da tua empresa, <em>desenhado à medida</em>.</h1>
              <p class="lede fade" style="--d:1">Clientes, agenda, faturas, stock e equipa num sistema só teu. Sem licenças por pessoa: pagas a construção e uma manutenção mensal.</p>
              <div class="actions fade" style="--d:2">
                <a class="sbtn" href={demo} {...ext}>Pedir diagnóstico</a>
                <a class="sbtn sbtn-ghost" href="#exemplos" data-go="1">Ver exemplos</a>
              </div>
              <p class="fine fade" style="--d:3">Desde 1.500€ + IVA. Manutenção desde 69€ por mês.</p>
            </div>
          </div>
          <div class="layer pos-right m-high" data-in="0.5" data-out="1">
            <div class="copy">
              <p class="eyebrow">O que fica teu</p>
              <h2 class="split">Um sistema próprio. <em>Sem licenças</em>.</h2>
              <ul class="facts">
                <li class="fade" style="--d:1"><b data-count="1500" data-suffix="€">1.500€</b><span>desde, a construção + IVA</span></li>
                <li class="fade" style="--d:2"><b data-count="69" data-suffix="€">69€</b><span>desde, por mês de manutenção</span></li>
                <li class="fade" style="--d:3"><b data-count="0" data-suffix="€">0€</b><span>em licenças: utilizadores ilimitados</span></li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 01 exemplos: stand, oficina e restauração, cada um da planta ao sistema -->
      <section class="chapter" id="exemplos" data-name="Exemplos" data-beats="3" style="--beats:3">
        <div class="frame">
          <div class="layer pos-right m-low" data-in="0" data-out="0.3333">
            <div class="copy">
              <p class="eyebrow">Exemplos <span class="n">1 de 3</span></p>
              <span class="kind fade" style="--d:0">Stand automóvel</span>
              <h2 class="split">Três stands, <em>um só stock</em>.</h2>
              <p class="lede fade" style="--d:1">Cada viatura com fotos, preço e localização. Pedes uma transferência entre stands e todos veem onde está o carro.</p>
              <ul class="tags"><li class="fade" style="--d:2">Stock de viaturas</li><li class="fade" style="--d:3">Transferências</li><li class="fade" style="--d:4">Vendas por stand</li></ul>
            </div>
          </div>
          <div class="layer pos-left m-high" data-in="0.3333" data-out="0.6667">
            <div class="copy">
              <p class="eyebrow">Exemplos <span class="n">2 de 3</span></p>
              <span class="kind fade" style="--d:0">Oficina</span>
              <h2 class="split">A oficina <em>sem papéis no balcão</em>.</h2>
              <p class="lede fade" style="--d:1">Cada viatura passa do diagnóstico à reparação até ficar pronta. O orçamento vai para aprovação e o cliente recebe o aviso no WhatsApp.</p>
              <ul class="tags"><li class="fade" style="--d:2">Viaturas</li><li class="fade" style="--d:3">Orçamentos</li><li class="fade" style="--d:4">Avisos por WhatsApp</li></ul>
            </div>
          </div>
          <div class="layer pos-right m-low" data-in="0.6667" data-out="1">
            <div class="copy">
              <p class="eyebrow">Exemplos <span class="n">3 de 3</span></p>
              <span class="kind fade" style="--d:0">Restauração</span>
              <h2 class="split">Mesas, cozinha e stock <em>a falar entre si</em>.</h2>
              <p class="lede fade" style="--d:1">Os pedidos chegam à cozinha, o stock desconta sozinho e o sistema avisa quando um produto está a acabar.</p>
              <ul class="tags"><li class="fade" style="--d:2">Mesas e pedidos</li><li class="fade" style="--d:3">Stock</li><li class="fade" style="--d:4">Turnos da equipa</li></ul>
              <p class="fine fade" style="--d:5">Exemplos ilustrativos. Cada sistema é desenhado para a empresa.</p>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 02 incluído em todos -->
      <section class="chapter" id="incluido" data-name="Incluído" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer pos-left m-high" data-in="0" data-out="1">
            <div class="copy">
              <p class="eyebrow">Incluído em todos</p>
              <h2 class="split">O que todos os sistemas <em>já trazem</em>.</h2>
              <div class="pairs six">
                <div class="pair fade" style="--d:1"><h3>Utilizadores ilimitados</h3><p>Sem custo por pessoa, nem hoje nem quando a equipa crescer.</p></div>
                <div class="pair fade" style="--d:2"><h3>Automações</h3><p>Lembretes, avisos e tarefas repetidas, sem depender de alguém.</p></div>
                <div class="pair fade" style="--d:3"><h3>WhatsApp</h3><p>As mensagens aos clientes dentro do sistema.</p></div>
                <div class="pair fade" style="--d:4"><h3>Email</h3><p>Um cliente de email ligado às fichas dos clientes.</p></div>
                <div class="pair fade" style="--d:5"><h3>Mensagens internas</h3><p>A equipa fala no sistema, não em grupos pessoais.</p></div>
                <div class="pair fade" style="--d:6"><h3>Os teus dados</h3><p>Importamos o Excel que já tens.</p></div>
              </div>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 03 como funciona (noite): medir, desenhar, construir, entrar no ar -->
      <section class="chapter" id="processo" data-name="Como funciona" data-beats="4" data-night="true" style="--beats:4">
        <div class="frame">
          <div class="layer pos-left m-high" data-in="0" data-out="0.25">
            <div class="copy">
              <p class="eyebrow">Como funciona <span class="n">01 Diagnóstico</span></p>
              <h2 class="split">Primeiro, <em>medimos</em>.</h2>
              <p class="lede fade" style="--d:1">Vemos como trabalhas hoje: o Excel, os papéis e as apps soltas. Sais com um plano e um preço fechado.</p>
            </div>
          </div>
          <div class="layer pos-right m-high" data-in="0.25" data-out="0.5">
            <div class="copy">
              <p class="eyebrow">Como funciona <span class="n">02 Desenho</span></p>
              <h2 class="split">Desenhamos <em>contigo</em>.</h2>
              <p class="lede fade" style="--d:1">Cada ecrã é desenhado e aprovado por ti antes de começarmos a construir.</p>
            </div>
          </div>
          <div class="layer pos-left m-high" data-in="0.5" data-out="0.75">
            <div class="copy">
              <p class="eyebrow">Como funciona <span class="n">03 Construção</span></p>
              <h2 class="split">Construímos <em>em 4 a 8 semanas</em>.</h2>
              <p class="lede fade" style="--d:1">Vais vendo o sistema crescer e validas cada parte, sem surpresas no fim.</p>
            </div>
          </div>
          <div class="layer pos-right m-high" data-in="0.75" data-out="1">
            <div class="copy">
              <p class="eyebrow">Como funciona <span class="n">04 No ar</span></p>
              <h2 class="split">Entra no ar <em>com os teus dados</em>.</h2>
              <p class="lede fade" style="--d:1">Importamos o que já tens e a equipa começa a usar. Depois, a manutenção mantém tudo seguro e atualizado.</p>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 04 já fizemos: sistemas reais (ecrãs com dados fictícios) -->
      <section class="chapter" id="feitos" data-name="Já fizemos" data-beats="2" style="--beats:2">
        <div class="frame">
          <div class="layer pos-right m-low" data-in="0" data-out="0.5">
            <div class="copy">
              <p class="eyebrow">Já fizemos <span class="n">1 de 2</span></p>
              <span class="kind fade" style="--d:0">Restauração · Orbis</span>
              <h2 class="split">Orbis: o restaurante <em>todo no mesmo ritmo</em>.</h2>
              <p class="lede fade" style="--d:1">Da mesa à cozinha, das compras à gestão, em cada unidade. Gestão, ecrã da cozinha e menu digital para o cliente.</p>
              <ul class="tags"><li class="fade" style="--d:2">Várias unidades</li><li class="fade" style="--d:3">Cozinha</li><li class="fade" style="--d:4">Menu digital</li><li class="fade" style="--d:5">Stock e compras</li></ul>
              <a class="link fade" style="--d:6" href="https://orbisgroup.pt/" {...ext}>Ver orbisgroup.pt</a>
            </div>
          </div>
          <div class="layer pos-left m-high" data-in="0.5" data-out="1">
            <div class="copy">
              <p class="eyebrow">Já fizemos <span class="n">2 de 2</span></p>
              <span class="kind fade" style="--d:0">Energia e serviços · Perfect2Gether</span>
              <h2 class="split">Perfect2Gether: propostas, comissões <em>e equipa</em>.</h2>
              <p class="lede fade" style="--d:1">Um sistema comercial para energia e serviços: leads, propostas com comissões, vendas, financeiro e recursos humanos, com ponto e ausências.</p>
              <ul class="tags"><li class="fade" style="--d:2">Propostas</li><li class="fade" style="--d:3">Comissões</li><li class="fade" style="--d:4">Recursos humanos</li><li class="fade" style="--d:5">Mensagens internas</li></ul>
              <p class="fine fade" style="--d:6">Ecrãs ilustrativos, com dados fictícios.</p>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 05 preço -->
      <section class="chapter" id="preco" data-name="Preço" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer layer-plans pos-center" data-in="0" data-out="1">
            <div class="copy wide">
              <p class="eyebrow">Preço</p>
              <h2 class="split">O que pagas, <em>sem surpresas</em>.</h2>
              <div class="plans">
                <article class="plan fade" style="--d:1">
                  <span class="pn">Construção</span>
                  <span class="pp"><small class="from">desde</small><span data-count="1500" data-suffix="€">1.500€</span><small>+ IVA</small></span>
                  <ul><li>Desenhado para a tua empresa</li><li>Utilizadores e licenças ilimitados</li><li>Automações, WhatsApp e email</li><li>Importação dos teus dados</li></ul>
                  <a class="sbtn sbtn-ghost sbtn-sm" href={demo} {...ext}>Pedir diagnóstico</a>
                </article>
                <article class="plan rec fade" style="--d:2">
                  <div class="sbadges"><span class="sbadge">Único custo fixo</span></div>
                  <span class="pn">Servidor e manutenção</span>
                  <span class="pp"><small class="from">desde</small><span data-count="69" data-suffix="€">69€</span><small>/mês</small></span>
                  <ul><li>Servidor e alojamento</li><li>Backups e segurança</li><li>Atualizações técnicas</li><li>Sem custo por utilizador</li></ul>
                  <a class="sbtn sbtn-sm" href={demo} {...ext}>Quero o meu sistema</a>
                </article>
                <article class="plan fade" style="--d:3">
                  <span class="pn">Evoluções</span>
                  <span class="pp" style="font-size:clamp(1.6rem,2.4vw,2.2rem)">Só se quiseres</span>
                  <ul><li>Novas funcionalidades</li><li>Ligações a outros programas</li><li>Orçamentadas à parte</li><li>Sem obrigação de pedir</li></ul>
                  <a class="sbtn sbtn-ghost sbtn-sm" href={demo} {...ext}>Falar connosco</a>
                </article>
              </div>
              <div class="plan-dots" aria-hidden="true"><i></i><i class="on"></i><i></i></div>
              <p class="fine fade" style="--d:4">Prazo habitual: 4 a 8 semanas, conforme o sistema. Valores sem IVA.</p>
            </div>
          </div>
        </div>
      </section>
    
      <!-- 06 começar -->
      <section class="chapter" id="comecar" data-name="Começar" data-beats="1" style="--beats:1">
        <div class="frame">
          <div class="layer pos-bottom m-low" data-in="0" data-out="1">
            <div class="copy">
              <p class="eyebrow">Próximo passo</p>
              <h2 class="split">Mostra-nos como trabalhas. <em>Desenhamos o teu sistema</em>.</h2>
              <p class="lede fade" style="--d:1">Numa conversa curta vemos os teus processos e sais com um plano concreto, com ou sem a SENVIA.</p>
              <div class="actions fade" style="--d:2">
                <a class="sbtn" href={demo} {...ext}>Pedir diagnóstico</a>
                <a class="sbtn sbtn-ghost" href="/senvia-os">Preferes algo pronto? Senvia OS</a>
              </div>
            </div>
          </div>
          <div class="wordmark" aria-hidden="true">SENVIA</div>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  // o texto pinta primeiro; o 3D (three.js, ~530 KB) só carrega depois da primeira pintura
  requestAnimationFrame(() => setTimeout(() => import('../scripts/softwares-v2.js'), 0));
</script>

{
  "rewrites": [
    { "source": "/reports/(.*)", "destination": "/reports/$1" },
    { "source": "/((?!reports).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
